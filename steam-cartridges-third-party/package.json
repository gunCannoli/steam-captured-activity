{
  "name": "steam-cartridges-third-party",
  "version": "0.1.0",
  "private": true,
  "description": "Discovers installed games from Epic Games and Xbox / Microsoft Store, syncs store achievements, and handles launcher overlays.",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "millennium-ttc --build prod",
    "build:dev": "millennium-ttc --build dev",
    "dev": "powershell -ExecutionPolicy Bypass -File dev.ps1",
    "test": "lua tests/test_store.lua && lua tests/test_store_launch.lua"
  },
  "dependencies": {
    "@steambrew/client": "^5.8.5"
  },
  "devDependencies": {
    "@steambrew/ttc": "^2.8.7",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "typescript": "^5.9.3"
  }
}
