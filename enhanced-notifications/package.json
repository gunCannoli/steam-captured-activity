{
  "name": "enhanced-notifications",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Restyles every Steam notification (colours, borders, fonts, sounds, display time) from shareable JSON themes, keeping Steam's own icons and content.",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "millennium-ttc --build prod",
    "build:dev": "millennium-ttc --build dev",
    "dev": "powershell -ExecutionPolicy Bypass -File dev.ps1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "verify": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@steambrew/client": "^5.8.5",
    "steambrew-utils": "0.0.0-beta-20260816131110"
  },
  "devDependencies": {
    "@steambrew/ttc": "^2.8.7",
    "@types/node": "^24.0.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
