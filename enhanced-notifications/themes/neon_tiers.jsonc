// Neon Tiers: dark cards at the top left, and achievement banners whose border and glow show the rarity at a glance
// (white, blue, purple, gold), with the SteamStation trophies and chimes. Every option is explained in
// theme_example.jsonc.
{
    "settings": {
        "position": "top_left",
        "animation": "slide",
        "display_time_ms": 4500,
        "text_align": "left",
    },
    "popup": {
        "background": ["#0d0d12", "#16161f"],
        "gradient_angle": 90,
        "border": [1, "#ffffff22", 6],
        "watermark": false,
        "margin": 12,
        "padding": 10,
        "gap": [10, 2],
    },
    "text": {
        "title": ["#ffffff", 110, "bold"],
        "body": ["#d0d0e0", 100, "regular"],
        "subtext": ["#9a9ab0", 95, "regular"],
    },
    "popup_icon": [true, 100, 6],
    "achievements": {
        "normal": {
            "border": [1, "#ffffffaa", 6],
            "icons": { "rarity": ["SteamStation/assets/trophy_bronze.svg", 90, 0] },
            "sound": ["SteamStation/assets/chime_bronze.wav", 70],
        },
        "magic": {
            "threshold": 25,
            "border": [2, "#3da9ff", 6],
            "glow": ["#3da9ff", 50, 1600],
            "icons": { "rarity": ["SteamStation/assets/trophy_silver.svg", 90, 0] },
            "sound": ["SteamStation/assets/chime_silver.wav", 75],
        },
        "rare": {
            "threshold": 10,
            "border": [2, "#b45cff", 6],
            "glow": ["#b45cff", 70, 1200],
            "icons": { "rarity": ["SteamStation/assets/trophy_gold.svg", 100, 0] },
            "sound": ["SteamStation/assets/chime_gold.wav", 80],
        },
        "exceptional": {
            "border": [3, "#ffc83d", 8],
            "glow": ["#ffc83d", 90, 800],
            "icons": { "rarity": ["SteamStation/assets/trophy_platinum.svg", 110, 0] },
            "sound": ["SteamStation/assets/chime_platinum.wav", 90],
        },
    },
}
