// PS5-style: every notification a dark card in the top-right corner that slides in
// from the edge, and achievements as PS5 trophies: the achievement art on the left,
// a trophy before the title, and Steam's logo pulsing on the right. Bronze /
// silver / gold by rarity, platinum for 100%. Every option is explained in theme.jsonc.
{
    // Every notification, achievements included.
    "settings": {
        "position": "top_right",
        "display_time_ms": 4000,
        "animation": "ps5", // slide + fade in from the anchored edge (right here), and back out the same way
        "text_align": "left",
    },

    // The card of every notification; the achievement banner starts from it too.
    "popup": {
        "background": ["#1F1F1F", "#0F0F0F"],
        "gradient_angle": 90,
        "border": [0, "#8a2be2", 8], // no stroke, rounded 8 px corners
        "watermark": false,
        "margin": 10, // 10 px in from the top and right edges
        "padding": 10,
        "gap": [10, 2], // 10 px between the icon and the text, 2 px between text rows (a 3-row toast fills Steam's 70 px card)
    },
    // Achievements use title for their name and body for their description.
    "text": {
        "title": ["#ffffff", 120, "regular"],
        "body": ["#ffffff", 100, "regular"],
        "subtext": ["#c7c7c7", 100, "regular"],
    },
    "game_icon": [true, 8], // shown, 8 px rounded corners

    // Achievements: the PS5 trophy banner. Any popup key set here or in a tier overrides the popup above.
    "achievements": {
        "layout": {
            "achievement": "left",
            "system": "right",
            "rarity": "title_left", // trophy inline, before the title
        },
        "padding": [10, 15, 10, 10], // [top, right, bottom, left]

        // Bronze: every unlock not rare enough for silver or gold.
        "normal": {
            "icons": {
                "achievement": [true, 100, 0], // the achievement's own art
                "system": [true, 120, 2000], // Steam logo at 120%, ripple every 2 s
                "rarity": ["PlayStation/bronze.png", 100, 0],
            },
            "sound": ["PlayStation/trophy_ps5.mp3", 80],
        },

        // Silver: 25% of players or fewer.
        "magic": {
            "threshold": 25.0,
            "icons": { "rarity": ["PlayStation/silver.png", 150, 0] },
            "sound": ["PlayStation/trophy_ps4.mp3", 90],
        },

        // Gold: 10% of players or fewer.
        "rare": {
            "threshold": 10.0,
            "icons": { "rarity": ["PlayStation/gold.png", 150, 0] },
            "sound": ["PlayStation/trophy_ps4.mp3", 90],
        },

        // Platinum: the "100% complete" toast after the game's last achievement.
        "exceptional": {
            "icons": {
                "rarity": ["PlayStation/steam_badge.png", 100, 0],
                "achievement": ["PlayStation/platinum_steam.png", 100, 0],
            },
            "sound": ["PlayStation/platinum_trophy_ps5.mp3", 90],
            "text": {
                "title": "100% Complete",
                "desc": "You've unlocked all achievements!",
            },
        },
    },
}
