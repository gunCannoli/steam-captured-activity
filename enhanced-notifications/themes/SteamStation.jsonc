// SteamStation: every notification a dark card in the top-right corner that slides in from the edge, and achievements
// as trophies: the achievement art on the left, a trophy before the title, Steam's logo pulsing on the right, and a
// bell chime that grows with the rarity (bronze / silver / gold, platinum for 100 %).
// Its art and sounds are the plugin's own, in SteamStation/assets/ (made by tools/theme_assets.py).
// Every option is explained in theme_example.jsonc.
{
    // Every notification, achievements included.
    "settings": {
        "position": "top_right",
        "display_time_ms": 4000,
        "animation": "ps5", // slide + fade in from the anchored edge, and back out the same way
        "text_align": "left",
    },

    // The card of every notification; the achievement banner starts from it too.
    "popup": {
        "background": ["#1F1F1F", "#0F0F0F"],
        "gradient_angle": 90,
        "border": [0, "#000000", 10],
        "watermark": false,
        "margin": 10,
        "padding": 10,
        "gap": [10, 2],
    },
    "text": {
        "title": ["#ffffff", 120, "regular"],
        "body": ["#ffffff", 100, "regular"],
        "subtext": ["#c7c7c7", 100, "regular"],
    },
    "popup_icon": [true, 100, 8], // the toast's icon: shown, Steam's size, 8 px rounded corners

    // Achievements: the trophy banner. Any popup key set here or in a tier overrides the popup above.
    "achievements": {
        "layout": {
            "achievement": "left",
            "system": "right",
            "text": "achievement_right",
            "rarity": "title_left",
        },
        "padding": [10, 15, 10, 10],
        "normal": {
            "glow": ["#363636", 0, 0],
            "icons": {
                "achievement": [true, 100, 0],
                "system": [true, 120, 2000], // Steam's logo, pulsing every 2 s
                "rarity": ["SteamStation/assets/trophy_bronze.svg", 100, 0],
            },
            "sound": ["SteamStation/assets/chime_bronze.wav", 80],
        },
        "magic": {
            "threshold": 25, // unlocked by 25 % of players or fewer
            "glow": ["#9aa4ae", 60, 1500],
            "icons": { "rarity": ["SteamStation/assets/trophy_silver.svg", 100, 0] },
            "sound": ["SteamStation/assets/chime_silver.wav", 85],
        },
        "rare": {
            "threshold": 10,
            "glow": ["#e5a93c", 80, 1200],
            "icons": { "rarity": ["SteamStation/assets/trophy_gold.svg", 110, 0] },
            "sound": ["SteamStation/assets/chime_gold.wav", 90],
        },
        "exceptional": {
            // the game's last achievement: 100 %
            "glow": ["#40c4ff", 90, 800],
            "text": {
                "title": "100% Complete",
                "desc": "You've unlocked all achievements!",
            },
            "icons": {
                "achievement": ["SteamStation/assets/complete.svg", 100, 0],
                "rarity": ["SteamStation/assets/trophy_platinum.svg", 110, 0],
            },
            "sound": ["SteamStation/assets/chime_platinum.wav", 100],
        },
    },
}
