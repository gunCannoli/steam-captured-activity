{
  "name": "steam-cartridges-local",
  "version": "0.1.0",
  "private": true,
  "description": "Reads and manages local achievements from .ini/text files used by Steam emulator-style setups (CODEX, RUNE, GSE, Goldberg, SOVEREIGN).",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "millennium-ttc --build prod",
    "build:dev": "millennium-ttc --build dev",
    "dev": "powershell -ExecutionPolicy Bypass -File dev.ps1",
    "test": "lua tests/test_ini_parser.lua && lua tests/test_file_search.lua"
  },
  "dependencies": {
    "@steambrew/client": "^5.8.5"
  },
  "devDependencies": {
    "@steambrew/ttc": "^2.8.7",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "typescript": "^5.9.3"
  }
}
