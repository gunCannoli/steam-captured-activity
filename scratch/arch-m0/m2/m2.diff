+++ b/steam-cartridges/frontend/sensors/lifecycle/index.ts
@@ -0,0 +1,19 @@
+// Lifecycle sensor (migration plan M2, ADR-0039): the only code that detects a shortcut
+// starting and quitting. Emits shortcut.launched / shortcut.quit on the bus.
+import { onAppLaunch } from "steambrew-utils/watchers";
+import { toShortcutId } from "../../kernel/appid";
+import type { EventBus } from "../../kernel/events";
+
+let installed = false;
+
+export function installLifecycleSensor(bus: EventBus): void {
+    if (installed) return;
+    installed = true;
+
+    onAppLaunch((app, { onQuit }) => {
+        const appid = toShortcutId(app.appid);
+        if (appid === undefined) return;
+        bus.emit("shortcut.launched", { appid, name: String(app.display_name ?? appid) });
+        onQuit(() => bus.emit("shortcut.quit", { appid }));
+    });
+}
diff --git a/steam-cartridges/frontend/sensors/view/core.ts b/steam-cartridges/frontend/sensors/view/core.ts
new file mode 100644
index 0000000..6c9252f
--- /dev/null
+++ b/steam-cartridges/frontend/sensors/view/core.ts
@@ -0,0 +1,69 @@
+// View sensor, pure part (migration plan M2, ADR-0039). Turns raw Steam signals into
+// shortcut.viewed / shortcut.left, one per real navigation. Only `import type` here, so
+// tests/sensors.test.ts can load it with node.
+import type { ShortcutId } from "../../kernel/appid";
+
+export type ViewMode = "desktop" | "gamepad";
+export interface ViewPayload {
+    appid: ShortcutId;
+    mode: ViewMode;
+}
+
+/**
+ * Big Picture has no "left the page" signal (steam/gamepad-appid.ts): it re-renders the
+ * app-details element many times while a page is open. The same appid seen again after
+ * this much silence counts as a new view (the page was opened again).
+ */
+export const GAMEPAD_QUIET_MS = 2000;
+
+export interface ViewTrackerOptions {
+    /** kernel/appid toShortcutId: undefined for native apps and junk. */
+    toShortcutId: (raw: unknown) => ShortcutId | undefined;
+    viewed: (p: ViewPayload) => void;
+    left: (p: ViewPayload) => void;
+    now: () => number;
+    quietMs?: number;
+}
+
+export interface ViewTracker {
+    /** Desktop: the main window's route now shows this appid (undefined: not an app page). */
+    route(raw: number | undefined): void;
+    /** Big Picture: the app-details element rendered with this appid. */
+    sighting(raw: number): void;
+    /** The window of this mode closed: leave whatever it showed. */
+    close(mode: ViewMode): void;
+    current(mode: ViewMode): ShortcutId | undefined;
+}
+
+export function createViewTracker(opts: ViewTrackerOptions): ViewTracker {
+    const quietMs = opts.quietMs ?? GAMEPAD_QUIET_MS;
+    const current: Record<ViewMode, ShortcutId | undefined> = { desktop: undefined, gamepad: undefined };
+    let lastSighting = -Infinity;
+
+    /** Move `mode` to `next`; emits left for the old shortcut and viewed for the new one. */
+    const move = (mode: ViewMode, next: ShortcutId | undefined): void => {
+        const prev = current[mode];
+        if (prev === next) return;
+        current[mode] = next;
+        if (prev !== undefined) opts.left({ appid: prev, mode });
+        if (next !== undefined) opts.viewed({ appid: next, mode });
+    };
+
+    return {
+        route(raw) {
+            move("desktop", raw === undefined ? undefined : opts.toShortcutId(raw));
+        },
+        sighting(raw) {
+            const now = opts.now();
+            const id = opts.toShortcutId(raw);
+            const reopened = id !== undefined && id === current.gamepad && now - lastSighting >= quietMs;
+            lastSighting = now;
+            if (reopened) opts.viewed({ appid: id, mode: "gamepad" });
+            else move("gamepad", id);
+        },
+        close(mode) {
+            move(mode, undefined);
+        },
+        current: (mode) => current[mode],
+    };
+}
diff --git a/steam-cartridges/frontend/sensors/view/index.ts b/steam-cartridges/frontend/sensors/view/index.ts
new file mode 100644
index 0000000..6237f0a
--- /dev/null
+++ b/steam-cartridges/frontend/sensors/view/index.ts
@@ -0,0 +1,67 @@
+// View sensor (migration plan M2, ADR-0039): the only code that detects which shortcut
+// page the user is looking at. Desktop: the main window's route. Big Picture: the
+// app-details element seen through the shared jsx runtime (ADR-0027), counted only while
+// a Big Picture window is open. Emits shortcut.viewed / shortcut.left on the bus.
+import { Steam } from "steambrew-utils";
+import { onLocationChange, onPopupCreate, PopupType } from "steambrew-utils/watchers";
+import { logger } from "../../logger";
+import { toShortcutId } from "../../kernel/appid";
+import type { EventBus } from "../../kernel/events";
+import { watchGamepadAppid } from "../../steam/gamepad-appid";
+import { appIdFromPath } from "../../steam/route";
+import { createViewTracker } from "./core";
+
+let installed = false;
+
+/**
+ * Install once, after every subscriber is registered: onPopupCreate replays the windows
+ * already open and onLocationChange reports the current route immediately.
+ */
+export function installViewSensor(bus: EventBus): void {
+    if (installed) return;
+    installed = true;
+
+    // Emit on a timer, never synchronously: a Big Picture sighting arrives from inside a jsx
+    // call, i.e. inside Steam's render, and handlers write Steam stores (guardrail 17).
+    // Timers keep the order of the signals.
+    const tracker = createViewTracker({
+        toShortcutId,
+        now: () => Date.now(),
+        viewed: (p) =>
+            setTimeout(() => {
+                logger.info(`Viewed shortcut ${p.appid} (${p.mode}).`);
+                bus.emit("shortcut.viewed", p);
+            }, 0),
+        left: (p) =>
+            setTimeout(() => {
+                logger.info(`Left shortcut ${p.appid} (${p.mode}).`);
+                bus.emit("shortcut.left", p);
+            }, 0),
+    });
+
+    let gamepadWindows = 0;
+    watchGamepadAppid((appid) => {
+        if (gamepadWindows > 0) tracker.sighting(appid);
+    });
+
+    onPopupCreate((_popup, type) => {
+        if (type === PopupType.Desktop) {
+            const stop = onLocationChange(
+                () => Steam.MainWindowBrowserManager?.m_lastLocation,
+                ({ pathname }) => tracker.route(appIdFromPath(pathname)),
+            );
+            return () => {
+                stop();
+                tracker.close("desktop");
+            };
+        }
+        if (type === PopupType.Gamepad) {
+            gamepadWindows++;
+            return () => {
+                gamepadWindows--;
+                if (gamepadWindows === 0) tracker.close("gamepad");
+            };
+        }
+        return undefined;
+    });
+}
