# Normalise to LF in the repo; check out native on Windows.
* text=auto

# Lua and web sources stay LF everywhere - Millennium's build and the Lua
# interpreter are both fine with LF, and mixed endings make diffs noisy.
*.lua   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
# Plan patches are applied with `git apply`: they must keep LF on Windows checkouts.
*.patch text eol=lf

# PowerShell prefers CRLF on Windows.
*.ps1   text eol=crlf

# Binary
*.png   binary
*.jpg   binary
*.ico   binary
