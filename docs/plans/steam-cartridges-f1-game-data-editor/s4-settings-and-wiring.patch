@@ -0,0 +1,72 @@
+// Game Data editor: one input per editable field, then the player badges (features plan F1).
+import { DialogButton } from "@steambrew/client";
+import { EDITABLE_FIELDS, PLAYER_FLAGS, type MetadataDraft } from "../../domain/metadata-edit";
+import { BLOCK_STYLE, INPUT_STYLE, LABEL_STYLE, NOTE_STYLE } from "./styles";
+
+export function MetadataForm({
+    draft,
+    onChange,
+    errors,
+    dirty,
+    custom,
+    hasMetadata,
+    busy,
+    onSave,
+    onRevert,
+}: {
+    draft: MetadataDraft;
+    onChange: (next: MetadataDraft) => void;
+    errors: string[];
+    dirty: boolean;
+    custom: boolean;
+    hasMetadata: boolean;
+    busy: boolean;
+    onSave: () => void;
+    onRevert: () => void;
+}) {
+    return (
+        <div style={BLOCK_STYLE}>
+            {!hasMetadata && <span style={NOTE_STYLE}>No data yet for this game. Open its page once to fetch some, or fill it in by hand.</span>}
+            {EDITABLE_FIELDS.map((f) => (
+                <label key={f.key} style={{ display: "flex", flexDirection: "column", gap: "3px" }}>
+                    <span style={LABEL_STYLE}>
+                        {f.label}
+                        {f.kind === "list" ? " (separate with ;)" : f.kind === "date" ? " (YYYY-MM-DD, empty = unknown)" : ""}
+                    </span>
+                    {f.kind === "textarea" ? (
+                        <textarea rows={5} value={draft[f.key]} onChange={(e) => onChange({ ...draft, [f.key]: e.target.value })} style={{ ...INPUT_STYLE, resize: "vertical" }} />
+                    ) : (
+                        <input type="text" value={draft[f.key]} onChange={(e) => onChange({ ...draft, [f.key]: e.target.value })} style={INPUT_STYLE} />
+                    )}
+                </label>
+            ))}
+            <div style={{ display: "flex", flexWrap: "wrap", gap: "12px" }}>
+                {PLAYER_FLAGS.map((p) => (
+                    <label key={p.flag} style={{ display: "flex", alignItems: "center", gap: "5px", fontSize: "12px" }}>
+                        <input
+                            type="checkbox"
+                            checked={draft.players[p.flag]}
+                            onChange={(e) => onChange({ ...draft, players: { ...draft.players, [p.flag]: e.target.checked } })}
+                        />
+                        {p.label}
+                    </label>
+                ))}
+            </div>
+            <span style={NOTE_STYLE}>Controller support follows Settings → Metadata and the Library Audit, not this form.</span>
+            {errors.map((e) => (
+                <span key={e} style={{ fontSize: "12px", color: "#e57373" }}>
+                    {e}
+                </span>
+            ))}
+            <div style={{ display: "flex", gap: "8px" }}>
+                <DialogButton onClick={onSave} disabled={busy || !dirty || errors.length > 0} style={{ padding: "0 14px", minWidth: 0, width: "auto" }}>
+                    Save
+                </DialogButton>
+                <DialogButton onClick={onRevert} disabled={busy || !custom} style={{ padding: "0 14px", minWidth: 0, width: "auto" }}>
+                    Revert to fetched data
+                </DialogButton>
+            </div>
+            {custom && <span style={NOTE_STYLE}>This game has a manual edit: refreshes never overwrite it.</span>}
+        </div>
+    );
+}
diff --git a/steam-cartridges/frontend/settings/game-editor/modal.tsx b/steam-cartridges/frontend/settings/game-editor/modal.tsx
new file mode 100644
index 0000000..9ba7ecc
--- /dev/null
+++ b/steam-cartridges/frontend/settings/game-editor/modal.tsx
@@ -0,0 +1,77 @@
+// Game Data editor popup (features plan F1): pick a shortcut, edit its metadata, manage its Steam link.
+// Reads the app only through usePanelContext().editor; nothing here writes to Steam.
+import { useRef, useState } from "react";
+import { SettingsModal } from "../components";
+import { usePanelContext, type EditorSnapshot } from "../context";
+import { diff, draftOf, validate, type MetadataDraft } from "../../domain/metadata-edit";
+import { GamePicker } from "./game-picker";
+import { MetadataForm } from "./metadata-form";
+import { SteamLink } from "./steam-link";
+
+export function GameDataEditor({ isOpen, onClose }: { isOpen: boolean; onClose: () => void }) {
+    const editor = usePanelContext().editor;
+    const [filter, setFilter] = useState("");
+    const [appid, setAppid] = useState<number | undefined>();
+    const [snapshot, setSnapshot] = useState<EditorSnapshot | undefined>();
+    const [draft, setDraft] = useState<MetadataDraft | undefined>();
+    const [busy, setBusy] = useState(false);
+    const [message, setMessage] = useState<{ text: string; error: boolean } | undefined>();
+    const loadId = useRef(0);
+
+    async function load(id: number) {
+        const mine = ++loadId.current;
+        const snap = await editor.load(id);
+        if (mine !== loadId.current) return; // the user picked another game meanwhile
+        setSnapshot(snap);
+        setDraft(draftOf(snap.metadata));
+    }
+
+    function pick(id: number) {
+        setAppid(id);
+        setSnapshot(undefined);
+        setDraft(undefined);
+        setMessage(undefined);
+        void load(id).catch((e) => setMessage({ text: String(e?.message ?? e), error: true }));
+    }
+
+    /** Runs one editor action, then reloads the game so the form shows what was stored. */
+    function run(work: () => Promise<{ error?: string } | void>, done: string) {
+        if (appid === undefined) return;
+        setBusy(true);
+        setMessage(undefined);
+        work()
+            .then(async (res) => {
+                if (res && res.error) setMessage({ text: res.error, error: true });
+                else setMessage({ text: done, error: false });
+                await load(appid);
+            })
+            .catch((e) => setMessage({ text: String(e?.message ?? e), error: true }))
+            .finally(() => setBusy(false));
+    }
+
+    const errors = draft ? validate(draft) : [];
+    const dirty = snapshot && draft ? diff(snapshot.metadata, draft).length > 0 : false;
+
+    return (
+        <SettingsModal title="Game Data" isOpen={isOpen} onClose={onClose} width="640px">
+            <GamePicker filter={filter} onFilter={setFilter} appid={appid} onPick={pick} />
+            {message && <span style={{ fontSize: "12px", color: message.error ? "#e57373" : "#66c0f4" }}>{message.text}</span>}
+            {snapshot && draft && (
+                <>
+                    <MetadataForm
+                        draft={draft}
+                        onChange={setDraft}
+                        errors={errors}
+                        dirty={dirty}
+                        custom={snapshot.custom}
+                        hasMetadata={snapshot.hasMetadata}
+                        busy={busy}
+                        onSave={() => run(() => editor.save(snapshot.appid, draft), "Saved.")}
+                        onRevert={() => run(() => editor.revert(snapshot.appid), "Reverted to fetched data.")}
+                    />
+                    <SteamLink snapshot={snapshot} busy={busy} run={run} />
+                </>
+            )}
+        </SettingsModal>
+    );
+}
diff --git a/steam-cartridges/frontend/settings/game-editor/steam-link.tsx b/steam-cartridges/frontend/settings/game-editor/steam-link.tsx
