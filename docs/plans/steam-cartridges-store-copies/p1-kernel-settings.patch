+/** A plain text badge for a store's cards (ADR-0056): the store's name on a dark tile, not its logo. */
+function storeBadge(label: string, color: string): string {
+    const svg =
+        '<svg xmlns="http://www.w3.org/2000/svg" width="96" height="96" viewBox="0 0 96 96">' +
+        `<rect width="96" height="96" rx="12" fill="${color}"/>` +
+        `<text x="48" y="58" font-family="Arial, Helvetica, sans-serif" font-size="26" font-weight="700" fill="#ffffff" text-anchor="middle">${label}</text>` +
+        "</svg>";
+    return `data:image/svg+xml;utf8,${encodeURIComponent(svg)}`;
+}
+
