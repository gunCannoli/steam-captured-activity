diff --git a/steam-cartridges/backend/store_copies_store.lua b/steam-cartridges/backend/store_copies_store.lua
new file mode 100644
index 0000000..341324c
--- /dev/null
+++ b/steam-cartridges/backend/store_copies_store.lua
@@ -0,0 +1,80 @@
+--- The store copies a shortcut is (ADR-0056): <data dir>/store_copies.json. The store stores; store_service.lua finds
+--- and fills. No network here (tests/architecture.test.ts: a store never requires net).
+---
+--- { version = 1, copies = { ["<shortcut appid>"] = StoreCopy }, lookups = { ["epic:<namespace>"] = {...},
+---   ["xbox:<pfn>"] = {...} } }. A lookup remembers what the store's API said about a game (its offer, product, title
+--- id), so another shortcut of the same game, or the next start, asks nothing.
+
+local json     = require("json")
+local utils    = require("utils")
+local data_dir = require("data_dir")
+
+local M = {}
+
+local FILE = "store_copies.json"
+local state = nil
+M._path = nil -- test override
+
+local function path() return M._path or data_dir.file(FILE) end
+
+local function load()
+  if state then return state end
+  state = { version = 1, copies = {}, lookups = {} }
+  local text = utils.read_file(path())
+  if text and #text > 0 then
+    local ok, data = pcall(json.decode, text)
+    if ok and type(data) == "table" then
+      if type(data.copies) == "table" then state.copies = data.copies end
+      if type(data.lookups) == "table" then state.lookups = data.lookups end
+    end
+  end
+  return state
+end
+
+local function save()
+  local tmp = path() .. ".tmp"
+  local ok, err = utils.write_file(tmp, json.encode(load()))
+  if not ok then error("could not write " .. tmp .. ": " .. tostring(err)) end
+  pcall(os.remove, path())
+  if not os.rename(tmp, path()) then
+    utils.write_file(path(), json.encode(load()))
+    pcall(os.remove, tmp)
+  end
+end
+
+function M._reset() state = nil end
+
+local function key(appid) return tostring(math.floor(tonumber(appid) or 0)) end
+
+local function same(a, b) return json.encode(a) == json.encode(b) end
+
+--- The saved copy of a shortcut, or nil. Disk only.
+function M.get(appid) return load().copies[key(appid)] end
+
+--- Save (or, with nil, forget) a shortcut's copy; writes only when it changed.
+function M.set(appid, copy)
+  local s = load()
+  local k = key(appid)
+  if same(s.copies[k], copy) then return end
+  s.copies[k] = copy
+  save()
+end
+
+--- What a store's API said about a game ("epic:<namespace>", "xbox:<pfn>"), or nil.
+function M.lookup(k) return load().lookups[k] end
+
+function M.remember(k, value)
+  local s = load()
+  if same(s.lookups[k], value) then return end
+  s.lookups[k] = value
+  save()
+end
+
+--- Every shortcut appid (a string) with a saved copy.
+function M.copy_keys()
+  local out = {}
+  for k in pairs(load().copies) do out[#out + 1] = k end
+  return out
+end
+
+return M
diff --git a/steam-cartridges/backend/store_epic_local.lua b/steam-cartridges/backend/store_epic_local.lua
new file mode 100644
index 0000000..746673d
--- /dev/null
+++ b/steam-cartridges/backend/store_epic_local.lua
@@ -0,0 +1,176 @@
+--- Epic Games Store copies on this PC (ADR-0056): the launcher's install manifests, its URL handler and the account
+--- the launcher is signed in with. Disk and registry reads only, never the network. Every path comes from the
+--- environment (%ProgramData%, %LOCALAPPDATA%) or the registry, never a hardcoded install folder (ADR-0011).
+---
+--- Facts verified on this machine (2026-10-02, docs/plans/steam-cartridges-store-copies-plan.md § 4):
+---   %ProgramData%\Epic\EpicGamesLauncher\Data\Manifests\*.item  one JSON per installed game: InstallLocation,
+---       LaunchExecutable, DisplayName, CatalogNamespace (= the achievement sandbox), CatalogItemId, AppName;
+---       MainGameCatalogNamespace / MainGameAppName are set for an add-on and empty for a game.
+---   %LOCALAPPDATA%\EpicGamesLauncher\Saved\Data\<32 hex>.dat     the file name is the signed-in account id.
+---   HKCR\com.epicgames.launcher\shell\open\command (Default)      "<launcher exe>" %1
+---   A shortcut may run the game's exe directly (Jotunnslayer) or the launcher link com.epicgames.launcher://apps/<id>.
+
+local json = require("json")
+
+local M = {}
+
+--- Injectable for tests. nil = the real dependency.
+M.deps = {
+  getenv = nil, -- fun(name) -> string | nil                  ; nil = os.getenv
+  list = nil,   -- fun(dir) -> { { name, path, is_file } }     ; nil = fs.list
+  read = nil,   -- fun(path) -> string | nil                   ; nil = io.open
+  mtime = nil,  -- fun(path) -> number                         ; nil = fs.last_write_time
+  run = nil,    -- fun(cmd) -> string | nil                    ; nil = silent_exec.run
+}
+
+local function getenv(name) return (M.deps.getenv or os.getenv)(name) end
+
+local function read(path)
+  if M.deps.read then return M.deps.read(path) end
+  local f = io.open(path, "rb")
+  if not f then return nil end
+  local c = f:read("*a")
+  f:close()
+  return c
+end
+
+local function list(dir)
+  if M.deps.list then return M.deps.list(dir) end
+  local ok, entries = pcall(function() return require("fs").list(dir) end)
+  return ok and type(entries) == "table" and entries or {}
+end
+
+local function mtime(path)
+  if M.deps.mtime then return M.deps.mtime(path) end
+  local ok, t = pcall(function() return require("fs").last_write_time(path) end)
+  return ok and tonumber(t) or 0
+end
+
+local function run(cmd)
+  if M.deps.run then return M.deps.run(cmd) end
+  local ok, out = pcall(function() return require("silent_exec").run(cmd) end)
+  return ok and out or nil
+end
+
+--- A path for comparison: no quotes, backslashes, lower case, no trailing separator.
+function M.norm_path(p)
+  local s = tostring(p or ""):gsub('"', ""):gsub("/", "\\"):lower()
+  s = s:gsub("^%s+", ""):gsub("%s+$", ""):gsub("\\+$", "")
+  return s
+end
+
+--- The manifests folder, or nil when %ProgramData% is unknown.
+function M.manifests_dir()
+  local base = getenv("ProgramData") or getenv("PROGRAMDATA")
+  if not base or base == "" then return nil end
+  return base .. "\\Epic\\EpicGamesLauncher\\Data\\Manifests"
+end
+
+--- One manifest's text -> { app_name, title, install_location, launch_exe, namespace, item_id, addon } | nil (pure).
+function M.parse_manifest(text)
+  local ok, m = pcall(json.decode, text or "")
+  if not ok or type(m) ~= "table" then return nil end
+  local ns = tostring(m.CatalogNamespace or "")
+  local app = tostring(m.AppName or "")
+  if ns == "" or app == "" or not m.InstallLocation then return nil end
+  local main_ns = tostring(m.MainGameCatalogNamespace or "")
+  local main_app = tostring(m.MainGameAppName or "")
+  return {
+    app_name = app,
+    title = tostring(m.DisplayName or ""),
+    install_location = tostring(m.InstallLocation),
+    launch_exe = tostring(m.LaunchExecutable or ""),
+    namespace = ns,
+    item_id = tostring(m.CatalogItemId or ""),
+    -- An add-on (DLC) names its game; the game itself leaves both fields empty (or names itself).
+    addon = (main_app ~= "" and main_app ~= app) or (main_ns ~= "" and main_ns ~= ns),
+  }
+end
+
+--- Every installed game (add-ons left out), from the manifests folder. Disk only.
+function M.installed()
+  local dir = M.manifests_dir()
+  if not dir then return {} end
+  local out = {}
+  for _, e in ipairs(list(dir)) do
+    local name = tostring(e.name or "")
+    if name:lower():match("%.item$") and e.is_file ~= false then
+      local m = M.parse_manifest(read(e.path or (dir .. "\\" .. name)))
+      if m and not m.addon then out[#out + 1] = m end
+    end
+  end
+  table.sort(out, function(a, b) return a.title:lower() < b.title:lower() end)
+  return out
+end
+
+local function url_decode(s)
+  return (s:gsub("%%(%x%x)", function(h) return string.char(tonumber(h, 16)) end))
+end
+
+--- The AppName a launcher link names (pure): com.epicgames.launcher://apps/<AppName>?..., or the newer
+--- apps/<namespace>%3A<item>%3A<AppName>?... form. nil when the text has no launcher link.
+function M.app_name_from_link(text)
+  local id = tostring(text or ""):match("com%.epicgames%.launcher://apps/([^%?&%s\"]+)")
+  if not id then return nil end
+  id = url_decode(id)
+  return id:match("([^:]+)$") or id
+end
+
+--- The installed game a shortcut runs (pure over `games`): its launcher link, else its exe inside an install folder.
+--- Returns the manifest and how it matched ("launch-link" | "manifest"), or nil.
+function M.match(entry, games)
+  if type(entry) ~= "table" then return nil end
+  local app = M.app_name_from_link(entry.launch_options) or M.app_name_from_link(entry.exe)
+  if app then
+    for _, g in ipairs(games or {}) do
+      if g.app_name == app then return g, "launch-link" end
+    end
+  end
+  local exe = M.norm_path(entry.exe)
+  if exe == "" then return nil end
+  for _, g in ipairs(games or {}) do
+    local root = M.norm_path(g.install_location)
+    if root ~= "" and exe:sub(1, #root + 1) == root .. "\\" then return g, "manifest" end
+  end
+  return nil
+end
+
+--- The account the launcher is signed in with: the newest <32 hex>.dat in its Saved\Data folder, or nil.
+function M.account_id()
+  local base = getenv("LOCALAPPDATA")
+  if not base or base == "" then return nil end
+  local dir = base .. "\\EpicGamesLauncher\\Saved\\Data"
+  local best, best_t = nil, -1
+  for _, e in ipairs(list(dir)) do
+    local id = tostring(e.name or ""):lower():match("^(%x+)%.dat$")
+    if id and #id == 32 then
+      local t = mtime(e.path or (dir .. "\\" .. tostring(e.name)))
+      if t > best_t then best, best_t = id, t end
+    end
+  end
+  return best
+end
+
+--- The launcher's exe from its URL handler (pure parse of `reg query ... /ve` output).
+function M.parse_handler(output)
+  local cmd = tostring(output or ""):match("REG_SZ%s+([^\r\n]+)")
+  if not cmd then return nil end
+  return cmd:match('^%s*"([^"]+)"') or cmd:match("^%s*(%S+)")
+end
+
+--- The launcher's exe, or nil (registry read once per call; the caller caches).
+function M.launcher_exe()
+  return M.parse_handler(run('reg query "HKCR\\com.epicgames.launcher\\shell\\open\\command" /ve'))
+end
+
+--- How a shortcut for an installed game is set up (ADR-0056): the launcher, with the game's launch link as its
+--- argument, so the launcher's updates, cloud saves and overlay run as when the user starts it from Epic.
+function M.launch_spec(game, launcher)
+  if not game or not launcher or launcher == "" then return nil end
+  local dir = launcher:match("^(.*)\\[^\\]+$") or ""
+  local link = "com.epicgames.launcher://apps/" .. game.namespace .. "%3A" .. game.item_id .. "%3A" .. game.app_name
+    .. "?action=launch&silent=true"
+  return { exe = '"' .. launcher .. '"', start_dir = dir ~= "" and ('"' .. dir .. '\\"') or "", launch_options = link }
+end
+
+return M
diff --git a/steam-cartridges/backend/store_rpc.lua b/steam-cartridges/backend/store_rpc.lua
new file mode 100644
index 0000000..7dc2264
--- /dev/null
+++ b/steam-cartridges/backend/store_rpc.lua
@@ -0,0 +1,43 @@
+--- Third-party stores (ADR-0056): what the settings panel's Third-party section and the auto-add use.
+---   StoreInstalledGames  every installed Epic and Xbox game, and whether the library has a shortcut for it
+---   StoreAccounts        whether an Epic account was found on this PC (and whether its achievements are private),
+---                        and whether an Xbox account is signed in (its gamertag). Never a token or an account id.
+---   XboxSignInStart / XboxSignInPoll / XboxSignOut   the device-code sign-in (xbox_live.lua)
+
+local core          = require("rpc")
+local store_service = require("store_service")
+local xbox_live     = require("xbox_live")
+local epic_local    = require("store_epic_local")
+local copies        = require("store_copies_store")
+
+local method = core.method
+
+local RPC = {}
+
+--- { allowXbox? }: the installed games (store_service.installed_games).
+RPC.StoreInstalledGames = method("StoreInstalledGames", function(data)
+  return store_service.installed_games({ allowXbox = data.allowXbox ~= false })
+end)
+
+RPC.StoreAccounts = method("StoreAccounts", function(_)
+  local epic_seen = copies.lookup("epic:account") or {}
+  return {
+    epic = { found = epic_local.account_id() ~= nil, private = epic_seen.private == true },
+    xbox = xbox_live.status(),
+  }
+end)
+
+RPC.XboxSignInStart = method("XboxSignInStart", function(_)
+  return xbox_live.sign_in_start()
+end)
+
+--- { device_code }: one poll; the frontend waits `interval` seconds between polls.
+RPC.XboxSignInPoll = method("XboxSignInPoll", function(data)
+  return xbox_live.sign_in_poll(data.device_code)
+end)
+
+RPC.XboxSignOut = method("XboxSignOut", function(_)
+  return xbox_live.sign_out()
+end)
+
+return RPC
diff --git a/steam-cartridges/backend/store_service.lua b/steam-cartridges/backend/store_service.lua
new file mode 100644
index 0000000..1928770
--- /dev/null
+++ b/steam-cartridges/backend/store_service.lua
@@ -0,0 +1,177 @@
+--- Store copies (ADR-0056): is this shortcut an Epic Games Store or Xbox copy of a game, and which one?
+---
+--- Found from files already on the PC, never typed by the user (decision 1): the Epic launcher's install manifests,
+--- the Xbox packages and their game config (store_epic_local.lua, store_xbox_local.lua). The store's API then names the
+--- game's offer and achievement product (Epic) or Store product and title id (Xbox), once per game (the lookup is kept
+--- in store_copies.json). A copy is a fact about the shortcut, like its Steam match (resolve_identity.lua), and a copy
+--- can have both: Steam stays first for Game Info, art and community content (decision 2); the store's own data fills
+--- a copy with no Steam match, and its achievements are the player's from that store (decision 4).
+---
+--- The `store` part of a record: Part<StoreCopy> (frontend kernel/record.ts). `unsupported` = not a store copy.
+
+local logger = require("logger")
+local store  = require("store_copies_store")
+
+local M = {}
+
+--- Injectable for tests. nil = the real dependency.
+M.deps = {
+  entry = nil,        -- fun(appid) -> shortcuts.vdf entry | nil ; nil = registry.shortcut
+  entries = nil,      -- fun() -> every shortcuts.vdf entry       ; nil = registry entries
+  epic_local = nil,   -- nil = store_epic_local
+  xbox_local = nil,   -- nil = store_xbox_local
+  epic = nil,         -- nil = epic_graphql
+  xbox_catalog = nil, -- nil = xbox_catalog
+  now = function() return os.time() end,
+}
+
+local function now_ms() return math.floor((M.deps.now or os.time)() * 1000) end
+local function epic_local() return M.deps.epic_local or require("store_epic_local") end
+local function xbox_local() return M.deps.xbox_local or require("store_xbox_local") end
+local function epic() return M.deps.epic or require("epic_graphql") end
+local function xbox_catalog() return M.deps.xbox_catalog or require("xbox_catalog") end
+
+local function entry_of(appid)
+  if M.deps.entry then return M.deps.entry(appid) end
+  return require("registry").shortcut(appid)
+end
+
+--- The installed games of both stores, read once per session (the installs change rarely; a new game needs a restart
+--- to be found, like a new shortcut's capture folder).
+local installed_cache = nil
+function M._reset() installed_cache = nil end
+
+local function installed()
+  if installed_cache then return installed_cache end
+  local okE, epic_games = pcall(function() return epic_local().installed() end)
+  local okX, xbox_games = pcall(function() return xbox_local().installed() end)
+  installed_cache = {
+    epic = okE and type(epic_games) == "table" and epic_games or {},
+    xbox = okX and type(xbox_games) == "table" and xbox_games or {},
+  }
+  return installed_cache
+end
+
+--- The copy a shortcuts.vdf entry is, from local data only: a StoreCopy table without its API fields, or nil.
+function M.detect(entry)
+  if type(entry) ~= "table" then return nil end
+  local games = installed()
+  local g, via = epic_local().match(entry, games.epic)
+  if g then
+    return { kind = "epic", title = g.title, namespace = g.namespace, itemId = g.item_id, appName = g.app_name, via = via }
+  end
+  local x, xvia = xbox_local().match(entry, games.xbox)
+  if x then
+    return { kind = "xbox", title = x.title, pfn = x.pfn, titleId = x.title_id, storeId = x.store_id, via = xvia }
+  end
+  return nil
+end
+
+--- Disk only: the saved copy as a part, or nil.
+function M.saved(appid)
+  local copy = store.get(appid)
+  if not copy then return nil end
+  return { status = "ok", data = copy, source = copy.kind, checkedAt = now_ms() }
+end
+
+--- The store API fields of an Epic game: offer and achievement product, remembered per namespace.
+local function fill_epic(copy, ctx)
+  local k = "epic:" .. copy.namespace
+  local known = store.lookup(k) or {}
+  if (not known.offerId or not known.productId) and ctx.allowEpic ~= false and not ctx.noNetwork then
+    if not known.offerId then
+      local offer = epic().base_offer(copy.namespace)
+      if offer then known.offerId, known.title = offer.id, offer.title end
+    end
+    if not known.productId then
+      local schema = epic().achievement_schema(copy.namespace)
+      if schema then known.productId = schema.product_id end
+    end
+    store.remember(k, known)
+  end
+  copy.offerId, copy.productId = known.offerId, known.productId
+  copy.title = (known.title and known.title ~= "") and known.title or copy.title
+end
+
+--- The store API fields of an Xbox game: Store product and title, remembered per package family name.
+local function fill_xbox(copy, ctx)
+  local k = "xbox:" .. copy.pfn
+  local known = store.lookup(k) or {}
+  if not known.storeId and ctx.allowXbox ~= false and not ctx.noNetwork then
+    local product = (copy.storeId and xbox_catalog().by_store_id(copy.storeId)) or xbox_catalog().by_pfn(copy.pfn)
+    if product then
+      local ids = xbox_catalog().ids(product)
+      known.storeId, known.title, known.isGame = ids.store_id, ids.title, ids.is_game
+      known.titleId = ids.title_id
+      store.remember(k, known)
+    end
+  end
+  copy.storeId = copy.storeId or known.storeId
+  copy.titleId = copy.titleId or known.titleId
+  copy.title = (known.title and known.title ~= "") and known.title or copy.title
+end
+
+--- The `store` part. ctx = { allowEpic?, allowXbox?, noNetwork? }. Local detection always runs (it is the user's own
+--- disk); the store APIs are asked only when that store is enabled and not already known.
+function M.ensure(appid, ctx)
+  ctx = ctx or {}
+  local copy = M.detect(entry_of(appid))
+  if not copy then
+    store.set(appid, nil)
+    return { status = "unsupported", checkedAt = now_ms() }
+  end
+  local ok, err = pcall(copy.kind == "epic" and fill_epic or fill_xbox, copy, ctx)
+  if not ok then logger:warn("Store copy " .. tostring(appid) .. ": " .. tostring(err)) end -- ADR-0014: the local copy still counts
+  store.set(appid, copy)
+  return { status = "ok", data = copy, source = copy.kind, checkedAt = now_ms() }
+end
+
+local function all_entries()
+  if M.deps.entries then return M.deps.entries() end
+  local ok, list = pcall(function()
+    local paths = require("steam_paths").resolve()
+    if not paths or not paths.shortcuts then return {} end
+    return require("shortcuts").parse(paths.shortcuts) or {}
+  end)
+  return ok and list or {}
+end
+
+local function unsigned(id)
+  local n = tonumber(id) or 0
+  if n < 0 then n = n + 4294967296 end
+  return n
+end
+
+--- Every installed game and whether the library already has a shortcut for it (Third-party settings, auto-add).
+--- { epic = { { key, title, inLibrary, launch } }, xbox = { ... }, epicLauncher = bool }: `launch` = { exe, start_dir,
+--- launch_options } for SteamClient.Apps.AddShortcut. Local data, except an Xbox game whose name is unknown: its
+--- package names a resource, not a title, so the catalog is asked once (ctx.allowXbox, remembered like any lookup).
+function M.installed_games(ctx)
+  ctx = ctx or {}
+  local games = installed()
+  local owned = {}
+  for _, e in ipairs(all_entries()) do
+    local c = M.detect(e)
+    if c then owned[(c.kind == "epic" and c.appName or c.pfn) or ""] = unsigned(e.appid) end
+  end
+  local launcher = epic_local().launcher_exe()
+  local out = { epic = {}, xbox = {}, epicLauncher = launcher ~= nil }
+  for _, g in ipairs(games.epic) do
+    out.epic[#out.epic + 1] = {
+      key = g.app_name, title = g.title, inLibrary = owned[g.app_name],
+      launch = epic_local().launch_spec(g, launcher),
+    }
+  end
+  for _, g in ipairs(games.xbox) do
+    local copy = { kind = "xbox", title = g.title, pfn = g.pfn, titleId = g.title_id, storeId = g.store_id }
+    if not g.title then pcall(fill_xbox, copy, ctx) end
+    local known = store.lookup("xbox:" .. tostring(g.pfn)) or {}
+    out.xbox[#out.xbox + 1] = {
+      key = g.pfn, title = known.title or g.title or g.pfn, inLibrary = owned[g.pfn],
+      launch = xbox_local().launch_spec(g),
+    }
+  end
+  return out
+end
+
+return M
diff --git a/steam-cartridges/backend/store_xbox_local.lua b/steam-cartridges/backend/store_xbox_local.lua
new file mode 100644
index 0000000..8127205
--- /dev/null
+++ b/steam-cartridges/backend/store_xbox_local.lua
@@ -0,0 +1,175 @@
+--- Xbox (PC Game Pass / Microsoft Store) copies on this PC (ADR-0056): the installed packages from the registry and the
+--- Xbox Live game config each game ships. Disk and registry reads only, never the network.
+---
+--- Facts verified on this machine (2026-10-02, docs/plans/steam-cartridges-store-copies-plan.md § 4.7):
+---   reg query "HKCU\Software\Classes\Local Settings\Software\Microsoft\Windows\CurrentVersion\AppModel\Repository\Packages"
+---       /s /v PackageRootFolder  lists every installed package (361 here) with its folder, in about 0.2 s.
+---   <folder>\xboxservices.config     a UWP Xbox Live game (Microsoft Jigsaw): JSON with TitleId (decimal).
+---   <folder>\MicrosoftGame.config    a GDK game: XML with <TitleId> (hex) and <StoreId>. Not seen on a real install yet.
+---   <folder>\AppxManifest.xml        <Application Id="App" Executable="Jigsaw.exe">, <DisplayName>.
+---   A package full name is Name_Version_Arch_ResourceId_PublisherId; its family name is Name_PublisherId, and the
+---   launch target is shell:AppsFolder\<family name>!<application id>.
+
+local json = require("json")
+
+local M = {}
+
+M.PACKAGES_KEY = [[HKCU\Software\Classes\Local Settings\Software\Microsoft\Windows\CurrentVersion\AppModel\Repository\Packages]]
+
+--- Injectable for tests. nil = the real dependency.
+M.deps = {
+  run = nil,    -- fun(cmd) -> string | nil ; nil = silent_exec.run
+  read = nil,   -- fun(path) -> string | nil ; nil = io.open
+  getenv = nil, -- fun(name) -> string | nil ; nil = os.getenv
+}
+
+local function run(cmd)
+  if M.deps.run then return M.deps.run(cmd) end
+  local ok, out = pcall(function() return require("silent_exec").run(cmd) end)
+  return ok and out or nil
+end
+
+local function read(path)
+  if M.deps.read then return M.deps.read(path) end
+  local f = io.open(path, "rb")
+  if not f then return nil end
+  local c = f:read("*a")
+  f:close()
+  return c
+end
+
+local function getenv(name) return (M.deps.getenv or os.getenv)(name) end
+
+--- `reg query ... /s /v PackageRootFolder` output -> { { full_name, root } } (pure).
+function M.parse_packages(output)
+  local out, current = {}, nil
+  for line in tostring(output or ""):gmatch("[^\r\n]+") do
+    local key = line:match("\\Packages\\([^\\]+)%s*$")
+    if key then
+      current = key
+    else
+      local root = line:match("PackageRootFolder%s+REG_SZ%s+(.-)%s*$")
+      if root and current then out[#out + 1] = { full_name = current, root = root } end
+    end
+  end
+  return out
+end
+
+--- Name_Version_Arch_ResourceId_PublisherId -> Name_PublisherId (pure).
+function M.family_name(full_name)
+  local parts = {}
+  for p in tostring(full_name or ""):gmatch("[^_]+") do parts[#parts + 1] = p end
+  if #parts < 2 then return nil end
+  return parts[1] .. "_" .. parts[#parts]
+end
+
+--- xboxservices.config text -> title id (decimal string) | nil (pure).
+function M.parse_services_config(text)
+  if not text then return nil end
+  text = text:gsub("^\239\187\191", "") -- UTF-8 byte order mark
+  local ok, c = pcall(json.decode, text)
+  if not ok or type(c) ~= "table" or c.TitleId == nil then return nil end
+  local n = tonumber(c.TitleId)
+  if not n or n <= 0 then return nil end
+  return string.format("%d", n)
+end
+
+--- MicrosoftGame.config text -> { title_id (decimal string), store_id, name } | nil (pure). The TitleId is hex.
+function M.parse_game_config(text)
+  if not text then return nil end
+  local hex = text:match("<TitleId>%s*(%x+)%s*</TitleId>")
+  if not hex then return nil end
+  local n = tonumber(hex, 16)
+  if not n or n <= 0 then return nil end
+  return {
+    title_id = string.format("%d", n),
+    store_id = text:match("<StoreId>%s*([%w]+)%s*</StoreId>"),
+    name = text:match('<Identity[^>]-Name="([^"]+)"'),
+  }
+end
+
+--- AppxManifest.xml text -> { app_id, executable, title } (pure). The title may be an ms-resource reference: nil then.
+function M.parse_appx_manifest(text)
+  if not text then return nil end
+  local app = text:match("<Application%s[^>]-Id=\"([^\"]+)\"")
+  local exe = text:match("<Application%s[^>]-Executable=\"([^\"]+)\"")
+  local title = text:match("<DisplayName>%s*([^<]-)%s*</DisplayName>")
+  if title and title:match("^ms%-resource:") then title = nil end
+  return { app_id = app, executable = exe, title = title }
+end
+
+--- Every installed Xbox Live game: a package with an Xbox game config. Registry and disk only.
+--- { { pfn, full_name, root, title_id, store_id?, app_id, executable?, title?, via = "config" } }
+function M.installed()
+  local out = {}
+  for _, p in ipairs(M.parse_packages(run('reg query "' .. M.PACKAGES_KEY .. '" /s /v PackageRootFolder'))) do
+    local title_id, store_id
+    local services = M.parse_services_config(read(p.root .. "\\xboxservices.config"))
+    if services then
+      title_id = services
+    else
+      local game = M.parse_game_config(read(p.root .. "\\MicrosoftGame.config"))
+      if game then title_id, store_id = game.title_id, game.store_id end
+    end
+    if title_id then
+      local manifest = M.parse_appx_manifest(read(p.root .. "\\AppxManifest.xml")) or {}
+      out[#out + 1] = {
+        pfn = M.family_name(p.full_name),
+        full_name = p.full_name,
+        root = p.root,
+        title_id = title_id,
+        store_id = store_id,
+        app_id = manifest.app_id or "App",
+        executable = manifest.executable,
+        title = manifest.title,
+        via = "config",
+      }
+    end
+  end
+  table.sort(out, function(a, b) return (a.title or a.pfn or ""):lower() < (b.title or b.pfn or ""):lower() end)
+  return out
+end
+
+local function norm_path(p)
+  local s = tostring(p or ""):gsub('"', ""):gsub("/", "\\"):lower()
+  return (s:gsub("^%s+", ""):gsub("%s+$", ""):gsub("\\+$", ""))
+end
+
+--- The package family name a shell:AppsFolder target names, or nil (pure).
+function M.pfn_from_target(text)
+  return tostring(text or ""):match("[Ss][Hh][Ee][Ll][Ll]:[Aa][Pp][Pp][Ss][Ff][Oo][Ll][Dd][Ee][Rr]\\([^!%s\"]+)!")
+end
+
+--- The installed game a shortcut runs (pure over `games`): its shell:AppsFolder target, else its exe inside a
+--- package folder. Returns the game and how it matched ("launch-link" | "package"), or nil.
+function M.match(entry, games)
+  if type(entry) ~= "table" then return nil end
+  local pfn = M.pfn_from_target(entry.launch_options) or M.pfn_from_target(entry.exe)
+  if pfn then
+    for _, g in ipairs(games or {}) do
+      if g.pfn and g.pfn:lower() == pfn:lower() then return g, "launch-link" end
+    end
+  end
+  local exe = norm_path(entry.exe)
+  if exe == "" then return nil end
+  for _, g in ipairs(games or {}) do
+    local root = norm_path(g.root)
+    if root ~= "" and exe:sub(1, #root + 1) == root .. "\\" then return g, "package" end
+  end
+  return nil
+end
+
+--- How a shortcut for an installed game is set up (ADR-0056): Windows Explorer opening the package's app, the way the
+--- Xbox app and the Start menu start it (the game's own exe cannot be run directly from a protected package folder).
+function M.launch_spec(game)
+  if not game or not game.pfn then return nil end
+  local windir = getenv("SystemRoot") or getenv("windir")
+  if not windir or windir == "" then return nil end
+  return {
+    exe = '"' .. windir .. '\\explorer.exe"',
+    start_dir = '"' .. windir .. '\\"',
+    launch_options = "shell:AppsFolder\\" .. game.pfn .. "!" .. (game.app_id or "App"),
+  }
+end
+
+return M
diff --git a/steam-cartridges/backend/web_config.lua b/steam-cartridges/backend/web_config.lua
index a12c30c..e01c946 100644
--- a/steam-cartridges/backend/web_config.lua
+++ b/steam-cartridges/backend/web_config.lua
@@ -145,6 +145,18 @@ function config.get_screenscraper_credentials()
   return nil
 end
 
+--- The Xbox account (ADR-0056): the Microsoft refresh token and whose it is, or nil when signed out. Written by
+--- xbox_live.lua through save_credentials (keys xbox_refresh_token, xbox_xuid, xbox_gamertag); never logged.
+---@return table|nil { refresh_token = string, xuid = string, gamertag = string }
+function config.get_xbox_account()
