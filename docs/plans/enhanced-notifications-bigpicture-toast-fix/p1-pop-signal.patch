diff --git a/enhanced-notifications/frontend/surfaces/style/toast-pop.ts b/enhanced-notifications/frontend/surfaces/style/toast-pop.ts
new file mode 100644
index 0000000..23a2030
--- /dev/null
+++ b/enhanced-notifications/frontend/surfaces/style/toast-pop.ts
@@ -0,0 +1,40 @@
+/**
+ * The moment Steam hands a toast to a toast view: `NotificationStore.PopNextToastNotification(context)`. Every toast
+ * container (Big Picture, desktop, in-game overlay) calls it inside a React state updater, so before that toast
+ * renders (verified live 2026-10-01, docs/steam-components.md § Big Picture toast view).
+ *
+ * Wrapped as an own property of the store instance, nothing global. The wrapper calls what the store resolved
+ * before it (an own property someone else set, or else the prototype's method looked up at call time, so a later
+ * prototype wrapper still runs) and returns its value unchanged. `onPop` sees only real toasts (a non-null object)
+ * and cannot break Steam's pop: its error goes to `reportError`. Pure (no imports), so `npm test` checks it.
+ */
+type PopFn = (this: unknown, ...args: unknown[]) => unknown;
+
+const KEY = 'PopNextToastNotification';
+
+/** Returns an uninstall function, or null when Steam has no such method (the caller falls back to `onShown`). */
+export function installToastPop(store: object, onPop: (notification: { eType?: number }) => void, reportError: (error: unknown) => void): (() => void) | null {
+    const target = store as Record<string, unknown>;
+    if (typeof target[KEY] !== 'function') return null;
+    const own = Object.prototype.hasOwnProperty.call(store, KEY) ? (target[KEY] as PopFn) : null;
+    let active = true;
+    const wrapper: PopFn = function (this: unknown, ...args: unknown[]) {
+        const next = own ?? ((Object.getPrototypeOf(store) as Record<string, unknown>)[KEY] as PopFn);
+        const n = next.apply(this, args);
+        if (active && n && typeof n === 'object') {
+            try {
+                onPop(n as { eType?: number });
+            } catch (error) {
+                reportError(error);
+            }
+        }
+        return n;
+    };
+    target[KEY] = wrapper;
+    return () => {
+        active = false;
+        if (target[KEY] !== wrapper) return; // someone wrapped on top of us: stay in the chain, passing through
+        if (own) target[KEY] = own;
+        else delete target[KEY];
+    };
+}
diff --git a/enhanced-notifications/frontend/surfaces/style/type-source.ts b/enhanced-notifications/frontend/surfaces/style/type-source.ts
new file mode 100644
index 0000000..f95776f
--- /dev/null
+++ b/enhanced-notifications/frontend/surfaces/style/type-source.ts
@@ -0,0 +1,28 @@
+/**
+ * Which Steam signal sets the type of the toast on screen, for Big Picture's one toast window and for a desktop popup
+ * whose own type is not known yet (./injector.ts). Pure, so `npm test` checks it.
+ *
+ * - `pop` (the default): `NotificationStore.PopNextToastNotification` handed this toast to a toast view
+ *   (./toast-pop.ts). Steam calls it before the toast renders, so the type is in place for its first frame.
+ * - `shown`: the shared hook's `onShown`, from Steam's effect after the toast is committed (a frame late). The
+ *   fallback when Steam has no `PopNextToastNotification`.
+ * - `arrival`: NotificationStore's current toast, which changes when a toast ARRIVES, also while another one is on
+ *   screen: a queued toast restyled the one showing, and Steam's own 300 px slide-in restarted (verified live
+ *   2026-10-01, docs/plans/enhanced-notifications-bigpicture-toast-fix-plan.md). Kept only as a debug switch that
+ *   reproduces that; like the old code, it also takes `shown`.
+ * - `manual`: neither; a probe sets the type (./bp-debug.ts `debugBigPictureType`).
+ */
+export type TypeSource = 'pop' | 'shown' | 'arrival' | 'manual';
+
+/** A signal is a source, or `refresh` (a theme or setting change re-applying the current type). */
+export type TypeSignal = TypeSource | 'refresh';
+
+export const TYPE_SOURCES: readonly TypeSource[] = ['pop', 'shown', 'arrival', 'manual'];
+
+/** Whether `signal` may set the current toast type under `source`. `popAvailable` false: `pop` falls back to `shown`. */
+export function takesSignal(source: TypeSource, signal: TypeSignal, popAvailable: boolean): boolean {
+    if (signal === 'refresh') return true;
+    const effective: TypeSource = source === 'pop' && !popAvailable ? 'shown' : source;
+    if (effective === 'arrival') return signal === 'arrival' || signal === 'shown';
+    return signal === effective;
+}
