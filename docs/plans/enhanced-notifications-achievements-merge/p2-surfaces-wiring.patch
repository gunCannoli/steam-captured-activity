index 0000000..ac404c2
--- /dev/null
+++ b/enhanced-notifications/frontend/surfaces/banner/toast-patch.ts
@@ -0,0 +1,115 @@
+import { findModuleByExport } from '@steambrew/client';
+import { logger } from '../../logger';
+import { achievementTheme } from '../../theme/active-theme';
+import { setting } from '../../settings/settings';
+import { ThemedToast, setSteamToast } from './themed-toast';
+import type { SteamNotification } from '../../kernel/notification';
+import { isAchievementUnlock } from '../../steam/notification-store';
+import { findExports } from '../../steam/webpack';
+import { keepJsxPatched, type JsxHookDiagnostics } from '../../steam/jsx-hook';
+import { isEnabled, reportError } from '../../safety/runtime';
+
+/**
+ * Swaps Steam's notification-toast dispatcher for our themed toast, for
+ * unlocked achievements only.
+ *
+ * Verified live: the achievement renderer is not exported, but its dispatcher
+ * is. That is the exported function that switches on a group's eType, and it
+ * is created as `jsx(dispatcher, { location, group, onDismiss })` inside
+ * Steam's toast container. Every toast window (desktop popup, Big Picture, in-game
+ * overlay) is a portal from SharedJSContext, and `react/jsx-runtime` is one
+ * shared module (ADR-0027), so one patch covers them all.
+ *
+ * Guardrail 2: `jsx` runs for every element in the client. The added work is
+ * one identity compare (`type === dispatcher`); everything else happens only
+ * for that one component.
+ */
+
+interface JsxRuntime {
+    jsx(type: unknown, props: unknown, key?: unknown): unknown;
+    jsxs(type: unknown, props: unknown, key?: unknown): unknown;
+}
+
+interface ToastProps {
+    group?: { eType?: number; notifications?: SteamNotification[] };
+}
+
+let runtime: JsxRuntime | null = null;
+let dispatcher: unknown = null;
+let hook: ReturnType<typeof keepJsxPatched> | null = null;
+
+function resolveDispatcher(): unknown {
+    const hits = findExports(
+        (src) => src.includes('global_achieved_pct()') && src.includes('Missing activate function'),
+        (value) => {
+            if (typeof value !== 'function') return false;
+            const src = Function.prototype.toString.call(value);
+            return src.includes('group') && /switch\(\w\)\{case/.test(src);
+        },
+    );
+    if (hits.length !== 1) {
+        logger.warn(`Toast dispatcher resolved to ${hits.length} candidates (expected 1); banner disabled.`);
+        return null;
+    }
+    return hits[0];
+}
+
+function resolveRuntime(): JsxRuntime | null {
+    const found = findModuleByExport(
+        (moduleExport: unknown, exportName?: unknown) =>
+            (exportName === 'jsx' || exportName === 'jsxs') && typeof moduleExport === 'function',
+    ) as JsxRuntime | undefined;
+    return found && typeof found.jsx === 'function' && typeof found.jsxs === 'function' ? found : null;
+}
+
+/** An unlock, with the theme's `achievements` block loaded and "Themed style" on (off: Steam's look for every toast). */
+function shouldTheme(props: ToastProps | undefined): boolean {
+    const n = props?.group?.notifications?.[0];
+    return isAchievementUnlock(n) && achievementTheme() !== null && setting('style.enabled');
+}
+
+/**
+ * True once the banner patch is installed (read by index.tsx's `bannerDraws`, which the style surface asks on every
+ * toast). O(1): the patch heals itself within a microtask of being dropped (steam/jsx-hook.ts), so "installed" means
+ * "kept installed". Walking the chain here could call the jsx runtime with a sentinel on every toast.
+ */
+export function toastPatchInstalled(): boolean {
+    return hook !== null;
+}
+
+/** Chain health, for tests (window.PLUGIN_LIST[...].jsxDiagnostics()). */
+export function jsxDiagnostics(): JsxHookDiagnostics[] {
+    return hook?.diagnostics() ?? [];
+}
+
+export function initToastPatch(): boolean {
+    dispatcher = resolveDispatcher();
+    runtime = resolveRuntime();
+    if (!dispatcher || !runtime) {
+        if (!runtime) logger.warn('react/jsx-runtime not found; banner disabled.');
+        return false;
+    }
+    setSteamToast(dispatcher);
+    // Self-healing SDK patch shared safely with other plugins (steam/jsx-hook.ts):
+    // it re-installs only when it is no longer anywhere in the chain.
+    hook = keepJsxPatched(runtime, {
+        label: 'enhanced-notifications',
+        replaceType: (type, props) => {
+            if (type !== dispatcher) return undefined; // every other element: one compare
+            // Fail-open (migration plan § E0a): any error leaves Steam's own toast.
+            try {
+                return isEnabled('banner') && shouldTheme(props as ToastProps) ? ThemedToast : undefined;
+            } catch (error) {
+                reportError('banner', error);
+                return undefined;
+            }
+        },
+    });
+    logger.info('Achievement toast patch installed.');
+    return true;
+}
+
+export function disposeToastPatch(): void {
+    hook?.dispose();
+    hook = null;
+}
diff --git a/enhanced-notifications/frontend/surfaces/banner/window-pin.ts b/enhanced-notifications/frontend/surfaces/banner/window-pin.ts
new file mode 100644
index 0000000..7ff7297
--- /dev/null
+++ b/enhanced-notifications/frontend/surfaces/banner/window-pin.ts
@@ -0,0 +1,99 @@
+import { logger } from '../../logger';
+
+/**
+ * Pins one desktop / in-game overlay toast popup to our computed position.
+ *
+ * Steam's toast stack moves every toast popup each frame of its fade-in and
+ * fade-out, anchored with its own position setting and a fixed 283 px width
+ * (verified live 2026-09-25, see docs/steam-components.md § Desktop toast
+ * stack). Instead of racing it, this replaces **that popup's own**
+ * `SteamClient.Window.MoveTo` (an own, writable property; verified live) so
+ * Steam keeps the timing and we decide the place. Nothing global is patched,
+ * and the popup is destroyed with the toast.
+ *
+ * The style surface's remap (../style/toast-window.ts) wraps the same property
+ * first, when the popup opens; this pin wraps on top of it, for the banner's own
+ * popups only, and the remap passes those through (`bannerDraws`). One Steam
+ * target, two writers in a fixed order (ADR-0050; tests/architecture.test.ts).
+ *
+ * Big Picture's single persistent toast popup is never pinned (it is not
+ * registered with Steam's per-toast popup manager — see docs/steam-components.md
+ * § Toast windows).
+ */
+
+type MoveTo = (x: number, y: number, dpi?: number | boolean) => void;
+interface WindowApi {
+    MoveTo: MoveTo;
+    ResizeTo(width: number, height: number, applyBrowserScale: boolean): void;
+}
+
+const PER_TOAST_POPUP = /^notificationtoasts_(\d+_desktop|uid\d+-\d+)$/;
+
+/** Live pinned popups by stack slot; `null` is a free slot. */
+const slots: (Window | null)[] = [];
+
+export interface PinTarget {
+    x: number;
+    y: number;
+    width: number;
+    height: number;
+}
+
+export interface PinnedWindow {
+    /** Stack slot this popup holds (0 = nearest the anchor corner). */
+    slot: number;
+    /** Move/resize the popup; Steam's per-frame MoveTo keeps landing on it. */
+    retarget(target: PinTarget): void;
+    unpin(): void;
+}
+
+/** True for the per-toast popups Steam opens on desktop and in the in-game overlay. */
+export function isPerToastPopup(win: Window): boolean {
+    return PER_TOAST_POPUP.test(win.name);
+}
+
+/** Pin a per-toast popup; null when `win` is not one (Big Picture) or the API is missing. */
+export function pinToastWindow(win: Window, targetFor: (slot: number) => PinTarget): PinnedWindow | null {
+    if (!isPerToastPopup(win)) return null;
+    const api = (win as unknown as { SteamClient?: { Window?: WindowApi } }).SteamClient?.Window;
+    if (!api || typeof api.MoveTo !== 'function' || typeof api.ResizeTo !== 'function') return null;
+
+    let slot = slots.indexOf(null);
+    if (slot < 0) slot = slots.length;
+    slots[slot] = win;
+
+    let target = targetFor(slot);
+    const original = api.MoveTo;
+    const dpiOf = (dpi: unknown) => (typeof dpi === 'number' && dpi > 0 ? dpi : win.devicePixelRatio || 1);
+    const pinned: MoveTo = (_x, _y, dpi) => original.call(api, target.x, target.y, dpiOf(dpi));
+    const release = () => {
+        if (api.MoveTo === pinned) api.MoveTo = original;
+        if (slots[slot] === win) slots[slot] = null;
+        while (slots.length && slots[slots.length - 1] === null) slots.pop();
+    };
+
+    try {
+        api.ResizeTo(target.width, target.height, true);
+        api.MoveTo = pinned;
+        original.call(api, target.x, target.y, dpiOf(undefined));
+    } catch (error) {
+        logger.warn('Could not pin the toast window; Steam places it.', error);
+        release();
+        return null;
+    }
+
+    return {
+        slot,
+        retarget(next) {
+            const resized = next.width !== target.width || next.height !== target.height;
+            target = next;
+            try {
+                if (resized) api.ResizeTo(next.width, next.height, true);
+                original.call(api, next.x, next.y, dpiOf(undefined));
+            } catch (error) {
+                logger.warn('Could not move the toast window.', error);
+            }
+        },
+        unpin: release,
+    };
+}
diff --git a/enhanced-notifications/frontend/surfaces/captures/captures.ts b/enhanced-notifications/frontend/surfaces/captures/captures.ts
new file mode 100644
index 0000000..095583e
--- /dev/null
+++ b/enhanced-notifications/frontend/surfaces/captures/captures.ts
@@ -0,0 +1,196 @@
+import { logger } from '../../logger';
+import { setting } from '../../settings/settings';
+import type { Tier } from '../../theme/achievements';
+import { addTimelineEntry, runningGameAppid, saveClip, snapshotTimeline, takeScreenshot, type TimelineSnapshot } from './recording';
+import { ENTRY_TYPE, gameIdCandidates, mergeClip, planCaptures, type Action, type CaptureSettings, type Plan } from '../../capture/plan';
+import type { SteamNotification } from '../../kernel/notification';
+import { reportError } from '../../safety/runtime';
+
+/**
+ * Schedules Phase 7 auto-captures (screenshot / clip / timeline marker) on
+ * achievement unlock. The `achievement.unlocked` subscriber in `index.tsx` calls `onUnlock`
+ * synchronously (O(1): dedupe, snapshot, schedule); every RPC runs later, in a
+ * `setTimeout` callback, never in the hook itself (the one scoped exception to
+ * guardrail 5 — see docs/plans/phase7-and-alpha-plan.md § A1.7).
+ */
+
+const seen = new WeakSet<object>();
+let dryRun = false;
+
+interface LogAction {
+    kind: Action['kind'];
+    request: unknown;
+    eresult?: number;
+}
+interface LogEntry {
+    at: number;
+    appid: number;
+    tier: Tier;
+    gameId?: string;
+    shortcut?: boolean | null;
+    dryRun: boolean;
+    actions: LogAction[];
+    skipped: Plan['skipped'];
+}
+
+const LOG_MAX = 20;
+const log: LogEntry[] = [];
+
+function pushLog(entry: LogEntry): void {
+    log.push(entry);
+    if (log.length > LOG_MAX) log.shift();
+}
+
+export function captureLog(): readonly LogEntry[] {
+    return log;
+}
+
+export function setCaptureDryRun(on: boolean): void {
+    dryRun = on;
+}
+
+function baseSettings(): CaptureSettings {
+    return {
+        screenshot: { enabled: setting('screenshot.enabled'), delayMs: setting('screenshot.delay_ms') },
+        clip: { enabled: setting('recording.enabled'), durationS: setting('recording.duration_s'), delayMs: setting('recording.delay_ms') },
+        marker: { enabled: setting('recording.add_timeline_marker') },
+    };
+}
+
+// One pending (unsent) clip timer per timelineId, for coalescing (A2.2).
+const pendingClips = new Map<string, { action: Extract<Action, { kind: 'clip' }>; count: number; timer: ReturnType<typeof setTimeout> }>();
+const timers = new Set<ReturnType<typeof setTimeout>>();
+
+function schedule(fn: () => void, ms: number): ReturnType<typeof setTimeout> {
+    const t = setTimeout(() => {
+        timers.delete(t);
+        fn();
+    }, ms);
+    timers.add(t);
+    return t;
+}
+
+async function sendScreenshot(gameId: string, timelineId: string, action: Extract<Action, { kind: 'screenshot' }>, appid: number, tier: Tier): Promise<void> {
+    const request = { game_id: gameId, timeline_id: timelineId, timeline_offset_ms: String(Math.floor(action.targetOffsetMs)) };
+    if (dryRun) {
+        logger.info(`[dry-run] screenshot`, request);
+        pushLog({ at: Date.now(), appid, tier, gameId, dryRun: true, actions: [{ kind: 'screenshot', request }], skipped: [] });
+        return;
+    }
+    const res = await takeScreenshot(request);
+    if (!res.ok) logger.warn(`Screenshot failed (EResult ${res.eresult}).`, res.error ?? res.body);
+    pushLog({ at: Date.now(), appid, tier, gameId, dryRun: false, actions: [{ kind: 'screenshot', request, eresult: res.eresult }], skipped: [] });
+}
+
+async function sendClip(gameId: string, timelineId: string, action: Extract<Action, { kind: 'clip' }>, appid: number, tier: Tier): Promise<void> {
+    const request = {
+        game_id: gameId,
+        start: { timeline_id: timelineId, offset_ms: String(Math.floor(action.startOffsetMs)) },
+        end: { timeline_id: timelineId, offset_ms: String(Math.floor(action.endOffsetMs)) },
+        name: action.name,
+        temporary: false,
+        force_thumbnail: true,
+    };
+    if (dryRun) {
+        logger.info(`[dry-run] clip`, request);
+        pushLog({ at: Date.now(), appid, tier, gameId, dryRun: true, actions: [{ kind: 'clip', request }], skipped: [] });
+        return;
+    }
+    const res = await saveClip(request);
+    if (!res.ok) logger.warn(`Clip failed (EResult ${res.eresult}).`, res.error ?? res.body);
+    pushLog({ at: Date.now(), appid, tier, gameId, dryRun: false, actions: [{ kind: 'clip', request, eresult: res.eresult }], skipped: [] });
+}
+
+async function sendMarker(gameId: string, timelineId: string, action: Extract<Action, { kind: 'marker' }>, appid: number, tier: Tier): Promise<void> {
+    const entryBase = { timeline_id: timelineId, entry_id: '', time: String(action.time), marker_priority: 0 };
+    const eventRequest = {
+        game_id: gameId,
+        entry: { ...entryBase, type: ENTRY_TYPE.Event, marker_icon: 'steam_achievement', range_title: action.name, marker_description: action.description, range_duration: '0' },
+    };
+    if (dryRun) {
+        logger.info(`[dry-run] marker`, eventRequest);
+        pushLog({ at: Date.now(), appid, tier, gameId, dryRun: true, actions: [{ kind: 'marker', request: eventRequest }], skipped: [] });
+        return;
+    }
+    let res = await addTimelineEntry(eventRequest);
+    const actions: LogAction[] = [{ kind: 'marker', request: eventRequest, eresult: res.eresult }];
+    if (res.eresult !== 1) {
+        const fallbackRequest = { game_id: gameId, entry: { ...entryBase, type: ENTRY_TYPE.UserMarker, marker_icon: 'steam_marker' } };
+        logger.warn(`Achievement Event marker rejected (EResult ${res.eresult}); retrying as a plain marker.`);
+        res = await addTimelineEntry(fallbackRequest);
+        actions.push({ kind: 'marker', request: fallbackRequest, eresult: res.eresult });
+    }
+    if (res.eresult !== 1) logger.warn(`Timeline marker failed (EResult ${res.eresult}).`, res.error ?? res.body);
+    pushLog({ at: Date.now(), appid, tier, gameId, dryRun: false, actions, skipped: [] });
+}
+
+/** Called from the `achievement.unlocked` event, one macrotask after the toast. O(1): dedupe, tier merge, snapshot, schedule. Never awaits an RPC. */
+export function onUnlock(n: SteamNotification, tier: Tier): void {
+    try {
+        if (seen.has(n.data)) return;
+        seen.add(n.data);
+
+        const settings = baseSettings();
+
+        const appid = n.data.appid();
+        const nowMs = Date.now();
+        const candidates = gameIdCandidates(appid);
+        const { snap, reason } = snapshotTimeline(candidates);
+
+        const timelineSnap: TimelineSnapshot | null = snap;
+        const plan = planCaptures(
+            settings,
+            { appid, name: n.data.name(), description: n.data.description(), nowMs, rtCreatedS: n.rtCreated },
+            timelineSnap,
+        );
+
+        if (plan.actions.length === 0) {
+            if (plan.skipped.length) {
+                logger.info(`Unlock captures skipped for appid ${appid}: ${plan.skipped.map((s) => s.reason).join(', ')}${reason && !snap ? ` (${reason})` : ''}`);
+                pushLog({ at: nowMs, appid, tier, dryRun, actions: [], skipped: plan.skipped });
+            }
+            return;
+        }
+
+        const gameId = timelineSnap!.gameId;
+        const timelineId = timelineSnap!.timelineId;
+        logger.info(`Unlock captures planned for appid ${appid} (${plan.actions.map((a) => a.kind).join(', ')}).`);
+
+        for (const action of plan.actions) {
+            if (action.kind === 'screenshot') {
+                schedule(() => void sendScreenshot(gameId, timelineId, action, appid, tier), action.sendAfterMs);
+            } else if (action.kind === 'marker') {
+                schedule(() => void sendMarker(gameId, timelineId, action, appid, tier), action.sendAfterMs);
+            } else {
+                const pending = pendingClips.get(timelineId);
+                if (pending) {
+                    clearTimeout(pending.timer);
+                    timers.delete(pending.timer);
+                    const merged = mergeClip(pending.action, action, pending.count + 1);
+                    const timer = schedule(() => {
+                        pendingClips.delete(timelineId);
+                        void sendClip(gameId, timelineId, merged, appid, tier);
+                    }, merged.sendAfterMs);
+                    pendingClips.set(timelineId, { action: merged, count: pending.count + 1, timer });
+                } else {
+                    const timer = schedule(() => {
+                        pendingClips.delete(timelineId);
+                        void sendClip(gameId, timelineId, action, appid, tier);
+                    }, action.sendAfterMs);
+                    pendingClips.set(timelineId, { action, count: 0, timer });
+                }
+            }
+        }
+    } catch (error) {
+        reportError('captures', error); // no captures for this unlock
+    }
+}
+
+export function disposeCaptures(): void {
+    for (const t of timers) clearTimeout(t);
+    timers.clear();
+    for (const p of pendingClips.values()) clearTimeout(p.timer);
+    pendingClips.clear();
+}
+
+export { runningGameAppid };
diff --git a/enhanced-notifications/frontend/surfaces/captures/index.ts b/enhanced-notifications/frontend/surfaces/captures/index.ts
