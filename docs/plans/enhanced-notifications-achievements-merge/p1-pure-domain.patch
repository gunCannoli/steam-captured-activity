+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { bannerSize, placeBanner } from '../frontend/banner/geometry.ts';
+
+const e = (top: number, bottom: number, left: number, right: number) => ({ top, bottom, left, right });
+
+const avail = { left: 0, top: 0, width: 2048, height: 1104 };
+const size = { width: 400, height: 70 };
+const banner = (scale: [number, number]) => ({
+    scale,
+    background: ['#000'],
+    gradientAngle: 90,
+    border: { width: 0, color: '#fff', radius: 0 },
+    glow: { color: '#000', spread: 0, pulseMs: 0 },
+    margin: e(5, 5, 5, 5),
+    padding: e(8, 8, 8, 8),
+    gap: [5, 5] as [number, number],
+});
+
+test('placeBanner: every anchor with margin 5 is 5 px in from its corner', () => {
+    assert.deepEqual(placeBanner('top_right', e(5, 5, 5, 5), size, avail), { x: 1643, y: 5 });
+    assert.deepEqual(placeBanner('top_left', e(5, 5, 5, 5), size, avail), { x: 5, y: 5 });
+    assert.deepEqual(placeBanner('bottom_right', e(5, 5, 5, 5), size, avail), { x: 1643, y: 1029 });
+    assert.deepEqual(placeBanner('bottom_left', e(5, 5, 5, 5), size, avail), { x: 5, y: 1029 });
+    assert.deepEqual(placeBanner('top_center', e(5, 5, 5, 5), size, avail), { x: 824, y: 5 });
+    assert.deepEqual(placeBanner('bottom_center', e(5, 5, 5, 5), size, avail), { x: 824, y: 1029 });
+});
+
+test('placeBanner: a scaled banner stays anchored and on screen', () => {
+    assert.deepEqual(placeBanner('bottom_right', e(5, 5, 5, 5), { width: 800, height: 140 }, avail), { x: 1243, y: 959 });
+    assert.deepEqual(placeBanner('top_right', e(0, 0, 0, 0), { width: 3000, height: 70 }, avail), { x: 0, y: 0 });
+});
+
+test('placeBanner: negative margins are clamped to the screen edge', () => {
+    assert.deepEqual(placeBanner('top_left', e(-50, -50, -50, -50), size, avail), { x: 0, y: 0 });
+    assert.deepEqual(placeBanner('bottom_right', e(-50, -50, -50, -50), size, avail), { x: 1648, y: 1034 });
+});
+
+test('placeBanner: stack slots move away from the anchor edge', () => {
+    assert.deepEqual(placeBanner('top_right', e(5, 5, 5, 5), size, avail, 1), { x: 1643, y: 83 });
+    assert.deepEqual(placeBanner('bottom_right', e(5, 5, 5, 5), size, avail, 1), { x: 1643, y: 951 });
+});
+
+test('bannerSize: scale changes the box, never the content height', () => {
+    const a = bannerSize('ps5', banner([100, 100]));
+    const b = bannerSize('ps5', banner([200, 150]));
+    assert.deepEqual([a.width, a.height, a.innerH], [400, 70, 54]);
+    assert.deepEqual([b.width, b.height, b.innerH], [800, 105, 54]);
+    assert.equal(bannerSize('compact_pill', banner([100, 100])).height, 48);
+    assert.equal(bannerSize('default_steam', banner([100, 100])).width, 283);
+});
+
+test('placeBanner: only the margins of the anchored sides count', () => {
+    const m = e(10, 5, 4, 7);
+    assert.deepEqual(placeBanner('top_right', m, size, avail), { x: 1648 - 7, y: 10 });
+    assert.deepEqual(placeBanner('bottom_left', m, size, avail), { x: 4, y: 1034 - 5 });
+});
+
+test('bannerSize: content height subtracts top and bottom padding', () => {
+    assert.equal(bannerSize('ps5', { ...banner([100, 100]), padding: e(10, 5, 4, 7) }).innerH, 70 - 15 - 2 * banner([100, 100]).border.width);
+});
diff --git a/enhanced-notifications/tests/kernel.test.ts b/enhanced-notifications/tests/kernel.test.ts
new file mode 100644
index 0000000..56384fd
--- /dev/null
+++ b/enhanced-notifications/tests/kernel.test.ts
@@ -0,0 +1,86 @@
+// Kernel contract tests (migration plan § E1a): event bus, Surface runner, notification ids.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createEventBus } from '../frontend/kernel/events.ts';
+import { assertDisjointTouches, installSurfaces, type Surface } from '../frontend/kernel/surface.ts';
+import { achievementIdOf, COMPLETION_ID, PREVIEW_ID_PREFIX, syntheticKind, TEST_UNLOCK_ID, type SteamNotification } from '../frontend/kernel/notification.ts';
+
+const unlocked = (id: string) => ({ n: { eType: 1, data: { achievement_id: () => id } } as unknown as SteamNotification, atMs: 1, completesGame: false });
+
+test('events: handlers run in order; a throwing handler does not stop the others', () => {
+    const errors: string[] = [];
+    const bus = createEventBus((event, err) => errors.push(`${event}:${(err as Error).message}`));
+    const seen: string[] = [];
+    bus.on('achievement.unlocked', () => seen.push('a'));
+    bus.on('achievement.unlocked', () => {
+        throw new Error('boom');
+    });
+    bus.on('achievement.unlocked', () => seen.push('c'));
+    bus.emit('achievement.unlocked', unlocked('X'));
+    assert.deepEqual(seen, ['a', 'c']);
+    assert.deepEqual(errors, ['achievement.unlocked:boom']);
+});
+
+test('events: off() unsubscribes and count() reports handlers', () => {
+    const bus = createEventBus();
+    let calls = 0;
+    const off = bus.on('achievement.unlocked', () => calls++);
+    assert.equal(bus.count('achievement.unlocked'), 1);
+    bus.emit('achievement.unlocked', unlocked('X'));
+    off();
+    off();
+    assert.equal(bus.count('achievement.unlocked'), 0);
+    bus.emit('achievement.unlocked', unlocked('X'));
+    assert.equal(calls, 1);
+});
+
+const surface = (id: string, touches: string[], install: () => boolean = () => true): Surface => ({ id, touches, install, uninstall() {} });
+
+test('surface: assertDisjointTouches names both surfaces of a shared target', () => {
+    assert.doesNotThrow(() => assertDisjointTouches([surface('a', ['x']), surface('b', ['y'])]));
+    assert.throws(() => assertDisjointTouches([surface('a', ['x']), surface('b', ['x'])]), /Steam target "x" is touched by both "a" and "b"/);
+});
+
+test('surface: installSurfaces skips disabled and unavailable surfaces and reports a throwing install without stopping the rest', () => {
+    const reported: string[] = [];
+    const order: string[] = [];
+    const status = installSurfaces(
+        [
+            surface('off', ['t1'], () => (order.push('off'), true)),
+            surface('missing', ['t2'], () => (order.push('missing'), false)),
+            surface('bad', ['t3'], () => {
+                order.push('bad');
+                throw new Error('nope');
+            }),
+            surface('ok', ['t4'], () => (order.push('ok'), true)),
+        ],
+        { isEnabled: (id) => id !== 'off', reportError: (id) => reported.push(id) },
+    );
+    assert.deepEqual(order, ['missing', 'bad', 'ok']);
+    assert.deepEqual(reported, ['bad']);
+    assert.deepEqual(status, [
+        { id: 'off', installed: false, skipped: 'disabled' },
+        { id: 'missing', installed: false, skipped: 'unavailable' },
+        { id: 'bad', installed: false, skipped: 'failed' },
+        { id: 'ok', installed: true, skipped: null },
+    ]);
+    let installed = false;
+    assert.throws(
+        () => installSurfaces([surface('a', ['x'], () => (installed = true)), surface('b', ['x'])], { isEnabled: () => true, reportError() {} }),
+        /touched by both/,
+    );
+    assert.equal(installed, false, 'a shared target throws before anything is installed');
+});
+
+test('notification: syntheticKind classifies preview, completion and test ids; real ids are null', () => {
+    assert.equal(syntheticKind(`${PREVIEW_ID_PREFIX}rare`), 'preview');
+    assert.equal(syntheticKind(`${PREVIEW_ID_PREFIX}anything`), 'preview');
+    assert.equal(syntheticKind(COMPLETION_ID), 'completion');
+    assert.equal(syntheticKind(TEST_UNLOCK_ID), 'test');
+    assert.equal(syntheticKind('ACH_WIN_ONE_GAME'), null);
+    assert.equal(syntheticKind(undefined), null);
+    assert.equal(achievementIdOf(unlocked('Q').n), 'Q');
+    assert.equal(achievementIdOf({ eType: 1, data: {} } as unknown as SteamNotification), undefined);
+    const throwing = { eType: 1, data: { achievement_id: () => { throw new Error('x'); } } } as unknown as SteamNotification;
+    assert.equal(achievementIdOf(throwing), undefined);
+});
diff --git a/enhanced-notifications/tests/queue.test.ts b/enhanced-notifications/tests/queue.test.ts
new file mode 100644
index 0000000..6d40602
--- /dev/null
+++ b/enhanced-notifications/tests/queue.test.ts
@@ -0,0 +1,171 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { admit, finish, forget, MAX_QUEUE, peek, phaseOf, resetQueue, subscribe, whenShowing } from '../frontend/banner/queue.ts';
+import { bannerTiming } from '../frontend/banner/timing.ts';
+
+const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
+const LONG = 60_000; // show timers that never fire inside a test
+
+test('the first toast shows immediately', () => {
+    resetQueue();
+    assert.equal(admit({}, LONG, true), 'showing');
+});
+
+test('queue on: a second toast waits while one is showing', () => {
+    resetQueue();
+    const a = {}, b = {};
+    assert.equal(admit(a, LONG, true), 'showing');
+    assert.equal(admit(b, LONG, true), 'waiting');
+});
+
+test('queue off: every toast shows immediately', () => {
+    resetQueue();
+    assert.equal(admit({}, LONG, false), 'showing');
+    assert.equal(admit({}, LONG, false), 'showing');
+});
+
+test('admit is idempotent: a remounted toast keeps its phase and place', () => {
+    resetQueue();
+    const a = {}, b = {};
+    admit(a, LONG, true);
+    admit(b, LONG, true);
+    assert.equal(admit(a, LONG, true), 'showing');
+    assert.equal(admit(b, LONG, true), 'waiting');
+});
+
+test('finishing the current toast promotes the next after the gap, and notifies it', async () => {
+    resetQueue();
+    const a = {}, b = {};
+    admit(a, LONG, true);
+    admit(b, LONG, true);
+    let notified = 0;
+    subscribe(b, () => notified++);
+    finish(a);
+    assert.equal(phaseOf(a), 'done');
+    assert.equal(phaseOf(b), 'waiting'); // gap not elapsed yet
+    await wait(150);
+    assert.equal(phaseOf(b), 'showing');
+    assert.equal(notified, 1);
+});
+
+test('a showing toast ends on its own timer, with no animation event needed', async () => {
+    resetQueue();
+    const a = {}, b = {};
+    admit(a, 30, true);
+    admit(b, LONG, true);
+    await wait(200);
+    assert.equal(phaseOf(a), 'done');
+    assert.equal(phaseOf(b), 'showing');
+});
+
+test('rapid bursts keep strict FIFO order, one showing at a time', async () => {
+    resetQueue();
+    const keys = [{}, {}, {}, {}];
+    for (const k of keys) admit(k, 20, true);
+    const order: number[] = [];
+    keys.forEach((k, i) => subscribe(k, () => phaseOf(k) === 'showing' && order.push(i)));
+    for (let t = 0; t < 40; t++) {
+        await wait(25);
+        assert.ok(keys.filter((k) => phaseOf(k) === 'showing').length <= 1, 'never two showing at once');
+    }
+    assert.deepEqual(order, [1, 2, 3]);
+    assert.ok(keys.every((k) => phaseOf(k) === 'done'));
+});
+
+test('a waiting toast that unmounts gives up its place without affecting the current one', async () => {
+    resetQueue();
+    const a = {}, b = {}, c = {};
+    admit(a, LONG, true);
+    admit(b, LONG, true);
+    admit(c, LONG, true);
+    forget(b);
+    assert.equal(phaseOf(a), 'showing');
+    finish(a);
+    await wait(150);
+    assert.equal(phaseOf(b), 'done');
+    assert.equal(phaseOf(c), 'showing');
+});
+
+test('a toast arriving during the gap waits for the gap, then shows', async () => {
+    resetQueue();
+    const a = {}, b = {};
+    admit(a, LONG, true);
+    finish(a);
+    assert.equal(admit(b, LONG, true), 'waiting');
+    await wait(150);
+    assert.equal(phaseOf(b), 'showing');
+});
+
+test(`past MAX_QUEUE (${MAX_QUEUE}) waiting, a new toast shows at once and reports overflow`, () => {
+    resetQueue();
+    admit({}, LONG, true);
+    for (let i = 0; i < MAX_QUEUE; i++) assert.equal(admit({}, LONG, true), 'waiting');
+    let overflow = false;
+    assert.equal(admit({}, LONG, true, () => (overflow = true)), 'showing');
+    assert.equal(overflow, true);
+});
+
+test('unknown keys read as done (nothing holds their popup)', () => {
+    assert.equal(phaseOf({}), 'done');
+});
+
+test('timing: exit starts after entrance + display, and the hold covers the whole exit', () => {
+    const t = bannerTiming({ in: 'ps5', out: 'ps5' }, 4000);
+    assert.equal(t.inMs, 450);
+    assert.equal(t.outMs, 400);
+    assert.ok(t.totalMs > t.inMs + t.displayMs + t.outMs);
+    const none = bannerTiming({ in: 'none', out: 'none' }, 3000);
+    assert.equal(none.inMs + none.outMs, 0);
+    assert.ok(none.totalMs >= 3000);
+});
+
+test.after(() => resetQueue());
+
+test('queue: peek is undefined for a toast never admitted', () => {
+    resetQueue();
+    const a = {};
+    assert.equal(peek(a), undefined);
+    assert.equal(phaseOf(a), 'done', 'phaseOf still calls an unknown toast done');
+    admit(a, LONG, true);
+    assert.equal(peek(a), 'showing');
+});
+
+test('queue: whenShowing fires once when a waiting toast gets its turn', async () => {
+    resetQueue();
+    const a = {}, b = {};
+    admit(a, LONG, true);
+    admit(b, LONG, true);
+    let fired = 0;
+    const r = whenShowing(b, () => fired++);
+    assert.equal(r.at, 'later');
+    finish(a);
+    await wait(250);
+    assert.equal(fired, 1);
+    finish(b);
+    await wait(150);
+    assert.equal(fired, 1, 'never again');
+});
+
+test('queue: whenShowing never fires for a toast finished before its turn', async () => {
+    resetQueue();
+    const a = {}, b = {};
+    admit(a, LONG, true);
+    admit(b, LONG, true);
+    let fired = 0;
+    whenShowing(b, () => fired++);
+    forget(b);
+    finish(a);
+    await wait(250);
+    assert.equal(fired, 0);
+    assert.deepEqual(whenShowing(b, () => fired++), { at: 'never' }, 'done');
+    assert.deepEqual(whenShowing({}, () => fired++), { at: 'never' }, 'unknown');
+});
+
+test('queue: whenShowing answers now for a toast already showing', () => {
+    resetQueue();
+    const a = {};
+    admit(a, LONG, true);
+    let fired = 0;
+    assert.deepEqual(whenShowing(a, () => fired++), { at: 'now' });
+    assert.equal(fired, 0, 'the caller acts on "now" itself');
+});
