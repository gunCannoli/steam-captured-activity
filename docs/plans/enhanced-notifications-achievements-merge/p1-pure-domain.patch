diff --git a/enhanced-notifications/frontend/banner/geometry.ts b/enhanced-notifications/frontend/banner/geometry.ts
new file mode 100644
index 0000000..b253a30
--- /dev/null
+++ b/enhanced-notifications/frontend/banner/geometry.ts
@@ -0,0 +1,68 @@
+import type { BannerStyle, Edges, Layout, ToastPosition } from '../theme/achievements';
+
+/**
+ * Banner window geometry. Pure: no Steam or SDK imports (tests/geometry.test.ts).
+ *
+ * All values are CSS px in the toast popup's `screen.avail*` space, the space
+ * Steam's own toast loop uses (verified live 2026-09-25, see
+ * docs/steam-components.md § Desktop toast stack).
+ */
+
+export const STACK_GAP_PX = 8;
+
+export interface Rect {
+    left: number;
+    top: number;
+    width: number;
+    height: number;
+}
+
+export interface BannerSize {
+    baseW: number;
+    baseH: number;
+    /** Window and box size: base × scale. */
+    width: number;
+    height: number;
+    /** Content height of the unscaled box; content is sized from this, never from `scale`. */
+    innerH: number;
+}
+
+export function bannerSize(layout: Layout, banner: BannerStyle): BannerSize {
+    const wide = layout === 'ps5' || layout === 'custom' || layout === 'default_system_right';
+    const baseW = banner.width ?? (wide ? 400 : 283);
+    const baseH = banner.height ?? (layout === 'compact_pill' ? 48 : 70);
+    return {
+        baseW,
+        baseH,
+        width: Math.round((baseW * banner.scale[0]) / 100),
+        height: Math.round((baseH * banner.scale[1]) / 100),
+        innerH: Math.max(0, baseH - banner.padding.top - banner.padding.bottom - 2 * banner.border.width),
+    };
+}
+
+function clamp(v: number, min: number, max: number): number {
+    return Math.max(min, Math.min(max, v));
+}
+
+/** `margin` pushes the banner inward from its anchor corner: only the sides it is anchored to count. */
+export function placeBanner(
+    position: ToastPosition,
+    margin: Edges,
+    size: { width: number; height: number },
+    avail: Rect,
+    slot = 0,
+): { x: number; y: number } {
+    const { width: w, height: h } = size;
+    const step = slot * (h + STACK_GAP_PX);
+
+    let x: number;
+    if (position.endsWith('_left')) x = avail.left + margin.left;
+    else if (position.endsWith('_right')) x = avail.left + avail.width - w - margin.right;
+    else x = avail.left + Math.round((avail.width - w) / 2);
+
+    let y = position.startsWith('top_') ? avail.top + margin.top + step : avail.top + avail.height - h - margin.bottom - step;
+
+    x = clamp(x, avail.left, avail.left + Math.max(0, avail.width - w));
+    y = clamp(y, avail.top, avail.top + Math.max(0, avail.height - h));
+    return { x: Math.round(x), y: Math.round(y) };
+}
diff --git a/enhanced-notifications/frontend/banner/queue.ts b/enhanced-notifications/frontend/banner/queue.ts
new file mode 100644
index 0000000..5125d25
--- /dev/null
+++ b/enhanced-notifications/frontend/banner/queue.ts
@@ -0,0 +1,173 @@
+/**
+ * The toast scheduler: decides when each themed banner is on screen, and for
+ * how long. The only owner of banner lifetime; themed-toast.tsx renders
+ * whatever phase this reports and never keeps its own "is it my turn" state.
+ *
+ * Every toast goes `waiting -> showing -> done` (or straight to `showing`).
+ * `showing` ends on our own timer (`showMs`, from banner/timing.ts), never on
+ * an animation event: a theme with `animation.out: "none"` fires no
+ * `animationend`, and a render-side signal cannot be trusted when React
+ * remounts the toast. With the queue on, one toast shows at a time and the
+ * next starts `QUEUE_GAP_MS` after the previous one is done.
+ *
+ * Identity is the notification's data object (WeakMap key), and every call is
+ * idempotent, because Steam may mount the same toast more than once.
+ *
+ * Pure: no Steam, SDK or `logger` import, so tests/queue.test.ts runs it under
+ * `npm test` (same constraint as theme/theme.ts and capture/plan.ts).
+ */
+
+export type Phase = 'waiting' | 'showing' | 'done';
+
+const QUEUE_GAP_MS = 100;
+/**
+ * Bounded: a waiting toast keeps its (invisible) Steam popup open, so an
+ * unbounded queue could hold popups for minutes. Past this many waiting, a
+ * new toast shows at once instead, never silently dropped.
+ */
+export const MAX_QUEUE = 5;
+
+interface Entry {
+    phase: Phase;
+    showMs: number;
+    timer?: ReturnType<typeof setTimeout>;
+    listeners: Set<() => void>;
+}
+
+const entries = new WeakMap<object, Entry>();
+let current: object | null = null;
+const waiting: object[] = [];
+/** Every toast not yet done (strong refs only until then), so a reset can cancel all timers. */
+const live = new Set<object>();
+let promoteTimer: ReturnType<typeof setTimeout> | undefined;
+
+function notify(entry: Entry): void {
+    for (const listener of [...entry.listeners]) {
+        try {
+            listener();
+        } catch {
+            /* a listener must not break the queue */
+        }
+    }
+}
+
+function start(key: object, entry: Entry): void {
+    entry.phase = 'showing';
+    entry.timer = setTimeout(() => finish(key), entry.showMs);
+    notify(entry);
+}
+
+function promote(): void {
+    promoteTimer = undefined;
+    while (current === null && waiting.length) {
+        const next = waiting.shift()!;
+        const entry = entries.get(next);
+        if (!entry || entry.phase !== 'waiting') continue;
+        current = next;
+        start(next, entry);
+    }
+}
+
+function schedulePromote(): void {
+    if (promoteTimer === undefined) promoteTimer = setTimeout(promote, QUEUE_GAP_MS);
+}
+
+/**
+ * Register a toast and return its phase. `queued` is the queue setting at the
+ * toast's arrival. A key seen before just returns its current phase.
+ * `onOverflow` is called when the queue is full and the toast shows at once.
+ */
+export function admit(key: object, showMs: number, queued: boolean, onOverflow?: () => void): Phase {
+    const known = entries.get(key);
+    if (known) return known.phase;
+
+    const entry: Entry = { phase: 'waiting', showMs, listeners: new Set() };
+    entries.set(key, entry);
+    live.add(key);
+
+    if (!queued) {
+        start(key, entry);
+    } else if (current === null && waiting.length === 0 && promoteTimer === undefined) {
+        current = key;
+        start(key, entry);
+    } else if (waiting.length >= MAX_QUEUE) {
+        onOverflow?.();
+        start(key, entry);
+    } else {
+        waiting.push(key);
+    }
+    return entry.phase;
+}
+
+/** Unknown keys are `done`: nothing of ours is holding them. */
+export function phaseOf(key: object): Phase {
+    return entries.get(key)?.phase ?? 'done';
+}
+
+/** The toast's phase, or undefined if it was never admitted (unlike `phaseOf`, which calls that `done`). */
+export function peek(key: object): Phase | undefined {
+    return entries.get(key)?.phase;
+}
+
+/**
+ * When does this toast's turn come? `now` if it is showing, `never` if it is done or was never admitted, else
+ * `onShow` runs once when it starts showing (never if it is finished first) and `cancel` withdraws the request.
+ */
+export function whenShowing(key: object, onShow: () => void): { at: 'now' | 'never' } | { at: 'later'; cancel(): void } {
+    const entry = entries.get(key);
+    if (!entry || entry.phase === 'done') return { at: 'never' };
+    if (entry.phase === 'showing') return { at: 'now' };
+    const listener = () => {
+        if (entry.phase === 'waiting') return;
+        entry.listeners.delete(listener);
+        if (entry.phase === 'showing') onShow();
+    };
+    entry.listeners.add(listener);
+    return { at: 'later', cancel: () => void entry.listeners.delete(listener) };
+}
+
+/** Called on every phase change of `key`. Returns an unsubscribe function. */
+export function subscribe(key: object, listener: () => void): () => void {
+    const entry = entries.get(key);
+    if (!entry) return () => {};
+    entry.listeners.add(listener);
+    return () => entry.listeners.delete(listener);
+}
+
+/** End `key` now (its timer ran out, it was dismissed, or it unmounted). Idempotent. */
+export function finish(key: object): void {
+    const entry = entries.get(key);
+    if (!entry || entry.phase === 'done') return;
+    clearTimeout(entry.timer);
+    const idx = waiting.indexOf(key);
+    if (idx >= 0) waiting.splice(idx, 1);
+    entry.phase = 'done';
+    live.delete(key);
+    notify(entry);
+    if (current === key) {
+        current = null;
+        schedulePromote();
+    }
+}
+
+/** The toast unmounted: finish it and drop its listeners. */
+export function forget(key: object): void {
+    finish(key);
+    entries.get(key)?.listeners.clear();
+}
+
+/** Test/dry-run only: drops all queue state (existing keys keep their last phase). */
+export function resetQueue(): void {
+    clearTimeout(promoteTimer);
+    promoteTimer = undefined;
+    for (const key of live) {
+        const entry = entries.get(key);
+        if (entry) {
+            clearTimeout(entry.timer);
+            entry.phase = 'done';
+        }
+    }
+    live.clear();
+    current = null;
+    waiting.length = 0;
+}
diff --git a/enhanced-notifications/frontend/banner/styles.ts b/enhanced-notifications/frontend/banner/styles.ts
new file mode 100644
index 0000000..5cf8ecd
--- /dev/null
+++ b/enhanced-notifications/frontend/banner/styles.ts
@@ -0,0 +1,239 @@
+/**
+ * Banner styles, injected with the banner itself so they travel into whichever
+ * toast window (desktop popup, Big Picture, overlay) the portal renders into.
+ *
+ * Everything is scoped under `.ea-banner`; nothing targets Steam's classes.
+ * The banner fills Steam's toast frame with responsive scaling and geometry
+ * controls (margin, padding, gap), outline glow with pulsing fade, and
+ * authentic PS5 blurry water-ripple effects.
+ */
+export const BANNER_CSS = `
+.ea-banner {
+    position: absolute;
+    inset: 0;
+    width: 100%;
+    height: 100%;
+    z-index: 1;
+    display: flex;
+    align-items: center;
+    gap: var(--ea-gap-x, 10px);
+    padding: var(--ea-pad, 6px 10px);
+    box-sizing: border-box;
+    overflow: hidden;
+    font-family: "Motiva Sans", -apple-system, BlinkMacSystemFont, Arial, sans-serif;
+    cursor: pointer;
+    user-select: none;
+}
+
+.ea-banner.ea-layout-compact_pill {
+    border-radius: 999px !important;
+    padding: 4px 16px 4px 4px;
+}
+
+/* Entrance and exit animations, independently settable (themes.md § animation).
+   Lengths are set inline from banner/timing.ts (--ea-in-ms, --ea-out-ms), the
+   same numbers the scheduler uses to decide when this toast is done; only the
+   keyframe names live here. The exit starts after the entrance plus the
+   theme's display time (--ea-display-ms), not Steam's --toast-duration: the
+   banner owns its lifetime and Steam holds the popup until it is done. */
+.ea-banner {
+    animation-name: var(--ea-in-name, none), var(--ea-out-name, none);
+    animation-duration: var(--ea-in-ms, 0ms), var(--ea-out-ms, 0ms);
+    animation-timing-function: var(--ea-in-ease, cubic-bezier(0.16, 1, 0.3, 1)), var(--ea-out-ease, ease-in);
+    animation-delay: 0ms, calc(var(--ea-in-ms, 0ms) + var(--ea-display-ms, 5000ms));
+    animation-fill-mode: both, forwards;
+}
+
+/* Queued: nothing painted, and Steam's own popup chrome (gradient box and
+   logo watermark, the popup div we are a direct child of) hidden too, so a
+   waiting popup is fully invisible. :has(> ...) matches only that parent. */
+.ea-banner.ea-waiting { visibility: hidden; animation: none; }
+:has(> .ea-banner.ea-waiting) { background: none !important; box-shadow: none !important; border-color: transparent !important; }
+:has(> .ea-banner.ea-waiting) > :not(.ea-banner) { display: none !important; }
+/* Done: stays invisible while Steam fades and closes the popup. Visibility,
+   not a class swap, so the finished exit animation is not restarted. */
+.ea-banner.ea-done { visibility: hidden; }
+
+/* --- entrance (ea-in-*) --- */
+.ea-in-fade  { --ea-in-name: ea-in-fade; }
+.ea-in-slide { --ea-in-name: ea-in-slide; }
+/* slide mirrors the anchor: left-anchored banners enter from the left edge. */
+.ea-in-slide.ea-pos-top_left, .ea-in-slide.ea-pos-bottom_left { --ea-in-name: ea-in-slide-left; }
+.ea-in-up    { --ea-in-name: ea-in-up; }
+.ea-in-down  { --ea-in-name: ea-in-down; }
+.ea-in-none  { --ea-in-name: none; }
+/* ps5: a short slide from the anchored screen edge with a fade you can see, direction from ea-pos-*.
+   The plain slide travels the banner's whole width, so its fade ends while the banner is still mostly
+   outside the toast window; ps5 travels a quarter of it, on a gentler curve, so the fade spans the motion. */
+.ea-in-ps5.ea-pos-top_right, .ea-in-ps5.ea-pos-bottom_right { --ea-in-name: ea-in-ps5-right; }
+.ea-in-ps5.ea-pos-top_left,  .ea-in-ps5.ea-pos-bottom_left  { --ea-in-name: ea-in-ps5-left; }
+.ea-in-ps5.ea-pos-top_center                                { --ea-in-name: ea-in-ps5-top; }
+.ea-in-ps5.ea-pos-bottom_center                             { --ea-in-name: ea-in-ps5-bottom; }
+.ea-in-ps5 { --ea-in-ease: cubic-bezier(0.25, 0.6, 0.3, 1); }
+
+/* --- exit (ea-out-*) --- */
+.ea-out-fade  { --ea-out-name: ea-out-fade; }
+.ea-out-slide { --ea-out-name: ea-out-slide; }
+.ea-out-slide.ea-pos-top_left, .ea-out-slide.ea-pos-bottom_left { --ea-out-name: ea-out-slide-left; }
+.ea-out-up    { --ea-out-name: ea-out-up; }
+.ea-out-down  { --ea-out-name: ea-out-down; }
+.ea-out-none  { --ea-out-name: none; }
+.ea-out-ps5.ea-pos-top_right, .ea-out-ps5.ea-pos-bottom_right { --ea-out-name: ea-out-ps5-right; }
+.ea-out-ps5.ea-pos-top_left,  .ea-out-ps5.ea-pos-bottom_left  { --ea-out-name: ea-out-ps5-left; }
+.ea-out-ps5.ea-pos-top_center                                 { --ea-out-name: ea-out-ps5-top; }
+.ea-out-ps5.ea-pos-bottom_center                              { --ea-out-name: ea-out-ps5-bottom; }
+.ea-out-ps5 { --ea-out-ease: ease-in-out; }
+
+@keyframes ea-in-fade  { from { opacity: 0; } to { opacity: 1; } }
+@keyframes ea-out-fade { from { opacity: 1; } to { opacity: 0; } }
+
+@keyframes ea-in-slide       { from { opacity: 0; transform: translateX(100%); }  to { opacity: 1; transform: translateX(0); } }
+@keyframes ea-in-slide-left  { from { opacity: 0; transform: translateX(-100%); } to { opacity: 1; transform: translateX(0); } }
+@keyframes ea-out-slide      { from { opacity: 1; transform: translateX(0); } to { opacity: 0; transform: translateX(100%); } }
+@keyframes ea-out-slide-left { from { opacity: 1; transform: translateX(0); } to { opacity: 0; transform: translateX(-100%); } }
+
+@keyframes ea-in-ps5-right   { from { opacity: 0; transform: translateX(25%); }  to { opacity: 1; transform: none; } }
+@keyframes ea-in-ps5-left    { from { opacity: 0; transform: translateX(-25%); } to { opacity: 1; transform: none; } }
+@keyframes ea-in-ps5-top     { from { opacity: 0; transform: translateY(-40%); } to { opacity: 1; transform: none; } }
+@keyframes ea-in-ps5-bottom  { from { opacity: 0; transform: translateY(40%); }  to { opacity: 1; transform: none; } }
+@keyframes ea-out-ps5-right  { from { opacity: 1; transform: none; } to { opacity: 0; transform: translateX(25%); } }
+@keyframes ea-out-ps5-left   { from { opacity: 1; transform: none; } to { opacity: 0; transform: translateX(-25%); } }
+@keyframes ea-out-ps5-top    { from { opacity: 1; transform: none; } to { opacity: 0; transform: translateY(-40%); } }
+@keyframes ea-out-ps5-bottom { from { opacity: 1; transform: none; } to { opacity: 0; transform: translateY(40%); } }
+
+@keyframes ea-in-up   { from { opacity: 0; transform: translateY(100%); }  to { opacity: 1; transform: translateY(0); } }
+@keyframes ea-out-up  { from { opacity: 1; transform: translateY(0); } to { opacity: 0; transform: translateY(100%); } }
+@keyframes ea-in-down  { from { opacity: 0; transform: translateY(-100%); } to { opacity: 1; transform: translateY(0); } }
+@keyframes ea-out-down { from { opacity: 1; transform: translateY(0); } to { opacity: 0; transform: translateY(-100%); } }
+
+/* Base Icon and Scaling */
+.ea-icon {
+    position: relative;
+    flex: none;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+}
+.ea-icon img, .ea-icon svg {
+    display: block;
+    width: 100%;
+    height: 100%;
+    object-fit: contain;
+}
+
+/* Water-ripple: starts as a ring just inside the icon's own outline and
+   expands a little past it (like an object breaking the surface of water),
+   not a pre-inflated blurred disc drifting further away. Fixed-size ring
+   (inset: 0, same box as the icon) rather than a percentage inset, so it
+   always starts at the icon's edge regardless of icon scale; it ends at 1.35x,
+   hugging the icon rather than drifting into the text beside it. */
+.ea-ripple {
+    position: absolute;
+    inset: 0;
+    border-radius: 50%;
+    border: calc(1.5px * var(--ea-icon-scale, 1)) solid rgba(255, 255, 255, 0.85);
+    filter: blur(calc(0.65px * var(--ea-icon-scale, 1)));
+    pointer-events: none;
+    transform: scale(0.92);
+    opacity: 0;
+    animation: ea-ripple var(--ea-ripple) cubic-bezier(0.1, 0.8, 0.3, 1) infinite;
+}
+@keyframes ea-ripple {
+    0%   { transform: scale(0.92); opacity: 0.9; }
+    15%  { opacity: 0.7; }
+    100% { transform: scale(1.2); opacity: 0; }
+}
+
+/* 3-Zone Flexbox Architecture */
+.ea-zone-left {
+    flex: none;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    height: 100%;
+}
+.ea-zone-left .ea-icon {
+    height: calc(min(56px, var(--ea-inner-h, 56px)) * var(--ea-icon-scale, 1));
+    aspect-ratio: 1;
+}
+.ea-zone-left img {
+    border-radius: 4px;
+}
+
+.ea-zone-center {
+    min-width: 0;
+    flex: 1;
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    gap: var(--ea-gap-y, 2px);
+    line-height: 1.2;
+    text-align: var(--ea-text-align, left);
+}
+
+.ea-row-title, .ea-row-desc {
+    display: flex;
+    align-items: center;
+    gap: var(--ea-gap-x, 6px);
+    min-width: 0;
+    justify-content: var(--ea-text-justify, flex-start);
+}
+
+.ea-anchored-icon {
+    height: 1.15em;
+    width: 1.15em;
+    aspect-ratio: 1;
+    flex: none;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+}
+
+.ea-title, .ea-desc {
+    overflow: hidden;
+    text-overflow: ellipsis;
+    text-align: var(--ea-text-align, left);
+}
+.ea-title {
+    white-space: nowrap;
+    font-size: var(--ea-title-size);
+    flex: 1;
+    min-width: 0;
+}
+.ea-desc {
+    font-size: var(--ea-desc-size);
+    display: -webkit-box;
+    -webkit-line-clamp: 2;
+    -webkit-box-orient: vertical;
+    width: 100%;
+}
+
+.ea-zone-right {
+    flex: none;
+    margin-left: auto;
+    display: flex;
+    align-items: center;
+    gap: var(--ea-gap-x, 6px);
+    height: 100%;
+}
+.ea-zone-right .ea-icon {
+    height: calc(min(34px, 0.6 * var(--ea-inner-h, 56px)) * var(--ea-icon-scale, 1));
+    aspect-ratio: 1;
+}
+.ea-zone-right .ea-system {
+    height: calc(min(34px, 0.48 * var(--ea-inner-h, 56px)) * var(--ea-icon-scale, 1));
+}
+.ea-zone-right .ea-system svg {
+    fill: currentColor;
+    color: #ffffff;
+}
+
+/* Classic fallback / compatibility classes */
+.ea-achievement { height: calc(min(56px, var(--ea-inner-h, 56px)) * var(--ea-icon-scale, 1)); aspect-ratio: 1; }
+.ea-achievement img { border-radius: 4px; }
+.ea-badges { display: flex; align-items: center; gap: 6px; margin-left: auto; height: 100%; }
+.ea-badges .ea-icon { height: calc(min(34px, 0.6 * var(--ea-inner-h, 56px)) * var(--ea-icon-scale, 1)); aspect-ratio: 1; }
+.ea-badges .ea-system { height: calc(min(34px, 0.48 * var(--ea-inner-h, 56px)) * var(--ea-icon-scale, 1)); }
+.ea-badges .ea-system svg { fill: currentColor; color: #ffffff; }
+.ea-text { min-width: 0; flex: 1; display: flex; flex-direction: column; justify-content: center; gap: var(--ea-gap-y, 2px); line-height: 1.2; text-align: var(--ea-text-align, left); }
+`;
