diff --git a/enhanced-notifications/tests/achievements-bigpicture.mjs b/enhanced-notifications/tests/achievements-bigpicture.mjs
new file mode 100644
index 0000000..bfd0c67
--- /dev/null
+++ b/enhanced-notifications/tests/achievements-bigpicture.mjs
@@ -0,0 +1,155 @@
+// Live Big Picture check of the achievement banner. Run with Big Picture open
+// (SteamClient.URL.ExecuteSteamURL('steam://open/bigpicture')) and a theme with an `achievements` block selected
+// (tests/run-live.mjs selects ps5). Fires Steam's test achievement and asserts the themed banner renders in Big
+// Picture's toast window. SCREENSHOT=out.png captures it. Then a download toast queued behind a second banner must
+// not restyle it while it shows (the Big Picture flicker). Run it with Big Picture in front: a hidden window does not
+// paint, so its animations never start.
+// Then Big Picture's one toast place follows the toast on screen (ADR-0050): with a temporary theme, an achievement
+// goes to the `achievements` block's corner, the next download to the theme's corner, and, with no `achievements`
+// block, an achievement to the theme's corner too.
+import { rmSync, writeFileSync } from 'node:fs';
+import { connect, resolvePluginName } from './cdp.mjs';
+
+const cdp = await connect();
+let failed = false;
+try {
+    await cdp.evaluate(`window.NotificationStore.TestAchievement(480).then(() => true)`);
+    await new Promise((r) => setTimeout(r, 1200));
+    const targets = await (await fetch('http://127.0.0.1:8080/json')).json();
+    const toast = targets.find((t) => /^notificationtoasts_uid/i.test(t.title));
+    if (!toast) throw new Error('No Big Picture toast window; is Big Picture open?');
+    const win = await connect(toast.title);
+    const result = JSON.parse(
+        await win.evaluate(`JSON.stringify((() => {
+            const b = document.querySelector('.ea-banner');
+            if (!b) return { found: false };
+            const r = b.getBoundingClientRect(), p = b.parentElement.getBoundingClientRect();
+            return { found: true, classes: b.className, banner: [Math.round(r.width), Math.round(r.height)], frame: [Math.round(p.width), Math.round(p.height)], focused: document.activeElement?.closest?.('.ea-banner') ? 'banner' : document.activeElement?.tagName };
+        })())`),
+    );
+    console.log(`${result.found ? 'PASS' : 'FAIL'}  themed banner in Big Picture toast  ${JSON.stringify(result)}`);
+    if (!result.found) failed = true;
+    if (result.found && result.focused === 'banner') {
+        console.log('FAIL  banner took focus (would steal controller focus)');
+        failed = true;
+    }
+    if (process.env.SCREENSHOT) await win.screenshot(process.env.SCREENSHOT);
+
+    // Big Picture times the toast itself (no popup hold there), so Steam's
+    // duration must cover the whole banner: the exit animation has to finish
+    // (opacity ~0) before Steam removes the banner, never be cut mid-way. The banner
+    // must also have been visible (opacity ~1) at some point: a banner stuck at
+    // opacity 0 (the first toast after Big Picture opens, when its toast window's
+    // animation clock had not started) would otherwise pass this check unseen.
+    if (result.found) {
+        let last = null;
+        let max = 0;
+        for (let t = 0; t < 30_000; t += 100) {
+            const s = await win.evaluate(`(() => { const b = document.querySelector('.ea-banner'); return b ? Number(getComputedStyle(b).opacity) : null; })()`);
+            if (s === null) break;
+            last = s;
+            if (s > max) max = s;
+            await new Promise((r) => setTimeout(r, 100));
+        }
+        const ok = last !== null && last < 0.1 && max > 0.9;
+        console.log(`${ok ? 'PASS' : 'FAIL'}  exit animation finished before Steam removed the banner  (last opacity ${last}, max opacity ${max})`);
+        if (!ok) failed = true;
+
+        // A queued toast must not restyle the banner on screen: until the banner is done, its animation stays the
+        // banner's and its window carries no notification type.
+        await cdp.evaluate(`window.NotificationStore.TestAchievement(480).then(() => true)`);
+        await new Promise((r) => setTimeout(r, 1500));
+        await cdp.evaluate(`(window.NotificationStore.TestDownloadComplete(435150), true)`);
+        const states = [];
+        for (let t = 0; t < 8_000; t += 50) {
+            const s = await win.evaluate(`(() => { const b = document.querySelector('.ea-banner:not(.ea-done)'); return b ? (document.body.getAttribute('data-en-type') ?? '-') + ' | ' + getComputedStyle(b).animationName : null; })()`);
+            if (s === null && states.length) break;
+            if (s !== null && states[states.length - 1] !== s) states.push(s);
+            await new Promise((r) => setTimeout(r, 50));
+        }
+        const kept = states.length === 1 && states[0].startsWith('- | ea-');
+        console.log(`${kept ? 'PASS' : 'FAIL'}  a queued toast does not restyle the banner on screen  ${JSON.stringify(states)}`);
+        if (!kept) failed = true;
+        await new Promise((r) => setTimeout(r, 7000)); // let the queued download finish
+    }
+    win.close();
+
+    await achievementPosition();
+} finally {
+    cdp.close();
+}
+process.exitCode = failed ? 1 : 0;
+
+/** Fire one toast; return the first place Steam sends Big Picture's toast view ([x, y] in the window, and its size), after the view is idle again. */
+async function placeOf(fire) {
+    return JSON.parse(
+        await cdp.evaluate(`(async () => {
+            const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+            const find = () => {
+                for (const p of g_PopupManager.GetPopups()) {
+                    const el = p.window?.document?.querySelector('.GamepadToastPlaceholder');
+                    if (!el) continue;
+                    const k = Object.keys(el).find((x) => x.startsWith('__reactFiber'));
+                    for (let f = el[k], d = 0; f && d < 4; f = f.return, d++)
+                        for (let h = f.memoizedState, i = 0; h && i < 16; h = h.next, i++) if (h.memoizedState?.GetBrowserView) return { win: p.window, ph: el, bv: h.memoizedState.GetBrowserView() };
+                }
+                return null;
+            };
+            const t = find();
+            if (!t) return 'null';
+            const busy = () => (NotificationStore.m_rgNotificationToasts?.length ?? 0) > 0 || t.win.getComputedStyle(t.ph).display !== 'none';
+            for (let i = 0; i < 60 && busy(); i++) await sleep(500);
+            let first = null;
+            const own = Object.prototype.hasOwnProperty.call(t.bv, 'SetBounds'), orig = t.bv.SetBounds;
+            t.bv.SetBounds = function (x, y, w, h) { if (w > 0 && !first) first = [Math.round(x), Math.round(y)]; return orig.apply(this, arguments); };
+            await (${fire});
+            for (let i = 0; i < 20 && !first; i++) await sleep(250);
+            if (own) t.bv.SetBounds = orig; else delete t.bv.SetBounds;
+            for (let i = 0; i < 60 && busy(); i++) await sleep(500);
+            return JSON.stringify({ at: first, w: t.win.innerWidth, h: t.win.innerHeight });
+        })()`),
+    );
+}
+
+async function achievementPosition() {
+    const PLUGIN = await resolvePluginName(cdp, 'EN_PLUGIN', 'enhanced-notifications');
+    const plugin = (expr) => cdp.evaluate(`window.PLUGIN_LIST['${PLUGIN}'].${expr}`);
+    const top = (p) => p.startsWith('top_');
+    const quadrant = (r, pos) => !!r?.at && (top(pos) ? r.at[1] < r.h / 2 : r.at[1] > r.h / 2) && (pos.endsWith('_left') ? r.at[0] < r.w / 2 : pos.endsWith('_right') ? r.at[0] > r.w / 2 : true);
+    const userDir = JSON.parse(await cdp.evaluate(`window.Millennium.callServerMethod('${PLUGIN}', 'ListThemes', { payload: '{}' })`)).userDir;
+    const themePos = 'top_left';
+    const bannerPos = 'bottom_right';
+    const banner = `${userDir}/en_bp_achievements.json`;
+    const plain = `${userDir}/en_bp_plain.json`;
+    writeFileSync(banner, JSON.stringify({ settings: { position: themePos }, popup: { margin: [20, 30] }, achievements: { settings: { position: bannerPos }, tiers: { normal: { banner: { margin: 10 } } } } }));
+    writeFileSync(plain, JSON.stringify({ settings: { position: themePos }, popup: { margin: [20, 30] } }));
+    const before = await plugin('activeTheme()?.name');
+    const select = async (name) => {
+        await plugin(`setSetting('theme', '${name}')`);
+        for (let i = 0; i < 40 && (await plugin('activeTheme()?.name')) !== name; i++) await new Promise((r) => setTimeout(r, 250));
+    };
+    try {
+        const achievement = `NotificationStore.TestAchievement(480)`;
+        const download = `(NotificationStore.TestDownloadComplete(435150), 0)`;
+
+        await select('en_bp_achievements');
+        const ach = await placeOf(achievement);
+        const okAch = quadrant(ach, bannerPos);
+        console.log(`${okAch ? 'PASS' : 'FAIL'}  an achievement goes to the achievements block's corner (${bannerPos})  ${JSON.stringify(ach)}`);
+        if (!okAch) failed = true;
+        const next = await placeOf(download);
+        const okNext = quadrant(next, themePos);
+        console.log(`${okNext ? 'PASS' : 'FAIL'}  the next download goes back to the theme's corner (${themePos})  ${JSON.stringify(next)}`);
+        if (!okNext) failed = true;
+
+        await select('en_bp_plain');
+        const same = await placeOf(achievement);
+        const okSame = quadrant(same, themePos);
+        console.log(`${okSame ? 'PASS' : 'FAIL'}  without an achievements block, an achievement goes to the theme's corner (${themePos})  ${JSON.stringify(same)}`);
+        if (!okSame) failed = true;
+    } finally {
+        await plugin(before ? `setSetting('theme', ${JSON.stringify(before)})` : 'resetSettings()');
+        rmSync(banner, { force: true });
+        rmSync(plain, { force: true });
+    }
+}
diff --git a/enhanced-notifications/tests/achievements-captures.mjs b/enhanced-notifications/tests/achievements-captures.mjs
new file mode 100644
index 0000000..55a856a
--- /dev/null
+++ b/enhanced-notifications/tests/achievements-captures.mjs
@@ -0,0 +1,88 @@
+// Live test: Phase 7 auto-captures, dry-run only. Creates nothing (no real
+// screenshot, clip or marker) — it only exercises the planning/scheduling path
+// with setCaptureDryRun(true), which logs the RPC it would have sent instead
+// of sending it. Restores every setting it touches.
+import { connect, resolvePluginName } from './cdp.mjs';
+
+const cdp = await connect();
+const PLUGIN = await resolvePluginName(cdp, 'EN_PLUGIN', 'enhanced-notifications');
+let failed = false;
+const check = (label, ok, detail = '') => {
+    console.log(`${ok ? 'PASS' : 'FAIL'}  ${label}${detail ? `  (${detail})` : ''}`);
+    if (!ok) failed = true;
+};
+const wait = (ms) => new Promise((r) => setTimeout(r, ms));
+const plugin = (expr) => cdp.evaluate(`window.PLUGIN_LIST['${PLUGIN}'].${expr}`);
+const stored = () => cdp.evaluate(`window.MILLENNIUM_API.ffi('core', 'PluginConfig_GetAll')('${PLUGIN}')`);
+
+// The user's own stored settings, restored exactly at the end (never wiped).
+const before_ = (await stored()) ?? {};
+try {
+    // 1. recordingDiagnostics() resolves the service and the live store.
+    const diag = JSON.parse(await plugin('recordingDiagnostics()').then((r) => JSON.stringify(r)));
+    check('recordingDiagnostics(): service resolved', diag.service === true, JSON.stringify(diag));
+    check('recordingDiagnostics(): g_GRS resolved', diag.grs === true, JSON.stringify(diag));
+
+    // 2. Enable every capture and turn on dry-run.
+    await plugin(`setSetting('screenshot.enabled', true)`);
+    await plugin(`setSetting('recording.enabled', true)`);
+    await plugin(`setSetting('recording.add_timeline_marker', true)`);
+    await wait(300);
+    await plugin('setCaptureDryRun(true)');
+
+    // 3. Fire Steam's own test achievement (no game running: appid 480, Spacewar).
+    const before = JSON.parse(await plugin('captureLog()').then((r) => JSON.stringify(r)));
+    await cdp.evaluate(`window.NotificationStore.TestAchievement(480).then(() => true)`);
+    await wait(1500);
+
+    // 4. Assert the newest log entry: no running timeline, no RPC (eresult) sent.
+    const after = JSON.parse(await plugin('captureLog()').then((r) => JSON.stringify(r)));
+    const entry = after[after.length - 1];
+    // The log is a ring buffer (20 entries): once full its length no longer grows, so a newer timestamp also counts.
+    const isNew = after.length > before.length || (entry?.at ?? 0) > (before[before.length - 1]?.at ?? 0);
+    check('captureLog(): new entry recorded', isNew, JSON.stringify(entry));
+    if (isNew) {
+        check('captureLog(): appid 480', entry.appid === 480, JSON.stringify(entry));
+        check("captureLog(): skipped no-running-timeline", entry.skipped?.[0]?.reason === 'no-running-timeline', JSON.stringify(entry.skipped));
+        check('captureLog(): no eresult on any action (nothing sent)', !entry.actions?.some((a) => 'eresult' in a), JSON.stringify(entry.actions));
+    }
+
+    // 5. previewTier() must never schedule a capture (suppressed).
+    const beforePreview = JSON.parse(await plugin('captureLog()').then((r) => JSON.stringify(r)));
+    await plugin(`previewTier('normal')`);
+    await wait(1500);
+    const afterPreview = JSON.parse(await plugin('captureLog()').then((r) => JSON.stringify(r)));
+    check('previewTier(): no new capture log entry (suppressed)', afterPreview.length === beforePreview.length, `${beforePreview.length} -> ${afterPreview.length}`);
+
+    // 6. Optional: with a real recorded game running, assert a real plan (still dry-run, no RPC).
+    if (process.env.RUNNING) {
+        const appid = await plugin('runningGameAppid()');
+        check('RUNNING: a game with a running timeline was found', typeof appid === 'number', String(appid));
+        if (typeof appid === 'number') {
+            const beforeRun = JSON.parse(await plugin('captureLog()').then((r) => JSON.stringify(r)));
+            await plugin(`fireTestUnlock(${appid}, 'Phase 7 dry-run test')`);
+            await wait(2500);
+            const afterRun = JSON.parse(await plugin('captureLog()').then((r) => JSON.stringify(r)));
+            const runEntry = afterRun[afterRun.length - 1];
+            const gotNew = afterRun.length > beforeRun.length;
+            check('RUNNING: new log entry for the real game', gotNew, JSON.stringify(runEntry));
+            if (gotNew) {
+                const kinds = (runEntry.actions ?? []).map((a) => a.kind);
+                check('RUNNING: planned screenshot and/or clip with a timeline_id', kinds.some((k) => k === 'screenshot' || k === 'clip') && runEntry.actions.every((a) => a.request?.timeline_id || a.request?.start?.timeline_id), JSON.stringify(runEntry.actions));
+                check('RUNNING: no RPC actually sent (dry-run)', !runEntry.actions.some((a) => 'eresult' in a), JSON.stringify(runEntry.actions));
+            }
+        }
+    } else {
+        console.log('SKIP  RUNNING=1 scenario (no game/recording set up for this run)');
+    }
+} finally {
+    // 7. Restore dry-run mode and exactly the settings stored before the test.
+    await plugin('setCaptureDryRun(false)');
+    await plugin('resetSettings()');
+    for (const [key, value] of Object.entries(before_)) await plugin(`setSetting(${JSON.stringify(key)}, ${JSON.stringify(value)})`);
+    const left = (await stored()) ?? {};
+    const sorted = (o) => JSON.stringify(Object.keys(o).sort().map((k) => [k, o[k]]));
+    check('settings restored to what was stored before the test', sorted(left) === sorted(before_), `${JSON.stringify(before_)} -> ${JSON.stringify(left)}`);
+    cdp.close();
+}
+process.exitCode = failed ? 1 : 0;
diff --git a/enhanced-notifications/tests/achievements-queue.mjs b/enhanced-notifications/tests/achievements-queue.mjs
new file mode 100644
index 0000000..fc17946
--- /dev/null
+++ b/enhanced-notifications/tests/achievements-queue.mjs
@@ -0,0 +1,159 @@
+// Live stress test for the achievement queue, against a running Steam (-dev) with
+// enhanced-notifications deployed.
+//
+//   node tests/achievements-queue.mjs            (THEME=<name> to pick the theme; default ps5)
+//
+// 1. A theme without an `achievements` block (steam_midnight): a preview achievement is no
+//    banner, and gets the notification style like every toast (data-en-type on its window).
+// 2. Queue on + a burst of previews clicked faster than a human can: every
+//    sample must show at most one visible banner, every visible banner pinned
+//    at the same spot and size, in the order fired, with the tier it was fired
+//    for, never Steam's fallback toast; all of them must eventually show; and
+//    their sounds (theme clip or Steam chime) spaced out with the banners,
+//    never stacked on arrival.
+// 3. Queue off: the same burst may overlap, but every banner still shows with
+//    its own tier (no tier swapped between rapid previews).
+//
+// Restores exactly the settings stored before it ran (it used to reset theme and
+// queue to their defaults, wiping the user's theme choice). Previews never capture.
+import { connect, resolvePluginName } from './cdp.mjs';
+
+const THEME = process.env.THEME ?? 'ps5';
+const BURST = ['magic', 'rare', 'normal', 'exceptional', 'magic'];
+
+const cdp = await connect();
+const name = await resolvePluginName(cdp, 'EN_PLUGIN', 'enhanced-notifications');
+const plugin = (expr) => cdp.evaluate(`window.PLUGIN_LIST[${JSON.stringify(name)}].${expr}`);
+const stored = () => cdp.evaluate(`window.MILLENNIUM_API.ffi('core', 'PluginConfig_GetAll')(${JSON.stringify(name)})`);
+const before_ = (await stored()) ?? {};
+const wait = (ms) => new Promise((r) => setTimeout(r, ms));
+let failed = false;
+const check = (label, ok, detail = '') => {
+    console.log(`${ok ? 'PASS' : 'FAIL'}  ${label}${detail ? `  (${detail})` : ''}`);
+    if (!ok) failed = true;
+};
+
+/** One sample of every achievement toast popup, read from SharedJSContext. */
+const sample = () =>
+    cdp.evaluate(`JSON.stringify([...g_PopupManager.GetPopups()]
+        .filter((p) => /^notificationtoasts_/.test(p.m_strName) && (p.window ?? p.m_popup) && !(p.window ?? p.m_popup).closed)
+        .map((p) => {
+            const w = p.window ?? p.m_popup, doc = w.document, b = doc.querySelector('.ea-banner');
+            const cls = b?.className ?? '';
+            return {
+                name: p.m_strName,
+                banner: !!b,
+                waiting: cls.includes('ea-waiting'),
+                done: cls.includes('ea-done'),
+                tier: cls.match(/ea-tier-(\\w+)/)?.[1] ?? null,
+                title: doc.querySelector('.ea-title')?.textContent ?? null,
+                opacity: b ? Number(w.getComputedStyle(b).opacity) : null,
+                enType: doc.body?.getAttribute('data-en-type') ?? null,
+                steamText: b ? '' : (doc.body?.innerText ?? '').trim().slice(0, 60),
+                x: w.screenX, y: w.screenY, w: w.outerWidth, h: w.outerHeight,
+            };
+        }))`).then(JSON.parse);
+
+async function waitForNoToasts(maxMs = 60_000) {
+    for (let t = 0; t < maxMs; t += 500) {
+        if ((await sample()).length === 0) return true;
+        await wait(500);
+    }
+    return false;
+}
+
+/** Fire the burst as fast as possible, then sample until every popup is gone. */
+async function burst() {
+    await Promise.all(BURST.map((tier) => plugin(`previewTier(${JSON.stringify(tier)})`)));
+    const samples = [];
+    for (let t = 0; t < 90_000; t += 150) {
+        const s = await sample();
+        samples.push(s);
+        if (t > 3000 && s.length === 0) break;
+        await wait(150);
+    }
+    return samples;
+}
+
+try {
+    check('no toast on screen before starting', await waitForNoToasts());
+
+    // --- 1. no achievements block -----------------------------------------------
+    await plugin(`setSetting('theme', 'steam_midnight')`);
+    for (let i = 0; i < 20 && (await plugin(`activeTheme()?.name`)) !== 'steam_midnight'; i++) await wait(250);
+    check('no achievements block: no banner theme', (await plugin(`achievementTheme()`)) === null);
+    await plugin(`previewTier('normal')`);
+    let stock = null;
+    for (let i = 0; i < 20 && !stock?.steamText; i++) {
+        await wait(250);
+        stock = (await sample())[0] ?? null;
+    }
+    check('no achievements block: toast shown', !!stock);
+    check('no achievements block: our banner not drawn', stock && !stock.banner);
+    check('no achievements block: the notification style', stock && stock.enType === 'Achievement', `data-en-type=${stock?.enType}`);
+    check('no achievements block: toast cleared', await waitForNoToasts());
+
+    // --- 2. queue on -------------------------------------------------------------
+    await plugin(`setSetting('theme', ${JSON.stringify(THEME)})`);
+    await plugin(`setSetting('queue.enabled', true)`);
+    for (let i = 0; i < 20 && (await plugin(`activeTheme()?.name`)) !== THEME; i++) await wait(250);
+    check(`theme "${THEME}" loaded`, (await plugin(`activeTheme()?.name`)) === THEME);
+
+    // Log every achievement sound: WebAudio clip starts and Steam chime decisions.
+    await cdp.evaluate(`(() => {
+        const log = (window.__eaQueueSounds = []);
+        const src = AudioBufferSourceNode.prototype;
+        window.__eaQueueStart ??= src.start;
+        src.start = function (...a) { log.push(Date.now()); return window.__eaQueueStart.apply(this, a); };
+        const proto = Object.getPrototypeOf(window.NotificationStore);
+        window.__eaQueueChoose ??= proto.ChooseSound;
+        // Steam's ProcessNotification also asks ChooseSound once on arrival without
+        // playing anything; only the PlayNotificationSound path is a real play.
+        proto.ChooseSound = function (cfg, n) {
+            const playing = (new Error().stack ?? '').includes('PlayNotificationSound');
+            if (playing && n?.data?.getClassName?.() === 'CClientNotificationAchievement') log.push(Date.now());
+            return window.__eaQueueChoose.call(this, cfg, n);
+        };
+        return true;
+    })()`);
+    const samples = await burst();
+    const sounds = JSON.parse(
+        await cdp.evaluate(`(() => {
+            AudioBufferSourceNode.prototype.start = window.__eaQueueStart;
+            Object.getPrototypeOf(window.NotificationStore).ChooseSound = window.__eaQueueChoose;
+            return JSON.stringify(window.__eaQueueSounds);
+        })()`),
+    );
+    const gaps = sounds.slice(1).map((t, i) => t - sounds[i]);
+    const visible = (s) => s.filter((p) => p.banner && !p.waiting && !p.done && p.opacity > 0.01);
+    const maxVisible = Math.max(...samples.map((s) => visible(s).length));
+    // A real fallback is Steam's own toast (it has text); an empty popup is one sampled
+    // before React rendered into it or after it unmounted, while Steam closes it.
+    const isFallback = (p) => !p.banner && p.steamText !== '';
+    const fallbacks = samples.flat().filter(isFallback);
+    const fallback = fallbacks.length;
+    const spots = new Set(samples.flatMap((s) => visible(s).map((p) => `${p.x},${p.y},${p.w}x${p.h}`)));
+    const shown = [];
+    for (const s of samples) for (const p of visible(s)) if (shown.at(-1)?.name !== p.name) shown.push(p);
+    check('queue on: never more than one banner visible', maxVisible <= 1, `max ${maxVisible}`);
+    check('queue on: never Steam fallback toast', fallback === 0, fallbacks.map((p) => p.steamText).join(' | '));
+    check('queue on: every visible banner at one spot/size', spots.size === 1, [...spots].join(' | '));
+    check('queue on: all burst toasts shown', shown.length === BURST.length, `${shown.length}/${BURST.length}`);
+    check('queue on: one sound per toast', sounds.length === BURST.length, `${sounds.length} sounds`);
+    check('queue on: sounds follow the banners, not stacked on arrival', gaps.every((g) => g > 1000), `gaps ${gaps.join(', ')} ms`);
+    check('queue on: tiers in firing order', JSON.stringify(shown.map((p) => p.tier)) === JSON.stringify(BURST), shown.map((p) => p.tier).join(','));
+
+    // --- 3. queue off ------------------------------------------------------------
+    await plugin(`setSetting('queue.enabled', false)`);
+    const offSamples = await burst();
+    const tiersSeen = new Map();
+    for (const p of offSamples.flat()) if (p.banner && p.tier) tiersSeen.set(p.name, p.tier);
+    const counts = (arr) => JSON.stringify([...arr].sort());
+    check('queue off: every toast themed with its own tier', counts(tiersSeen.values()) === counts(BURST), [...tiersSeen.values()].join(','));
+    check('queue off: never Steam fallback toast', !offSamples.flat().some(isFallback), offSamples.flat().filter(isFallback).map((p) => p.steamText).join(' | '));
+} finally {
+    await plugin('resetSettings()').catch(() => {});
+    for (const [key, value] of Object.entries(before_)) await plugin(`setSetting(${JSON.stringify(key)}, ${JSON.stringify(value)})`).catch(() => {});
+    cdp.close();
+}
+process.exit(failed ? 1 : 0);
diff --git a/enhanced-notifications/tests/achievements-reset.mjs b/enhanced-notifications/tests/achievements-reset.mjs
