+// Live test: Reset Achievements (non-destructive). It never clears a real achievement.
+//
+//   node tests/achievements-reset.mjs
+//
+// 1. The `reset` surface is installed and the API says it is available.
+// 2. candidates() lists games with unlocks, sorted, each with unlocked > 0.
+// 3. A no-op reset of Spacewar (480, nothing unlocked) sends no console command and reports 0 cleared.
+// 4. The settings panel renders the five rows (label, description, filter, dropdown, Reset) and Reset starts disabled.
+// 5. With the surface switched off (`disabledFeatures = reset`) the API is unavailable and reset() refuses; restored after.
+import { connect, resolvePluginName } from './cdp.mjs';
+
+const cdp = await connect();
+const PLUGIN = await resolvePluginName(cdp, 'EN_PLUGIN', 'enhanced-notifications');
+// `expr` sees the plugin's exports as bare names (surfaceStatus(), achievementReset, setSetting(...)).
+const plugin = (expr) => cdp.evaluate(`(() => { with (window.PLUGIN_LIST[${JSON.stringify(PLUGIN)}]) { return (${expr}); } })()`);
+const stored = () => cdp.evaluate(`window.MILLENNIUM_API.ffi('core', 'PluginConfig_GetAll')(${JSON.stringify(PLUGIN)})`);
+const wait = (ms) => new Promise((r) => setTimeout(r, ms));
+const snapshot = (await stored()) ?? {};
+let failed = false;
+const check = (label, ok, detail = '') => {
+    console.log(`${ok ? 'PASS' : 'FAIL'}  ${label}${detail ? `  (${detail})` : ''}`);
+    if (!ok) failed = true;
+};
+
+try {
+    const status = JSON.parse(await plugin('JSON.stringify(surfaceStatus())'));
+    check('reset surface installed', status.some((s) => s.id === 'reset' && s.installed && s.skipped === null), JSON.stringify(status.find((s) => s.id === 'reset')));
+    check('API available', (await plugin('achievementReset.available()')) === true);
+
+    const list = JSON.parse(await plugin('JSON.stringify(achievementReset.candidates())'));
+    const names = list.map((c) => c.name);
+    const sorted = [...names].sort((a, b) => a.localeCompare(b));
+    check('candidates have unlocks and are sorted by name', list.length > 0 && list.every((c) => c.unlocked > 0) && JSON.stringify(names) === JSON.stringify(sorted), `${list.length} games`);
+    // With steam-cartridges loaded, Steam's progress cache lists its games too (ADR-0045; non-Steam games have the `shortcut` kind).
+    const cartridges = await plugin("Object.keys(window.PLUGIN_LIST).some((n) => n.startsWith('steam-cartridges') && typeof window.PLUGIN_LIST[n].resetAchievements === 'function')");
+    check('non-Steam games with unlocks are listed when steam-cartridges is loaded', !cartridges || list.some((c) => c.kind === 'shortcut'), `${list.filter((c) => c.kind === 'shortcut').length} shortcuts`);
+
+    const wrapped = await cdp.evaluate(`(() => { window.__eaConsole = []; const c = SteamClient.Console; window.__eaExec = c.ExecCommand; c.ExecCommand = (x) => { window.__eaConsole.push(x); return window.__eaExec.call(c, x); }; return true; })()`);
+    const res = JSON.parse(await plugin("achievementReset.reset({ appid: 480, name: 'Spacewar', unlocked: 0, total: 0, kind: 'steam' }).then((r) => JSON.stringify(r))"));
+    const sent = JSON.parse(await cdp.evaluate('JSON.stringify(window.__eaConsole)'));
+    await cdp.evaluate('(() => { SteamClient.Console.ExecCommand = window.__eaExec; return true; })()');
+    check('no-op reset sends no console command and clears nothing', wrapped === true && res.ok === true && res.cleared === 0 && sent.length === 0, JSON.stringify({ res, sent }));
+
+    await cdp.evaluate(`(() => {
+        document.getElementById('ea-reset-mount')?.remove();
+        const d = document.createElement('div');
+        d.id = 'ea-reset-mount';
+        document.body.appendChild(d);
+        window.__eaResetRoot = window.SP_REACTDOM.createRoot(d);
+        window.__eaResetRoot.render(window.SP_REACT.createElement(window.PLUGIN_LIST[${JSON.stringify(PLUGIN)}].SettingsPanelView));
+        return true;
+    })()`);
+    await wait(1200);
+    const text = await cdp.evaluate("(() => { const t = document.getElementById('ea-reset-mount').innerText; return t.slice(t.indexOf('Reset Achievements')); })()");
+    const lines = text.split('\n').map((l) => l.trim()).filter(Boolean);
+    check('panel: label, description, filter, dropdown and Reset rows', JSON.stringify(lines) === JSON.stringify(['Reset Achievements', 'Select a game to reset the achievements count', 'GAMES FILTER', 'All games', 'Reset']), JSON.stringify(lines));
+    const resetDisabled = await cdp.evaluate("(() => { const b = [...document.querySelectorAll('#ea-reset-mount [class*=\"DialogButton\"]')].pop(); return b.disabled || /Disabled/.test(b.className); })()");
+    check('panel: Reset is disabled until a game is selected', resetDisabled === true);
+    await cdp.evaluate("(() => { window.__eaResetRoot.unmount(); document.getElementById('ea-reset-mount')?.remove(); return true; })()");
+
+    await plugin("setSetting('disabledFeatures', 'reset').then(() => true)");
+    await wait(300);
+    const off = JSON.parse(await plugin("(async () => JSON.stringify({ available: achievementReset.available(), res: await achievementReset.reset({ appid: 480, name: 'x', unlocked: 1, total: 1, kind: 'steam' }) }))()"));
+    check('switched off: unavailable and reset() refuses', off.available === false && off.res.ok === false, JSON.stringify(off));
+} finally {
+    // Put back exactly the stored settings from before this script ran.
+    await plugin('resetSettings()').catch(() => {});
+    for (const [key, value] of Object.entries(snapshot)) await plugin(`setSetting(${JSON.stringify(key)}, ${JSON.stringify(value)})`).catch(() => {});
+    cdp.close();
+}
+process.exitCode = failed ? 1 : 0;
diff --git a/enhanced-notifications/tests/achievements-safety.mjs b/enhanced-notifications/tests/achievements-safety.mjs
new file mode 100644
index 0000000..9fabc9f
--- /dev/null
+++ b/enhanced-notifications/tests/achievements-safety.mjs
@@ -0,0 +1,87 @@
+// Live test: the achievement banner's kill switch, against a running Steam (-dev)
+// with enhanced-notifications deployed. Restores exactly the settings stored before it ran.
+//
+//   node tests/achievements-safety.mjs            (THEME=<name> to pick the theme; default ps5)
+//
+// 1. A clean start: not in safe mode, nothing tripped, no errors counted.
+// 2. `disabledFeatures = banner`: the banner is off, sound stays on, and a preview
+//    achievement is no banner but the theme's notification style (data-en-type).
+// 3. Switch cleared: the preview is our themed banner again.
+import { connect, resolvePluginName } from './cdp.mjs';
+
+const THEME = process.env.THEME ?? 'ps5';
+const cdp = await connect();
+const PLUGIN = await resolvePluginName(cdp, 'EN_PLUGIN', 'enhanced-notifications');
+const plugin = (expr) => cdp.evaluate(`window.PLUGIN_LIST[${JSON.stringify(PLUGIN)}].${expr}`);
+const stored = () => cdp.evaluate(`window.MILLENNIUM_API.ffi('core', 'PluginConfig_GetAll')(${JSON.stringify(PLUGIN)})`);
+const wait = (ms) => new Promise((r) => setTimeout(r, ms));
+let failed = false;
+const check = (label, ok, detail = '') => {
+    console.log(`${ok ? 'PASS' : 'FAIL'}  ${label}${detail ? `  (${detail})` : ''}`);
+    if (!ok) failed = true;
+};
+
+/** Every achievement toast popup: does it hold our banner, and which tier? */
+const sample = () =>
+    cdp.evaluate(`JSON.stringify([...g_PopupManager.GetPopups()]
+        .filter((p) => /^notificationtoasts_/.test(p.m_strName) && (p.window ?? p.m_popup) && !(p.window ?? p.m_popup).closed)
+        .map((p) => {
+            const doc = (p.window ?? p.m_popup).document, b = doc.querySelector('.ea-banner');
+            return { banner: !!b, tier: b?.className.match(/ea-tier-(\\w+)/)?.[1] ?? null, enType: doc.body?.getAttribute('data-en-type') ?? null, text: (doc.body?.innerText ?? '').trim().slice(0, 60) };
+        }))`).then(JSON.parse);
+
+async function waitForNoToasts(maxMs = 60_000) {
+    for (let t = 0; t < maxMs; t += 500) {
+        if ((await sample()).length === 0) return true;
+        await wait(500);
+    }
+    return false;
+}
+
+/** Fire one preview and return the first popup that has rendered content. */
+async function previewOnce(tier) {
+    await plugin(`previewTier(${JSON.stringify(tier)})`);
+    for (let i = 0; i < 20; i++) {
+        await wait(250);
+        const hit = (await sample()).find((p) => p.banner || p.text !== '');
+        if (hit) return hit;
+    }
+    return null;
+}
+
+const before_ = (await stored()) ?? {};
+try {
+    const diag = await plugin('safetyDiagnostics()');
+    check('clean start: not in safe mode', diag?.safeMode === false, JSON.stringify(diag));
+    check('clean start: nothing tripped, no errors', diag?.tripped?.length === 0 && Object.keys(diag?.errors ?? {}).length === 0, JSON.stringify(diag));
+
+    check('no toast on screen before starting', await waitForNoToasts());
+    await plugin(`setSetting('theme', ${JSON.stringify(THEME)})`);
+    for (let i = 0; i < 20 && (await plugin('activeTheme()?.name')) !== THEME; i++) await wait(250);
+    check(`theme "${THEME}" loaded`, (await plugin('activeTheme()?.name')) === THEME);
+
+    await plugin(`setSetting('disabledFeatures', 'banner')`);
+    const switched = await plugin('safetyDiagnostics()');
+    check('banner off: the switch reads off', switched?.disabled?.includes('banner') === true, JSON.stringify(switched));
+    check('banner off: sound stays on', switched?.disabled?.includes('sound') === false, JSON.stringify(switched));
+    const stock = await previewOnce('rare');
+    check('banner off: the preview is the notification style, not the banner', !!stock && !stock.banner && stock.enType === 'Achievement', JSON.stringify(stock));
+    check('banner off: toast cleared', await waitForNoToasts());
+
+    await plugin(`setSetting('disabledFeatures', '')`);
+    check('banner on again: the switch reads on', (await plugin('safetyDiagnostics()'))?.disabled?.includes('banner') === false);
+    const themed = await previewOnce('rare');
+    check('banner on again: preview is our banner with its tier', !!themed && themed.banner && themed.tier === 'rare', JSON.stringify(themed));
+    check('banner on again: toast cleared', await waitForNoToasts());
+
+    const after = await plugin('safetyDiagnostics()');
+    check('no errors counted during the test', Object.keys(after?.errors ?? {}).length === 0, JSON.stringify(after));
+} finally {
+    await plugin('resetSettings()');
+    for (const [key, value] of Object.entries(before_)) await plugin(`setSetting(${JSON.stringify(key)}, ${JSON.stringify(value)})`);
+    const left = (await stored()) ?? {};
+    const sorted = (o) => JSON.stringify(Object.keys(o).sort().map((k) => [k, o[k]]));
+    check('settings restored to what was stored before the test', sorted(left) === sorted(before_), `${JSON.stringify(before_)} -> ${JSON.stringify(left)}`);
+    cdp.close();
+}
+process.exitCode = failed ? 1 : 0;
diff --git a/enhanced-notifications/tests/achievements-settings.mjs b/enhanced-notifications/tests/achievements-settings.mjs
new file mode 100644
index 0000000..db7a3e1
--- /dev/null
+++ b/enhanced-notifications/tests/achievements-settings.mjs
@@ -0,0 +1,156 @@
+// Live test: the achievement banner's sound replacement and display time, and settings round-trips through
+// Millennium's Configuration API (the same store the settings panel writes). Needs a theme whose `achievements`
+// block has tier sounds (SOUND_THEME, default ps5: the user's own ps5 theme, which wins over the bundled one); SKIP
+// without one.
+// Leaves every setting as it found it: it snapshots the stored settings first and puts them back in `finally`
+// (the check near the end resets them to prove defaults, so it would otherwise wipe the user's), EA-K6.
+import { connect, resolvePluginName } from './cdp.mjs';
+import { bannerTiming } from '../frontend/banner/timing.ts';
+
+const cdp = await connect();
+const PLUGIN = await resolvePluginName(cdp, 'EN_PLUGIN', 'enhanced-notifications');
+const SOUND_THEME = process.env.SOUND_THEME ?? 'ps5';
+let failed = false;
+const check = (label, ok, detail = '') => {
+    console.log(`${ok ? 'PASS' : 'FAIL'}  ${label}${detail ? `  (${detail})` : ''}`);
+    if (!ok) failed = true;
+};
+const wait = (ms) => new Promise((r) => setTimeout(r, ms));
+class Skip extends Error {}
+// Drive settings through the plugin's own exports (what the settings panel calls).
+const plugin = (expr) => cdp.evaluate(`window.PLUGIN_LIST['${PLUGIN}'].${expr}`);
+const stored = () => cdp.evaluate(`window.MILLENNIUM_API.ffi('core', 'PluginConfig_GetAll')('${PLUGIN}')`);
+const before = (await stored()) ?? {};
+
+// Record sounds: WebAudio buffers started in SharedJSContext (ours), and every
+// PlayNavSound request (Steam's own chime; it dispatches to a native player, so
+// the request itself is the reliable signal).
+const instrumented = await cdp.evaluate(`(() => {
+    // Idempotent: always wrap the saved originals, so re-running never stacks wrappers.
+    window.__eaSounds = [];
+    const proto = AudioBufferSourceNode.prototype;
+    window.__eaOrigStart ??= proto.start;
+    const start = window.__eaOrigStart;
+    proto.start = function (...a) {
+        window.__eaSounds.push({ kind: 'webaudio', seconds: +(this.buffer?.duration ?? 0).toFixed(2) });
+        return start.apply(this, a);
+    };
+    let req;
+    const key = '__ea_probe_' + Date.now();
+    window.webpackChunksteamui.push([[key], { [key]: (m, e, r) => (req = r) }, (r) => r(key)]);
+    for (const id of Object.keys(req.m)) {
+        if (!req.m[id].toString().includes('m_fnCallbackOnPlaySound')) continue;
+        for (const v of Object.values(req(id))) {
+            if (v && typeof v.PlayNavSound === 'function' && v.m_fnCallbackOnPlaySound) {
+                v.__eaOrigPlayNavSound ??= v.PlayNavSound;
+                const orig = v.__eaOrigPlayNavSound;
+                v.PlayNavSound = function (...a) { window.__eaSounds.push({ kind: 'steam', id: a[0] }); return orig.apply(this, a); };
+                window.__eaRestoreNav = () => { v.PlayNavSound = orig; };
+                return 'ok';
+            }
+        }
+    }
+    return 'PlayNavSound not found';
+})()`);
+if (instrumented !== 'ok') throw new Error(`Sound instrumentation failed: ${instrumented}`);
+
+async function fire() {
+    await cdp.evaluate(`(async () => { window.__eaSounds.length = 0; await window.NotificationStore.TestAchievement(480); return true; })()`);
+    await wait(1500);
+    const sounds = JSON.parse(await cdp.evaluate(`JSON.stringify(window.__eaSounds)`));
+    const targets = await (await fetch('http://127.0.0.1:8080/json')).json();
+    const toast = targets.find((t) => /notificationtoasts/i.test(t.title));
+    let banner = null;
+    if (toast) {
+        const win = await connect(toast.title);
+        banner = await win.evaluate(`document.querySelector('.ea-banner')?.className ?? null`);
+        win.close();
+    }
+    await wait(5500);
+    return { sounds, banner };
+}
+
+try {
+    // The bundled themes ship with no sound (no local paths in the bundle). Sound-dependent checks need a theme that
+    // has tier sounds: the user's own (SOUND_THEME). Point the plugin at it for the duration of this test.
+    await plugin(`setSetting('theme', ${JSON.stringify(SOUND_THEME)})`);
+    let soundTheme = false;
+    for (let i = 0; i < 10 && !soundTheme; i++) {
+        await wait(300);
+        soundTheme = await cdp.evaluate(`(() => {
+            const t = window.PLUGIN_LIST['${PLUGIN}'].achievementTheme();
+            return t?.name === ${JSON.stringify(SOUND_THEME)} && t.sounds.size > 0;
+        })()`);
+    }
+    if (!soundTheme) throw new Skip(`theme '${SOUND_THEME}' with achievement tier sounds is not installed on this machine`);
+
+    const duration = await cdp.evaluate(`(() => {
+        const proto = Object.getPrototypeOf(window.NotificationStore);
+        let cfg, found;
+        for (let t = 0; t < 256 && !found; t++) {
+            proto.PlayNotificationSound.call({ ChooseSound(c) { cfg = c; return null; } }, { eType: t });
+            try { if (cfg?.proto && new cfg.proto().getClassName() === 'CClientNotificationAchievement') found = cfg; } catch {}
+        }
+        return found?.toastDurationMS;
+    })()`);
+    // The plugin writes the banner's whole lifetime (entrance + display + exit + settle,
+    // banner/timing.ts), not the bare display time, so Steam keeps the popup open through the fades.
+    const themed = JSON.parse(await cdp.evaluate(`JSON.stringify((() => { const t = window.PLUGIN_LIST['${PLUGIN}'].achievementTheme()?.theme; return { animation: t?.animation, displayTimeMs: t?.displayTimeMs }; })())`));
+    const expected = bannerTiming(themed.animation, themed.displayTimeMs).totalMs;
+    check('display_time_ms applied to Steam achievement toast config', themed.displayTimeMs === 4000 && duration === expected, `toastDurationMS=${duration}, expected ${expected}`);
+
+    // First toast may find the AudioContext suspended (then Steam's chime plays once); warm it up.
+    await fire();
+    let r = await fire();
+    const ours = r.sounds.filter((s) => s.kind === 'webaudio');
+    const steam = r.sounds.filter((s) => s.kind === 'steam');
+    check('themed sound played', ours.length === 1, JSON.stringify(r.sounds));
+    check("Steam's chime suppressed", steam.length === 0);
+
+    // A tier with no sound gets the notification sound; steam_tiers has neither, so Steam's chime,
+    // while the banner is themed whenever the theme has an `achievements` block.
+    await plugin(`setSetting('theme', 'steam_tiers')`);
+    await wait(500);
+    r = await fire();
+    check('theme with no sound -> Steam chime plays', r.sounds.some((s) => s.kind === 'steam'));
+    check('theme with no sound -> no themed sound', !r.sounds.some((s) => s.kind === 'webaudio'), JSON.stringify(r.sounds));
+    check('theme with no sound -> banner still themed', !!r.banner);
+    await plugin(`setSetting('theme', ${JSON.stringify(SOUND_THEME)})`);
+    await wait(500);
+    await plugin(`setSetting('theme', 'does_not_exist')`);
+    await wait(1000);
+    r = await fire();
+    check('missing theme -> stock toast', r.banner === null);
+    check('missing theme -> Steam chime', r.sounds.some((s) => s.kind === 'steam') && !r.sounds.some((s) => s.kind === 'webaudio'), JSON.stringify(r.sounds));
+
+    // A theme without an `achievements` block: no banner, the notification style and its sound (none: Steam's chime).
+    await plugin(`setSetting('theme', 'steam_midnight')`);
+    await wait(500);
+    r = await fire();
+    check('no achievements block -> no banner', r.banner === null);
+    check('no achievements block -> Steam chime', r.sounds.some((s) => s.kind === 'steam') && !r.sounds.some((s) => s.kind === 'webaudio'), JSON.stringify(r.sounds));
+
+    await plugin(`resetSettings()`);
+    await wait(1500);
+
+    r = await fire();
+    // The shipped default theme is steam_midnight (settings.json): no banner, no themed sound.
+    check('defaults restored -> steam_midnight (no banner, no themed sound)', r.banner === null && !r.sounds.some((s) => s.kind === 'webaudio'));
+    const left = await stored();
+    check('setting a default / reset leaves nothing stored', left && Object.keys(left).length === 0, JSON.stringify(left));
+} catch (e) {
+    if (!(e instanceof Skip)) throw e;
+    console.log(`SKIP  ${e.message}`);
+    await plugin(`resetSettings()`);
+} finally {
+    await plugin(`resetSettings()`).catch(() => {});
+    for (const [key, value] of Object.entries(before)) await plugin(`setSetting(${JSON.stringify(key)}, ${JSON.stringify(value)})`).catch(() => {});
+    // Put back what the instrumentation wrapped, so a script run after this one sees the real functions.
+    await cdp.evaluate(`(() => {
+        if (window.__eaOrigStart) AudioBufferSourceNode.prototype.start = window.__eaOrigStart;
+        window.__eaRestoreNav?.();
+        return true;
+    })()`).catch(() => {});
+    cdp.close();
+}
+process.exitCode = failed ? 1 : 0;
diff --git a/enhanced-notifications/tests/achievements-smoke.mjs b/enhanced-notifications/tests/achievements-smoke.mjs
new file mode 100644
index 0000000..7811550
--- /dev/null
+++ b/enhanced-notifications/tests/achievements-smoke.mjs
@@ -0,0 +1,59 @@
+// Live smoke test of the achievement banner, against a running Steam (-dev) with enhanced-notifications-dev deployed
+// and a theme with an `achievements` block selected (tests/run-live.mjs selects ps5).
+// Usage: node tests/achievements-smoke.mjs      (SCREENSHOT=out.png to also capture the toast window)
+//   Checks the hooks are installed, fires Steam's test achievement, and asserts
+//   the themed banner rendered in the toast window. Exit code 1 on failure.
+import { connect } from './cdp.mjs';
+
+const cdp = await connect();
+let failed = false;
+const check = (label, ok, detail = '') => {
+    console.log(`${ok ? 'PASS' : 'FAIL'}  ${label}${detail ? `  (${detail})` : ''}`);
+    if (!ok) failed = true;
+};
+
+try {
+    const state = JSON.parse(
+        await cdp.evaluate(`JSON.stringify((() => {
+            const proto = Object.getPrototypeOf(window.NotificationStore);
+            return { soundHooked: !proto.PlayNotificationSound.toString().includes('PlayNavSound') };
+        })())`),
+    );
+    check('sound hook installed on NotificationStore.prototype', state.soundHooked);
+
+    // Steam's own test toast (global_achieved_pct 10). The plugin themes it like a real unlock.
+    await cdp.evaluate(`window.NotificationStore.TestAchievement(480).then(() => true)`);
+    // The first toast after a Steam start also has to create its popup window.
+    let toast;
+    for (let i = 0; i < 12 && !toast; i++) {
+        await new Promise((r) => setTimeout(r, 500));
+        const targets = await (await fetch('http://127.0.0.1:8080/json')).json();
+        toast = targets.find((t) => /notificationtoasts/i.test(t.title));
+    }
+    await new Promise((r) => setTimeout(r, 500));
+    check('toast window opened', !!toast, toast?.title);
+    if (toast) {
+        const win = await connect(toast.title);
+        const banner = JSON.parse(
+            await win.evaluate(`JSON.stringify((() => {
+                const b = document.querySelector('.ea-banner');
+                if (!b) return { found: false, html: document.body.innerHTML.slice(0, 400) };
+                const r = b.getBoundingClientRect();
+                return {
+                    found: true,
+                    classes: b.className,
+                    size: [Math.round(r.width), Math.round(r.height)],
+                    title: b.querySelector('.ea-title')?.textContent,
+                    icons: [...b.querySelectorAll('.ea-icon')].map((i) => i.className.replace('ea-icon ', '')),
+                    background: getComputedStyle(b).backgroundImage.slice(0, 80),
+                };
+            })())`),
+        );
+        check('themed banner rendered', banner.found, banner.found ? JSON.stringify(banner) : banner.html);
+        if (process.env.SCREENSHOT) console.log('screenshot:', await win.screenshot(process.env.SCREENSHOT));
+        win.close();
+    }
+} finally {
+    cdp.close();
+}
+process.exitCode = failed ? 1 : 0;
diff --git a/enhanced-notifications/tests/achievements-tiers.mjs b/enhanced-notifications/tests/achievements-tiers.mjs
new file mode 100644
index 0000000..29ba037
--- /dev/null
+++ b/enhanced-notifications/tests/achievements-tiers.mjs
@@ -0,0 +1,118 @@
+// Live tier test: dispatches real achievement notifications through Steam's
+// NotificationStore.OnNotification with chosen rarity, and checks which tier
+// the themed banner used (a theme with an `achievements` block must be selected;
+// tests/run-live.mjs selects ps5). Screenshots go to $SHOTS_DIR when set.
+//
+// The protobuf class and eType are found the same way the plugin finds them
+// (stand-in call to PlayNotificationSound), not hardcoded.
+//
+// A game-completing unlock keeps its own rarity tier; the plugin then posts a
+// separate synthetic 100% toast (tier exceptional) ~1.5 s later (the design
+// since fe25714), so that case checks both toasts.
+import { connect } from './cdp.mjs';
+
+const cases = [
+    { label: 'normal (50%)', pct: 50, expect: 'normal' },
+    { label: 'magic (20%)', pct: 20, expect: 'magic' },
+    { label: 'rare (5%)', pct: 5, expect: 'rare' },
+    { label: 'no rarity data (0%)', pct: 0, expect: 'normal' },
+    { label: 'completes game (50%)', pct: 50, expect: 'normal', completes: true, then: 'exceptional' },
+];
+
+const cdp = await connect();
+let failed = false;
+
+/** Tiers of every themed banner currently in a toast window. */
+async function allBannerTiers() {
+    const targets = (await (await fetch('http://127.0.0.1:8080/json')).json()).filter((t) => /notificationtoasts/i.test(t.title));
+    const tiers = [];
+    for (const t of targets) {
+        const win = await connect(t.title);
+        try {
+            const cls = await win.evaluate(`document.querySelector('.ea-banner')?.className ?? null`);
+            const tier = cls?.match(/ea-tier-(\w+)/)?.[1];
+            if (tier) tiers.push(tier);
+        } finally {
+            win.close();
+        }
+    }
+    return tiers;
+}
+
+async function bannerTier() {
+    const targets = await (await fetch('http://127.0.0.1:8080/json')).json();
+    const toast = targets.find((t) => /notificationtoasts/i.test(t.title));
+    if (!toast) return { tier: null };
+    const win = await connect(toast.title);
+    try {
+        const cls = await win.evaluate(`document.querySelector('.ea-banner')?.className ?? null`);
+        return { tier: cls?.match(/ea-tier-(\w+)/)?.[1] ?? null, win };
+    } catch (error) {
+        win.close();
+        throw error;
+    }
+}
+
+/** Each case must start on a clean screen, or bannerTier() could read a toast still closing. */
+async function waitForNoToasts(maxMs = 30_000) {
+    for (let t = 0; t < maxMs; t += 500) {
+        const targets = await (await fetch('http://127.0.0.1:8080/json')).json();
+        if (!targets.some((x) => /notificationtoasts/i.test(x.title))) return true;
+        await new Promise((r) => setTimeout(r, 500));
+    }
+    return false;
+}
+
+try {
+    for (const [i, c] of cases.entries()) {
+        if (!(await waitForNoToasts())) {
+            failed = true;
+            console.log(`FAIL  ${c.label}: a previous toast never cleared`);
+            continue;
+        }
+        // A fresh, never-seen appid so tier memos and caches cannot leak between cases.
+        const appid = 900000 + i;
+        await cdp.evaluate(`(() => {
+            const ns = window.NotificationStore, proto = Object.getPrototypeOf(ns);
+            let cfg, type;
+            for (let t = 0; t < 256 && type === undefined; t++) {
+                proto.PlayNotificationSound.call({ ChooseSound(c) { cfg = c; return null; } }, { eType: t });
+                try { if (cfg?.proto && new cfg.proto().getClassName() === 'CClientNotificationAchievement') type = t; } catch {}
+                cfg = type === undefined ? undefined : cfg;
+            }
+            const cache = window.appAchievementProgressCache.m_achievementProgress.mapCache;
+            ${c.completes ? `cache.set(${appid}, { appid: ${appid}, unlocked: 9, total: 10, percentage: 90, all_unlocked: false });` : ''}
+            const msg = cfg.proto.fromObject({
+                achievement_id: 'EA_TEST', appid: ${appid}, name: ${JSON.stringify(c.label)},
+                description: 'enhanced-notifications live tier test', image_url: '',
+                achieved: true, rtime_unlocked: Math.floor(Date.now() / 1000),
+                current_progress: 0, max_progress: 0, min_progress: 0, global_achieved_pct: ${c.pct},
+            });
+            ns.OnNotification(ns.m_nNextTestNotificationID++, type, msg.serializeBinary());
+            return true;
+        })()`);
+        await new Promise((r) => setTimeout(r, 1500));
+        const { tier, win } = await bannerTier();
+        const ok = tier === c.expect;
+        if (!ok) failed = true;
+        console.log(`${ok ? 'PASS' : 'FAIL'}  ${c.label}: banner tier = ${tier}, expected ${c.expect}`);
+        if (win && process.env.SHOTS_DIR) await win.screenshot(`${process.env.SHOTS_DIR}/tier-${c.expect}-${c.pct}.png`);
+        win?.close();
+        if (c.then) {
+            let seen = [];
+            for (let t = 0; t < 12 && !seen.includes(c.then); t++) {
+                await new Promise((r) => setTimeout(r, 500));
+                seen = await allBannerTiers();
+            }
+            const okThen = seen.includes(c.then);
+            if (!okThen) failed = true;
+            console.log(`${okThen ? 'PASS' : 'FAIL'}  ${c.label}: then a ${c.then} toast (seen: ${seen.join(',') || 'none'})`);
+        }
+        if (c.completes) await cdp.evaluate(`(window.appAchievementProgressCache.m_achievementProgress.mapCache.delete(${appid}), true)`);
+        // Let the toast expire before the next one (display_time_ms + fade).
+        await new Promise((r) => setTimeout(r, 6000));
+    }
+} finally {
+    cdp.close();
+}
+process.exitCode = failed ? 1 : 0;
