diff --git a/enhanced-achievements/frontend/safety/boot.ts b/enhanced-achievements/frontend/safety/boot.ts
new file mode 100644
index 0000000..07c916b
--- /dev/null
+++ b/enhanced-achievements/frontend/safety/boot.ts
@@ -0,0 +1,71 @@
+/**
+ * Boot sentinel (docs/plans/enhanced-achievements-architecture-migration-plan.md § E0a).
+ * Same design as steam-cartridges/frontend/safety/boot.ts, with this plugin's key.
+ *
+ * A hung SharedJSContext cannot run any cleanup, so the sentinel works the other way
+ * round: every start marks the boot "pending"; a clean shutdown (pagehide) or 60 s of
+ * error-free running clears it. If a start finds the previous boot still pending, that
+ * boot ended badly. After two bad boots in a row, the plugin starts in safe mode
+ * (Steam's own toasts, nothing hooked). SharedJSContext's localStorage survives restarts.
+ *
+ * Pure: no Steam, SDK or logger import (tests/safety.test.ts).
+ */
+
+export const BOOT_KEY = 'enhanced-achievements.boot';
+/** Bad boots in a row that switch safe mode on. */
+export const UNCLEAN_LIMIT = 2;
+export const HEALTHY_AFTER_MS = 60_000;
+
+export interface BootState {
+    pending: boolean;
+    unclean: number;
+    at: number;
+}
+
+export interface KeyValue {
+    getItem(key: string): string | null;
+    setItem(key: string, value: string): void;
+}
+
+function read(store: KeyValue): BootState {
+    try {
+        const v = JSON.parse(store.getItem(BOOT_KEY) ?? 'null');
+        if (v && typeof v.pending === 'boolean' && typeof v.unclean === 'number') return v;
+    } catch {
+        /* corrupt entry: treat as a first boot */
+    }
+    return { pending: false, unclean: 0, at: 0 };
+}
+
+function write(store: KeyValue, state: BootState): void {
+    try {
+        store.setItem(BOOT_KEY, JSON.stringify(state));
+    } catch {
+        /* storage unavailable: the sentinel is best-effort */
+    }
+}
+
+/** Call once at plugin start. Returns whether to start in safe mode, and the bad-boot count. */
+export function beginBoot(store: KeyValue, now = Date.now()): { safeMode: boolean; unclean: number } {
+    const prev = read(store);
+    const unclean = prev.pending ? prev.unclean + 1 : 0;
+    write(store, { pending: true, unclean, at: now });
+    return { safeMode: unclean >= UNCLEAN_LIMIT, unclean };
+}
+
+/** Call after HEALTHY_AFTER_MS with no feature errors, and on a clean shutdown. */
+export function markHealthy(store: KeyValue, now = Date.now()): void {
+    write(store, { pending: false, unclean: 0, at: now });
+}
+
+/** Wire the sentinel: clears on pagehide, and after the healthy delay if no errors were counted. */
+export function watchBoot(
+    store: KeyValue,
+    errorCount: () => number,
+    win: { addEventListener(type: string, fn: () => void): void; setTimeout(fn: () => void, ms: number): unknown },
+): void {
+    win.addEventListener('pagehide', () => markHealthy(store));
+    win.setTimeout(() => {
+        if (errorCount() === 0) markHealthy(store);
+    }, HEALTHY_AFTER_MS);
+}
diff --git a/enhanced-achievements/frontend/safety/features.ts b/enhanced-achievements/frontend/safety/features.ts
new file mode 100644
index 0000000..59b67ca
--- /dev/null
+++ b/enhanced-achievements/frontend/safety/features.ts
@@ -0,0 +1,103 @@
+/**
+ * Kill switches and error budget (docs/plans/enhanced-achievements-architecture-migration-plan.md
+ * § E0a). Same design as steam-cartridges/frontend/safety/features.ts; plugins may not
+ * import each other, so this is a copy with this plugin's feature ids.
+ *
+ * Every part of the plugin that writes into Steam has a FeatureId. A feature runs only
+ * while it is enabled; one that throws `errorBudget` times is switched off until Steam
+ * restarts, and Steam's stock behaviour returns for it. The user switches features off
+ * with the `disabledFeatures` setting (comma-separated ids), e.g. from the
+ * SharedJSContext console:
+ *   PLUGIN_LIST['enhanced-achievements-dev'].setSetting('disabledFeatures', 'banner,sound')
+ *
+ * Pure: no Steam, SDK or logger import (tests/safety.test.ts).
+ */
+
+/** Stable ids: users type them. Never rename one; add new ones at the end. */
+export const FEATURE_IDS = ['banner', 'sound', 'duration', 'completion', 'captures'] as const;
+export type FeatureId = (typeof FEATURE_IDS)[number];
+
+/** Safe mode keeps nothing: every achievement toast is Steam's own. */
+export const SAFE_MODE_FEATURES: ReadonlySet<FeatureId> = new Set<FeatureId>();
+
+export interface FeatureSwitches {
+    isEnabled(id: FeatureId): boolean;
+    /** Run a feature's code if it is enabled. Never throws; returns undefined when skipped or failed. */
+    run<T>(id: FeatureId, fn: () => T): T | undefined;
+    /** Count an error against a feature (for fail-open catch blocks). */
+    reportError(id: FeatureId, err: unknown): void;
+    setSafeMode(on: boolean): void;
+    /** Re-read the `disabledFeatures` setting (call on its change). */
+    reload(): void;
+    errorCount(): number;
+    diagnostics(): {
+        safeMode: boolean;
+        disabled: string[];
+        tripped: string[];
+        errors: Record<string, number>;
+    };
+}
+
+export interface FeatureSwitchOptions {
+    /** Current value of the `disabledFeatures` setting. */
+    readDisabled: () => string;
+    errorBudget?: number;
+    log?: (level: 'warn' | 'error', message: string, err?: unknown) => void;
+}
+
+export function parseDisabled(raw: string): Set<string> {
+    return new Set(
+        String(raw ?? '')
+            .split(',')
+            .map((s) => s.trim())
+            .filter(Boolean),
+    );
+}
+
+export function createFeatureSwitches(opts: FeatureSwitchOptions): FeatureSwitches {
+    const budget = opts.errorBudget ?? 5;
+    const log = opts.log ?? (() => {});
+    let disabled = parseDisabled(opts.readDisabled());
+    let safeMode = false;
+    const errors = new Map<FeatureId, number>();
+    const tripped = new Set<FeatureId>();
+
+    const isEnabled = (id: FeatureId) => !tripped.has(id) && !(safeMode && !SAFE_MODE_FEATURES.has(id)) && !disabled.has(id);
+
+    const reportError = (id: FeatureId, err: unknown) => {
+        const n = (errors.get(id) ?? 0) + 1;
+        errors.set(id, n);
+        log('warn', `Feature "${id}" error ${n}/${budget}`, err);
+        if (n >= budget && !tripped.has(id)) {
+            tripped.add(id);
+            log('error', `Feature "${id}" exceeded its error budget; off until Steam restarts.`);
+        }
+    };
+
+    return {
+        isEnabled,
+        run(id, fn) {
+            if (!isEnabled(id)) return undefined;
+            try {
+                return fn();
+            } catch (err) {
+                reportError(id, err);
+                return undefined;
+            }
+        },
+        reportError,
+        setSafeMode(on) {
+            safeMode = on;
+        },
+        reload() {
+            disabled = parseDisabled(opts.readDisabled());
+        },
+        errorCount: () => [...errors.values()].reduce((a, b) => a + b, 0),
+        diagnostics: () => ({
+            safeMode,
+            disabled: [...disabled],
+            tripped: [...tripped],
+            errors: Object.fromEntries(errors),
+        }),
+    };
+}
diff --git a/enhanced-achievements/frontend/safety/runtime.ts b/enhanced-achievements/frontend/safety/runtime.ts
new file mode 100644
index 0000000..42c0480
--- /dev/null
+++ b/enhanced-achievements/frontend/safety/runtime.ts
@@ -0,0 +1,42 @@
+import { createFeatureSwitches, type FeatureId, type FeatureSwitches, type FeatureSwitchOptions } from './features.ts';
+
+/**
+ * The plugin's one set of kill switches. Every module that writes into Steam asks
+ * `isEnabled(id)` before it acts and calls `reportError(id, err)` from its fail-open
+ * catch block. `initSafety` is called once by index.tsx; until then every feature
+ * is enabled and errors are only counted.
+ *
+ * Every function here is O(1) (a few Set lookups): safe from a jsx handler or a
+ * prototype hook (docs/plugins.md guardrail 2).
+ *
+ * Pure: no Steam, SDK or logger import (tests/safety.test.ts); the logger is injected.
+ */
+
+let switches: FeatureSwitches = createFeatureSwitches({ readDisabled: () => '' });
+
+export function initSafety(opts: FeatureSwitchOptions & { safeMode: boolean }): void {
+    switches = createFeatureSwitches(opts);
+    switches.setSafeMode(opts.safeMode);
+}
+
+export function isEnabled(id: FeatureId): boolean {
+    return switches.isEnabled(id);
+}
+
+export function reportError(id: FeatureId, err: unknown): void {
+    switches.reportError(id, err);
+}
+
+/** Re-read the `disabledFeatures` setting. */
+export function reloadSafety(): void {
+    switches.reload();
+}
+
+export function errorCount(): number {
+    return switches.errorCount();
+}
+
+/** For tests and the console: `PLUGIN_LIST[...].safetyDiagnostics()`. */
+export function safetyDiagnostics(): ReturnType<FeatureSwitches['diagnostics']> {
+    return switches.diagnostics();
+}
