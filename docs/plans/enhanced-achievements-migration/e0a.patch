diff --git a/enhanced-achievements/tests/safety.mjs b/enhanced-achievements/tests/safety.mjs
new file mode 100644
index 0000000..5bd8ed4
--- /dev/null
+++ b/enhanced-achievements/tests/safety.mjs
@@ -0,0 +1,86 @@
+// Live test: kill switches (migration plan § E0a), against a running Steam (-dev)
+// with enhanced-achievements deployed. Restores exactly the settings stored before it ran.
+//
+//   node tests/safety.mjs            (THEME=<name> to pick the theme; default ps5)
+//
+// 1. A clean start: not in safe mode, nothing tripped, no errors counted.
+// 2. `disabledFeatures = banner`: claims('banner') is handed back and a preview
+//    toast is Steam's own (no .ea-banner), with the theme still loaded.
+// 3. Switch cleared: claims('banner') again, and the preview is our themed banner.
+import { connect, resolvePluginName } from './cdp.mjs';
+
+const THEME = process.env.THEME ?? 'ps5';
+const cdp = await connect();
+const PLUGIN = await resolvePluginName(cdp, 'EA_PLUGIN', 'enhanced-achievements');
+const plugin = (expr) => cdp.evaluate(`window.PLUGIN_LIST[${JSON.stringify(PLUGIN)}].${expr}`);
+const stored = () => cdp.evaluate(`window.MILLENNIUM_API.ffi('core', 'PluginConfig_GetAll')(${JSON.stringify(PLUGIN)})`);
+const wait = (ms) => new Promise((r) => setTimeout(r, ms));
+let failed = false;
+const check = (label, ok, detail = '') => {
+    console.log(`${ok ? 'PASS' : 'FAIL'}  ${label}${detail ? `  (${detail})` : ''}`);
+    if (!ok) failed = true;
+};
+
+/** Every achievement toast popup: does it hold our banner, and which tier? */
+const sample = () =>
+    cdp.evaluate(`JSON.stringify([...g_PopupManager.GetPopups()]
+        .filter((p) => /^notificationtoasts_/.test(p.m_strName) && (p.window ?? p.m_popup) && !(p.window ?? p.m_popup).closed)
+        .map((p) => {
+            const doc = (p.window ?? p.m_popup).document, b = doc.querySelector('.ea-banner');
+            return { banner: !!b, tier: b?.className.match(/ea-tier-(\\w+)/)?.[1] ?? null, text: (doc.body?.innerText ?? '').trim().slice(0, 60) };
+        }))`).then(JSON.parse);
+
+async function waitForNoToasts(maxMs = 60_000) {
+    for (let t = 0; t < maxMs; t += 500) {
+        if ((await sample()).length === 0) return true;
+        await wait(500);
+    }
+    return false;
+}
+
+/** Fire one preview and return the first popup that has rendered content. */
+async function previewOnce(tier) {
+    await plugin(`previewTier(${JSON.stringify(tier)})`);
+    for (let i = 0; i < 20; i++) {
+        await wait(250);
+        const hit = (await sample()).find((p) => p.banner || p.text !== '');
+        if (hit) return hit;
+    }
+    return null;
+}
+
+const before_ = (await stored()) ?? {};
+try {
+    const diag = await plugin('safetyDiagnostics()');
+    check('clean start: not in safe mode', diag?.safeMode === false, JSON.stringify(diag));
+    check('clean start: nothing tripped, no errors', diag?.tripped?.length === 0 && Object.keys(diag?.errors ?? {}).length === 0, JSON.stringify(diag));
+
+    check('no toast on screen before starting', await waitForNoToasts());
+    await plugin(`setSetting('theme', ${JSON.stringify(THEME)})`);
+    for (let i = 0; i < 20 && (await plugin('activeTheme()?.name')) !== THEME; i++) await wait(250);
+    check(`theme "${THEME}" loaded`, (await plugin('activeTheme()?.name')) === THEME);
+
+    await plugin(`setSetting('disabledFeatures', 'banner')`);
+    check("banner off: claims('banner') handed back", (await plugin(`claims('banner')`)) === false);
+    check("banner off: claims('sound') kept", (await plugin(`claims('sound')`)) === true);
+    const stock = await previewOnce('rare');
+    check("banner off: preview is Steam's own toast", !!stock && !stock.banner, JSON.stringify(stock));
+    check('banner off: toast cleared', await waitForNoToasts());
+
+    await plugin(`setSetting('disabledFeatures', '')`);
+    check("banner on again: claims('banner')", (await plugin(`claims('banner')`)) === true);
+    const themed = await previewOnce('rare');
+    check('banner on again: preview is our banner with its tier', !!themed && themed.banner && themed.tier === 'rare', JSON.stringify(themed));
+    check('banner on again: toast cleared', await waitForNoToasts());
+
+    const after = await plugin('safetyDiagnostics()');
+    check('no errors counted during the test', Object.keys(after?.errors ?? {}).length === 0, JSON.stringify(after));
+} finally {
+    await plugin('resetSettings()');
+    for (const [key, value] of Object.entries(before_)) await plugin(`setSetting(${JSON.stringify(key)}, ${JSON.stringify(value)})`);
+    const left = (await stored()) ?? {};
+    const sorted = (o) => JSON.stringify(Object.keys(o).sort().map((k) => [k, o[k]]));
+    check('settings restored to what was stored before the test', sorted(left) === sorted(before_), `${JSON.stringify(before_)} -> ${JSON.stringify(left)}`);
+    cdp.close();
+}
+process.exitCode = failed ? 1 : 0;
diff --git a/enhanced-achievements/tests/safety.test.ts b/enhanced-achievements/tests/safety.test.ts
new file mode 100644
index 0000000..f3f72ba
--- /dev/null
+++ b/enhanced-achievements/tests/safety.test.ts
@@ -0,0 +1,106 @@
+// Safety unit tests (migration plan § E0a): kill switches, error budget, safe mode, boot sentinel.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createFeatureSwitches, FEATURE_IDS, parseDisabled, SAFE_MODE_FEATURES } from '../frontend/safety/features.ts';
+import { beginBoot, BOOT_KEY, HEALTHY_AFTER_MS, markHealthy, watchBoot } from '../frontend/safety/boot.ts';
+import { errorCount, initSafety, isEnabled, reloadSafety, reportError, safetyDiagnostics } from '../frontend/safety/runtime.ts';
+
+function memory() {
+    const m = new Map<string, string>();
+    return { getItem: (k: string) => m.get(k) ?? null, setItem: (k: string, v: string) => void m.set(k, v) };
+}
+
+test('features: the ids users type never change (append only)', () => {
+    assert.deepEqual([...FEATURE_IDS], ['banner', 'sound', 'duration', 'completion', 'captures']);
+});
+
+test('features: parseDisabled trims and ignores empties', () => {
+    assert.deepEqual([...parseDisabled(' banner, ,sound ')], ['banner', 'sound']);
+    assert.deepEqual([...parseDisabled('')], []);
+});
+
+test('features: disabled by setting, reload picks up changes', () => {
+    let raw = 'banner';
+    const f = createFeatureSwitches({ readDisabled: () => raw });
+    assert.equal(f.isEnabled('banner'), false);
+    assert.equal(f.isEnabled('sound'), true);
+    assert.equal(f.run('banner', () => 1), undefined);
+    raw = '';
+    f.reload();
+    assert.equal(f.run('banner', () => 1), 1);
+});
+
+test('features: run never throws and trips after the budget', () => {
+    const f = createFeatureSwitches({ readDisabled: () => '', errorBudget: 2 });
+    const boom = () => {
+        throw new Error('x');
+    };
+    assert.equal(f.run('sound', boom), undefined);
+    assert.equal(f.isEnabled('sound'), true);
+    assert.equal(f.run('sound', boom), undefined);
+    assert.equal(f.isEnabled('sound'), false);
+    assert.deepEqual(f.diagnostics().tripped, ['sound']);
+    assert.equal(f.errorCount(), 2);
+});
+
+test('features: safe mode switches every feature off', () => {
+    const f = createFeatureSwitches({ readDisabled: () => '' });
+    f.setSafeMode(true);
+    for (const id of FEATURE_IDS) assert.equal(f.isEnabled(id), false, id);
+    assert.equal(SAFE_MODE_FEATURES.size, 0);
+});
+
+test('boot: two bad boots in a row start safe mode; a healthy boot resets', () => {
+    const s = memory();
+    assert.deepEqual(beginBoot(s, 1), { safeMode: false, unclean: 0 });
+    assert.deepEqual(beginBoot(s, 2), { safeMode: false, unclean: 1 }); // previous never cleared
+    assert.deepEqual(beginBoot(s, 3), { safeMode: true, unclean: 2 });
+    markHealthy(s, 4);
+    assert.deepEqual(beginBoot(s, 5), { safeMode: false, unclean: 0 });
+});
+
+test('boot: corrupt storage is treated as a first boot', () => {
+    const s = memory();
+    s.setItem(BOOT_KEY, '{nope');
+    assert.deepEqual(beginBoot(s), { safeMode: false, unclean: 0 });
+});
+
+test('boot: watchBoot clears on pagehide, and after the delay only without errors', () => {
+    const s = memory();
+    const listeners: Record<string, () => void> = {};
+    let timer: (() => void) | undefined;
+    let delay = 0;
+    const win = { addEventListener: (t: string, fn: () => void) => void (listeners[t] = fn), setTimeout: (fn: () => void, ms: number) => ((timer = fn), (delay = ms)) };
+    beginBoot(s);
+    let errors = 1;
+    watchBoot(s, () => errors, win);
+    assert.equal(delay, HEALTHY_AFTER_MS);
+    timer!();
+    assert.equal(JSON.parse(s.getItem(BOOT_KEY)!).pending, true);
+    listeners.pagehide!();
+    assert.equal(JSON.parse(s.getItem(BOOT_KEY)!).pending, false);
+    beginBoot(s);
+    errors = 0;
+    timer!();
+    assert.equal(JSON.parse(s.getItem(BOOT_KEY)!).pending, false);
+});
+
+test('runtime: before initSafety every feature is on', () => {
+    for (const id of FEATURE_IDS) assert.equal(isEnabled(id), true, id);
+});
+
+test('runtime: initSafety wires the setting, safe mode and the budget', () => {
+    let raw = 'duration';
+    initSafety({ readDisabled: () => raw, safeMode: false, errorBudget: 1 });
+    assert.equal(isEnabled('duration'), false);
+    raw = '';
+    reloadSafety();
+    assert.equal(isEnabled('duration'), true);
+    reportError('captures', new Error('x'));
+    assert.equal(isEnabled('captures'), false);
+    assert.equal(errorCount(), 1);
+    assert.deepEqual(safetyDiagnostics(), { safeMode: false, disabled: [], tripped: ['captures'], errors: { captures: 1 } });
+    initSafety({ readDisabled: () => '', safeMode: true });
+    assert.equal(isEnabled('banner'), false);
+    assert.equal(safetyDiagnostics().safeMode, true);
+});
