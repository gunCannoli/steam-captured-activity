+++ b/steam-cartridges/frontend/domain/community-media.ts
@@ -0,0 +1,36 @@
+// Domain: which community media a shortcut shows (features plan F2). Pure: the settings toggles and a cap per kind.
+// Its imports carry `.ts`, so Node can run the unit tests with type stripping.
+import type { CommunityMedia, MediaItem } from "../kernel/record";
+import { asList } from "../kernel/lists.ts";
+
+/** Settings communityShowTrailers and communityShowArtworks. */
+export interface MediaToggles {
+    trailers: boolean;
+    artworks: boolean;
+}
+
+/** At most this many cards of each kind (Steam's section loads one page; more is a wall of art). */
+export const MAX_PER_KIND = 12;
+
+/** Is this item complete enough to become a card? */
+export function isShowable(item: MediaItem | undefined): item is MediaItem {
+    if (!item || typeof item !== "object") return false;
+    if (item.kind === "video") return typeof item.youtube === "string" && item.youtube !== "";
+    if (item.kind !== "screenshot" && item.kind !== "artwork") return false;
+    if (item.source === "screenscraper") return typeof item.key === "string" && item.key !== "";
+    return typeof item.url === "string" && item.url !== "";
+}
+
+/** The items to show, in the backend's order: allowed by the toggles, complete, at most MAX_PER_KIND per kind. */
+export function visibleMedia(media: CommunityMedia | undefined, toggles: MediaToggles): MediaItem[] {
+    const counts: Record<string, number> = {};
+    const out: MediaItem[] = [];
+    for (const item of asList<MediaItem>(media?.items)) {
+        if (!isShowable(item)) continue;
+        if (item.kind === "video" ? !toggles.trailers : !toggles.artworks) continue;
+        counts[item.kind] = (counts[item.kind] ?? 0) + 1;
+        if (counts[item.kind]! > MAX_PER_KIND) continue;
+        out.push(item);
+    }
+    return out;
+}
diff --git a/steam-cartridges/frontend/kernel/media-bin.ts b/steam-cartridges/frontend/kernel/media-bin.ts
new file mode 100644
index 0000000..32d6c04
--- /dev/null
+++ b/steam-cartridges/frontend/kernel/media-bin.ts
@@ -0,0 +1,40 @@
+// Kernel: the ScreenScraper images app/media fetched for a shortcut (features plan F2b), as object URLs, waiting for
+// the community surface to hand them to Steam. Kept out of GameRecord like the image bin (kernel/image-bin.ts): the
+// bytes live only in memory, behind a blob URL, and nothing is written to disk. Bounded to the last MAX_MEDIA_APPIDS
+// shortcuts; an evicted or replaced URL is given to `release` (ports/image releaseObjectUrl), so memory stays bounded.
+
+export interface MediaImage {
+    /** An object URL (blob:) of the image bytes. */
+    url: string;
+    width?: number;
+    height?: number;
+}
+
+export interface MediaBin {
+    put(appid: number, key: string, image: MediaImage): void;
+    /** The image for this shortcut and key, or undefined (never fetched, failed, or evicted). */
+    get(appid: number, key: string): MediaImage | undefined;
+}
+
+export const MAX_MEDIA_APPIDS = 8;
+
+export function createMediaBin(release: (url: string) => void): MediaBin {
+    const map = new Map<number, Map<string, MediaImage>>();
+    const drop = (entry: Map<string, MediaImage>) => entry.forEach((image) => release(image.url));
+    return {
+        put(appid, key, image) {
+            const entry = map.get(appid) ?? new Map<string, MediaImage>();
+            const previous = entry.get(key);
+            if (previous && previous.url !== image.url) release(previous.url);
+            entry.set(key, image);
+            map.delete(appid); // re-insert: the map's order is the recency order
+            map.set(appid, entry);
+            while (map.size > MAX_MEDIA_APPIDS) {
+                const oldest = map.keys().next().value as number;
+                drop(map.get(oldest)!);
+                map.delete(oldest);
+            }
+        },
+        get: (appid, key) => map.get(appid)?.get(key),
+    };
+}
