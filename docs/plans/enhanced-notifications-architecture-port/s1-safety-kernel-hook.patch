diff --git a/enhanced-notifications/frontend/kernel/surface.ts b/enhanced-notifications/frontend/kernel/surface.ts
new file mode 100644
index 0000000..ea0ef0c
--- /dev/null
+++ b/enhanced-notifications/frontend/kernel/surface.ts
@@ -0,0 +1,55 @@
+/**
+ * Kernel: the Surface contract and its install runner (migration plan § 4.4).
+ * A surface is the only kind of code that writes into Steam. Pure.
+ */
+
+export interface Surface {
+    /** Stable id; also its kill switch (a FeatureId in safety/features.ts). */
+    id: string;
+    /** Steam targets this surface writes (§ 4.3). No two surfaces share one. */
+    touches: readonly string[];
+    /** Resolve and patch once. false = Steam lacks what it needs: the surface stays off, not an error. */
+    install(): boolean;
+    /** Undo every patch. Idempotent. Called when the feature trips its error budget. */
+    uninstall(): void;
+}
+
+export interface SurfaceStatus {
+    id: string;
+    installed: boolean;
+    skipped: 'disabled' | 'unavailable' | 'failed' | null;
+}
+
+/** Throws `Steam target "<t>" is touched by both "<a>" and "<b>"` on a shared target. */
+export function assertDisjointTouches(surfaces: readonly Pick<Surface, 'id' | 'touches'>[]): void {
+    const owner = new Map<string, string>();
+    for (const s of surfaces) {
+        for (const t of s.touches) {
+            const prev = owner.get(t);
+            if (prev !== undefined && prev !== s.id) throw new Error(`Steam target "${t}" is touched by both "${prev}" and "${s.id}"`);
+            owner.set(t, s.id);
+        }
+    }
+}
+
+/** assertDisjointTouches first (throws before installing anything), then each surface in order, each in its own
+ *  try/catch: disabled → skipped 'disabled'; install() false → 'unavailable'; throws → reportError(id) and 'failed'. */
+export function installSurfaces(
+    surfaces: readonly Surface[],
+    deps: { isEnabled(id: string): boolean; reportError(id: string, err: unknown): void },
+): SurfaceStatus[] {
+    assertDisjointTouches(surfaces);
+    return surfaces.map((s): SurfaceStatus => {
+        if (!deps.isEnabled(s.id)) return { id: s.id, installed: false, skipped: 'disabled' };
+        try {
+            return s.install() ? { id: s.id, installed: true, skipped: null } : { id: s.id, installed: false, skipped: 'unavailable' };
+        } catch (err) {
+            try {
+                deps.reportError(s.id, err);
+            } catch {
+                /* reporting must never break the rest of the install */
+            }
+            return { id: s.id, installed: false, skipped: 'failed' };
+        }
+    });
+}
diff --git a/enhanced-notifications/frontend/safety/boot.ts b/enhanced-notifications/frontend/safety/boot.ts
new file mode 100644
index 0000000..f17b787
--- /dev/null
+++ b/enhanced-notifications/frontend/safety/boot.ts
@@ -0,0 +1,71 @@
+/**
+ * Boot sentinel (docs/enhanced-notifications/architecture.md, safety net).
+ * Same design as steam-cartridges/frontend/safety/boot.ts, with this plugin's key.
+ *
+ * A hung SharedJSContext cannot run any cleanup, so the sentinel works the other way
+ * round: every start marks the boot "pending"; a clean shutdown (pagehide) or 60 s of
+ * error-free running clears it. If a start finds the previous boot still pending, that
+ * boot ended badly. After two bad boots in a row, the plugin starts in safe mode
+ * (Steam's own toasts, nothing hooked). SharedJSContext's localStorage survives restarts.
+ *
+ * Pure: no Steam, SDK or logger import (tests/safety.test.ts).
+ */
+
+export const BOOT_KEY = 'enhanced-notifications.boot';
+/** Bad boots in a row that switch safe mode on. */
+export const UNCLEAN_LIMIT = 2;
+export const HEALTHY_AFTER_MS = 60_000;
+
+export interface BootState {
+    pending: boolean;
+    unclean: number;
+    at: number;
+}
+
+export interface KeyValue {
+    getItem(key: string): string | null;
+    setItem(key: string, value: string): void;
+}
+
+function read(store: KeyValue): BootState {
+    try {
+        const v = JSON.parse(store.getItem(BOOT_KEY) ?? 'null');
+        if (v && typeof v.pending === 'boolean' && typeof v.unclean === 'number') return v;
+    } catch {
+        /* corrupt entry: treat as a first boot */
+    }
+    return { pending: false, unclean: 0, at: 0 };
+}
+
+function write(store: KeyValue, state: BootState): void {
+    try {
+        store.setItem(BOOT_KEY, JSON.stringify(state));
+    } catch {
+        /* storage unavailable: the sentinel is best-effort */
+    }
+}
+
+/** Call once at plugin start. Returns whether to start in safe mode, and the bad-boot count. */
+export function beginBoot(store: KeyValue, now = Date.now()): { safeMode: boolean; unclean: number } {
+    const prev = read(store);
+    const unclean = prev.pending ? prev.unclean + 1 : 0;
+    write(store, { pending: true, unclean, at: now });
+    return { safeMode: unclean >= UNCLEAN_LIMIT, unclean };
+}
+
+/** Call after HEALTHY_AFTER_MS with no feature errors, and on a clean shutdown. */
+export function markHealthy(store: KeyValue, now = Date.now()): void {
+    write(store, { pending: false, unclean: 0, at: now });
+}
+
+/** Wire the sentinel: clears on pagehide, and after the healthy delay if no errors were counted. */
+export function watchBoot(
+    store: KeyValue,
+    errorCount: () => number,
+    win: { addEventListener(type: string, fn: () => void): void; setTimeout(fn: () => void, ms: number): unknown },
+): void {
+    win.addEventListener('pagehide', () => markHealthy(store));
+    win.setTimeout(() => {
+        if (errorCount() === 0) markHealthy(store);
+    }, HEALTHY_AFTER_MS);
+}
diff --git a/enhanced-notifications/frontend/safety/features.ts b/enhanced-notifications/frontend/safety/features.ts
new file mode 100644
index 0000000..8336c27
--- /dev/null
+++ b/enhanced-notifications/frontend/safety/features.ts
@@ -0,0 +1,109 @@
+/**
+ * Kill switches and error budget (docs/enhanced-notifications/architecture.md, safety net). Same design as steam-cartridges/frontend/safety/features.ts; plugins may not
+ * import each other, so this is a copy with this plugin's feature ids.
+ *
+ * Every part of the plugin that writes into Steam has a FeatureId. A feature runs only
+ * while it is enabled; one that throws `errorBudget` times is switched off until Steam
+ * restarts, and Steam's stock behaviour returns for it. The user switches features off
+ * with the `disabledFeatures` setting (comma-separated ids), e.g. from the
+ * SharedJSContext console:
+ *   PLUGIN_LIST['enhanced-notifications-dev'].setSetting('disabledFeatures', 'style,sound')
+ *
+ * Pure: no Steam, SDK or logger import (tests/safety.test.ts).
+ */
+
+/** Stable ids: users type them. Never rename one; add new ones at the end. */
+export const FEATURE_IDS = ['style', 'sound', 'duration', 'preview'] as const;
+export type FeatureId = (typeof FEATURE_IDS)[number];
+
+/** Safe mode keeps nothing: every toast is Steam's own. */
+export const SAFE_MODE_FEATURES: ReadonlySet<FeatureId> = new Set<FeatureId>();
+
+export interface FeatureSwitches {
+    isEnabled(id: FeatureId): boolean;
+    /** Run a feature's code if it is enabled. Never throws; returns undefined when skipped or failed. */
+    run<T>(id: FeatureId, fn: () => T): T | undefined;
+    /** Count an error against a feature (for fail-open catch blocks). */
+    reportError(id: FeatureId, err: unknown): void;
+    setSafeMode(on: boolean): void;
+    /** Re-read the `disabledFeatures` setting (call on its change). */
+    reload(): void;
+    errorCount(): number;
+    diagnostics(): {
+        safeMode: boolean;
+        disabled: string[];
+        tripped: string[];
+        errors: Record<string, number>;
+    };
+}
+
+export interface FeatureSwitchOptions {
+    /** Current value of the `disabledFeatures` setting. */
+    readDisabled: () => string;
+    errorBudget?: number;
+    /** Called once, when a feature exceeds its error budget (index.tsx uninstalls that feature's surface). */
+    onTrip?: (id: FeatureId) => void;
+    log?: (level: 'warn' | 'error', message: string, err?: unknown) => void;
+}
+
+export function parseDisabled(raw: string): Set<string> {
+    return new Set(
+        String(raw ?? '')
+            .split(',')
+            .map((s) => s.trim())
+            .filter(Boolean),
+    );
+}
+
+export function createFeatureSwitches(opts: FeatureSwitchOptions): FeatureSwitches {
+    const budget = opts.errorBudget ?? 5;
+    const log = opts.log ?? (() => {});
+    let disabled = parseDisabled(opts.readDisabled());
+    let safeMode = false;
+    const errors = new Map<FeatureId, number>();
+    const tripped = new Set<FeatureId>();
+
+    const isEnabled = (id: FeatureId) => !tripped.has(id) && !(safeMode && !SAFE_MODE_FEATURES.has(id)) && !disabled.has(id);
+
+    const reportError = (id: FeatureId, err: unknown) => {
+        const n = (errors.get(id) ?? 0) + 1;
+        errors.set(id, n);
+        log('warn', `Feature "${id}" error ${n}/${budget}`, err);
+        if (n >= budget && !tripped.has(id)) {
+            tripped.add(id);
+            log('error', `Feature "${id}" exceeded its error budget; off until Steam restarts.`);
+            try {
+                opts.onTrip?.(id);
+            } catch (e) {
+                log('error', `Feature "${id}" onTrip failed`, e);
+            }
+        }
+    };
+
+    return {
+        isEnabled,
+        run(id, fn) {
+            if (!isEnabled(id)) return undefined;
+            try {
+                return fn();
+            } catch (err) {
+                reportError(id, err);
+                return undefined;
+            }
+        },
+        reportError,
+        setSafeMode(on) {
+            safeMode = on;
+        },
+        reload() {
+            disabled = parseDisabled(opts.readDisabled());
+        },
+        errorCount: () => [...errors.values()].reduce((a, b) => a + b, 0),
+        diagnostics: () => ({
+            safeMode,
+            disabled: [...disabled],
+            tripped: [...tripped],
+            errors: Object.fromEntries(errors),
+        }),
+    };
+}
diff --git a/enhanced-notifications/frontend/safety/runtime.ts b/enhanced-notifications/frontend/safety/runtime.ts
new file mode 100644
index 0000000..42c0480
--- /dev/null
+++ b/enhanced-notifications/frontend/safety/runtime.ts
@@ -0,0 +1,42 @@
+import { createFeatureSwitches, type FeatureId, type FeatureSwitches, type FeatureSwitchOptions } from './features.ts';
+
+/**
+ * The plugin's one set of kill switches. Every module that writes into Steam asks
+ * `isEnabled(id)` before it acts and calls `reportError(id, err)` from its fail-open
+ * catch block. `initSafety` is called once by index.tsx; until then every feature
+ * is enabled and errors are only counted.
+ *
+ * Every function here is O(1) (a few Set lookups): safe from a jsx handler or a
+ * prototype hook (docs/plugins.md guardrail 2).
+ *
+ * Pure: no Steam, SDK or logger import (tests/safety.test.ts); the logger is injected.
+ */
+
+let switches: FeatureSwitches = createFeatureSwitches({ readDisabled: () => '' });
+
+export function initSafety(opts: FeatureSwitchOptions & { safeMode: boolean }): void {
+    switches = createFeatureSwitches(opts);
+    switches.setSafeMode(opts.safeMode);
+}
+
+export function isEnabled(id: FeatureId): boolean {
+    return switches.isEnabled(id);
+}
+
+export function reportError(id: FeatureId, err: unknown): void {
+    switches.reportError(id, err);
+}
+
+/** Re-read the `disabledFeatures` setting. */
+export function reloadSafety(): void {
+    switches.reload();
+}
+
+export function errorCount(): number {
+    return switches.errorCount();
+}
+
+/** For tests and the console: `PLUGIN_LIST[...].safetyDiagnostics()`. */
+export function safetyDiagnostics(): ReturnType<FeatureSwitches['diagnostics']> {
+    return switches.diagnostics();
+}
diff --git a/enhanced-notifications/frontend/steam/notification-hook.ts b/enhanced-notifications/frontend/steam/notification-hook.ts
new file mode 100644
index 0000000..de942bf
--- /dev/null
+++ b/enhanced-notifications/frontend/steam/notification-hook.ts
@@ -0,0 +1,106 @@
+import type { SteamNotification } from '../kernel/notification.ts';
+
+/**
+ * The one wrapper around `NotificationStore.prototype.PlayNotificationSound`
+ * (migration plan § 4.5, D3). Infrastructure, not a feature: it decides
+ * nothing. It tells observers that Steam showed a toast and hands the sound
+ * decision to the one sound handler (surfaces/sound). Pure: it mutates only
+ * the `proto` it is given, so `npm test` drives it with fakes.
+ */
+
+export interface SoundCall {
+    readonly n: SteamNotification;
+    /** Steam's own PlayNotificationSound on the store: its chime, if Steam's settings want one. */
+    playSteam(): void;
+    /** Steam's own PlayNotificationSound with its sound choice intercepted: returns whether Steam wanted a sound. Plays nothing. */
+    askSteam(): boolean;
+}
+
+/** Decides the sound of one shown toast. Calls playSteam() or askSteam() at most once, now or later. */
+export type SoundHandler = (call: SoundCall) => void;
+
+export interface NotificationHook {
+    /** Observers of every toast Steam shows; run first, in order, each isolated; must be O(1). */
+    onShown(listener: (n: SteamNotification) => void): () => void;
+    /** The one sound handler; null restores Steam's sound. */
+    setSoundHandler(handler: SoundHandler | null): void;
+    /** Restores Steam's PlayNotificationSound if it is still ours. Idempotent. */
+    uninstall(): void;
+}
+
+export function installNotificationHook(
+    proto: { PlayNotificationSound(this: unknown, n: SteamNotification): void; ChooseSound(this: unknown, config: unknown, n: SteamNotification): unknown },
+    owner: object,
+    deps: { reportError(id: 'sound', err: unknown): void; warn(message: string, err: unknown): void },
+): NotificationHook {
+    const original = proto.PlayNotificationSound;
+    const originalChoose = proto.ChooseSound;
+    const listeners = new Set<(n: SteamNotification) => void>();
+    let handler: SoundHandler | null = null;
+
+    const wrapper = function (this: unknown, n: SteamNotification): void {
+        // Only Steam's own calls (on the store) are toasts; stand-in calls that
+        // read a type's config (ours, enhanced-notifications') pass through.
+        if (this !== owner) return original.call(this, n);
+        for (const listener of [...listeners]) {
+            try {
+                listener(n);
+            } catch (err) {
+                deps.warn('A notification listener threw; the toast is unaffected.', err);
+            }
+        }
+        const current = handler;
+        if (!current) return original.call(this, n);
+
+        const self = this as { ChooseSound?: unknown };
+        let used = false;
+        const call: SoundCall = {
+            n,
+            playSteam() {
+                if (used) return;
+                used = true;
+                original.call(self, n);
+            },
+            askSteam() {
+                if (used) return false;
+                used = true;
+                // Let Steam decide whether a sound is wanted (its mute setting),
+                // but take the decision instead of playing its chime.
+                let wanted = false;
+                self.ChooseSound = function (this: unknown, config: unknown, notification: SteamNotification) {
+                    wanted = !!originalChoose.call(this, config, notification);
+                    return null;
+                };
+                try {
+                    original.call(self, n);
+                } finally {
+                    delete self.ChooseSound;
+                }
+                return wanted;
+            },
+        };
+        try {
+            current(call);
+        } catch (err) {
+            deps.reportError('sound', err); // this toast gets Steam's chime
+            if (!used) {
+                used = true;
+                original.call(self, n);
+            }
+        }
+    };
+    proto.PlayNotificationSound = wrapper;
+
+    return {
+        onShown(listener) {
+            listeners.add(listener);
+            return () => listeners.delete(listener);
+        },
+        setSoundHandler(next) {
+            handler = next;
+        },
+        uninstall() {
+            if (proto.PlayNotificationSound === wrapper) proto.PlayNotificationSound = original;
+        },
+    };
+}
diff --git a/enhanced-notifications/tests/safety.test.ts b/enhanced-notifications/tests/safety.test.ts
new file mode 100644
index 0000000..0777f03
--- /dev/null
+++ b/enhanced-notifications/tests/safety.test.ts
@@ -0,0 +1,115 @@
+// Safety unit tests (same design as enhanced-achievements, ADR-0043): kill switches, error budget, safe mode, boot sentinel.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createFeatureSwitches, FEATURE_IDS, parseDisabled, SAFE_MODE_FEATURES } from '../frontend/safety/features.ts';
+import { beginBoot, BOOT_KEY, HEALTHY_AFTER_MS, markHealthy, watchBoot } from '../frontend/safety/boot.ts';
+import { errorCount, initSafety, isEnabled, reloadSafety, reportError, safetyDiagnostics } from '../frontend/safety/runtime.ts';
+
+function memory() {
+    const m = new Map<string, string>();
+    return { getItem: (k: string) => m.get(k) ?? null, setItem: (k: string, v: string) => void m.set(k, v) };
+}
+
+test('features: the ids users type never change (append only)', () => {
+    assert.deepEqual([...FEATURE_IDS], ['style', 'sound', 'duration', 'preview']);
+});
+
+test('features: parseDisabled trims and ignores empties', () => {
+    assert.deepEqual([...parseDisabled(' style, ,sound ')], ['style', 'sound']);
+    assert.deepEqual([...parseDisabled('')], []);
+});
+
+test('features: disabled by setting, reload picks up changes', () => {
+    let raw = 'style';
+    const f = createFeatureSwitches({ readDisabled: () => raw });
+    assert.equal(f.isEnabled('style'), false);
+    assert.equal(f.isEnabled('sound'), true);
+    assert.equal(f.run('style', () => 1), undefined);
+    raw = '';
+    f.reload();
+    assert.equal(f.run('style', () => 1), 1);
+});
+
+test('features: run never throws and trips after the budget', () => {
+    const f = createFeatureSwitches({ readDisabled: () => '', errorBudget: 2 });
+    const boom = () => {
+        throw new Error('x');
+    };
+    assert.equal(f.run('sound', boom), undefined);
+    assert.equal(f.isEnabled('sound'), true);
+    assert.equal(f.run('sound', boom), undefined);
+    assert.equal(f.isEnabled('sound'), false);
+    assert.deepEqual(f.diagnostics().tripped, ['sound']);
+    assert.equal(f.errorCount(), 2);
+});
+
+test('features: safe mode switches every feature off', () => {
+    const f = createFeatureSwitches({ readDisabled: () => '' });
+    f.setSafeMode(true);
+    for (const id of FEATURE_IDS) assert.equal(f.isEnabled(id), false, id);
+    assert.equal(SAFE_MODE_FEATURES.size, 0);
+});
+
+test('boot: two bad boots in a row start safe mode; a healthy boot resets', () => {
+    const s = memory();
+    assert.deepEqual(beginBoot(s, 1), { safeMode: false, unclean: 0 });
+    assert.deepEqual(beginBoot(s, 2), { safeMode: false, unclean: 1 }); // previous never cleared
+    assert.deepEqual(beginBoot(s, 3), { safeMode: true, unclean: 2 });
+    markHealthy(s, 4);
+    assert.deepEqual(beginBoot(s, 5), { safeMode: false, unclean: 0 });
+});
+
+test('boot: corrupt storage is treated as a first boot', () => {
+    const s = memory();
+    s.setItem(BOOT_KEY, '{nope');
+    assert.deepEqual(beginBoot(s), { safeMode: false, unclean: 0 });
+});
+
+test('boot: watchBoot clears on pagehide, and after the delay only without errors', () => {
+    const s = memory();
+    const listeners: Record<string, () => void> = {};
+    let timer: (() => void) | undefined;
+    let delay = 0;
+    const win = { addEventListener: (t: string, fn: () => void) => void (listeners[t] = fn), setTimeout: (fn: () => void, ms: number) => ((timer = fn), (delay = ms)) };
+    beginBoot(s);
+    let errors = 1;
+    watchBoot(s, () => errors, win);
+    assert.equal(delay, HEALTHY_AFTER_MS);
+    timer!();
+    assert.equal(JSON.parse(s.getItem(BOOT_KEY)!).pending, true);
+    listeners.pagehide!();
+    assert.equal(JSON.parse(s.getItem(BOOT_KEY)!).pending, false);
+    beginBoot(s);
+    errors = 0;
+    timer!();
+    assert.equal(JSON.parse(s.getItem(BOOT_KEY)!).pending, false);
+});
+
+test('runtime: before initSafety every feature is on', () => {
+    for (const id of FEATURE_IDS) assert.equal(isEnabled(id), true, id);
+});
+
+test('runtime: initSafety wires the setting, safe mode and the budget', () => {
+    let raw = 'duration';
+    initSafety({ readDisabled: () => raw, safeMode: false, errorBudget: 1 });
+    assert.equal(isEnabled('duration'), false);
+    raw = '';
+    reloadSafety();
+    assert.equal(isEnabled('duration'), true);
+    reportError('preview', new Error('x'));
+    assert.equal(isEnabled('preview'), false);
+    assert.equal(errorCount(), 1);
+    assert.deepEqual(safetyDiagnostics(), { safeMode: false, disabled: [], tripped: ['preview'], errors: { preview: 1 } });
+    initSafety({ readDisabled: () => '', safeMode: true });
+    assert.equal(isEnabled('style'), false);
+    assert.equal(safetyDiagnostics().safeMode, true);
+});
+
+test('features: onTrip is called once when a feature trips', () => {
+    const tripped: string[] = [];
+    const f = createFeatureSwitches({ readDisabled: () => '', errorBudget: 3, onTrip: (id) => tripped.push(id) });
+    for (let i = 0; i < 6; i++) f.reportError('sound', new Error('x'));
+    f.reportError('style', new Error('y'));
+    assert.deepEqual(tripped, ['sound']);
+    assert.equal(f.isEnabled('sound'), false);
+});
