# Local tooling
# A standalone Lua interpreter is needed to run the backend tests but is not
# part of the project (Millennium ships only its embedded VM). See plugin.md.
tools/lua/
*.exe
*.dll

# Reference clones for research (e.g. the k0d13/steam-non-steam-playtimes
# reference plugin cited throughout knowledgebase.md/plugin.md). Not our
# code, not published with this repo - clone locally when needed.
research/

# Never commit secrets or captured user data.
# retroarch.cfg holds cheevos_token / cheevos_password; Steam's userdata holds
# screenshots and recordings. Neither belongs in this repo.
*.local
.env
.env.*
secrets.json
overrides.json
retroarch.cfg
*.vdf
*.pb
cache/
library_metadata.json
sgdb_key.txt
__pycache__/
# Scratch session logs
scratch/*.jsonl

# Source material for generated plugin assets (the Theme Creator sound packs: tools/import-sfx.mjs).
# Kept in git history at 6ece444; regenerable, never shipped.
assets-src/
